harness keeper

const calls_max: u64 = 2
const entries_max: u64 = 64
const window_tokens: u64 = 200000
const lifetime_ms: u64 = 300000
const refreshes_max: u64 = 12
const clock_ms_max: u64 = 8640000000000000

type outcome = answered(text) | refreshed | lapsed | failed(text)

model infer calls calls_max window window_tokens modes refresh

state {
  context: list<entry, entries_max>
  requested_ms: u64
  reach_ms: u64
  refresh_due: u64
}

invariant context_bounded: len(context) <= entries_max
invariant requested_bounded: requested_ms <= clock_ms_max
invariant reach_bounded: reach_ms * 2 < lifetime_ms

fn kept(started: u64, opened: u64) {
  refresh_due = 0
  if started <= clock_ms_max and opened >= started {
    if opened - started < lifetime_ms {
      if (opened - started) * 2 < lifetime_ms {
        requested_ms = started
        reach_ms = opened - started
        refresh_due = started + lifetime_ms - reach_ms * 2
      }
    }
  }
}

on prompt(input: text) -> outcome
  requires len(context) + 2 <= entries_max
{
  push context user(input)
  let started = now()
  match infer(context) {
    ok(reply, _, _, _, _, _) => {
      let opened = now()
      kept(started, opened)
      push context assistant(reply)
      match reply {
        answer(words) => { return answered(words) }
        calls(_) => { return answered("") }
      }
    }
    throttled(error, _) => { return failed(error) }
    transient(error, _) => { return failed(error) }
    rejected(error) => { return failed(error) }
  }
}

on idle refresh() at refresh_due bound refreshes_max -> outcome {
  let started = now()
  if started > clock_ms_max or started >= requested_ms + lifetime_ms {
    refresh_due = 0
    return lapsed
  }
  match infer(context) mode refresh {
    ok(_, _, _, _, cache_read, cache_write) => {
      if cache_read == 0 or cache_write > 0 {
        refresh_due = 0
        return lapsed
      }
      requested_ms = started
      refresh_due = started + lifetime_ms - reach_ms * 2
      return refreshed
    }
    throttled(error, _) => {
      refresh_due = 0
      return failed(error)
    }
    transient(error, _) => {
      refresh_due = 0
      return failed(error)
    }
    rejected(error) => {
      refresh_due = 0
      return failed(error)
    }
  }
}
