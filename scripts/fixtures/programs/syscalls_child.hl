harness syscalls_child

type outcome = finished(text) | broke(text)

tool Bash(command: text) -> text effect external

on work(task: text) -> outcome {
  match Bash("printf child:%s " ++ task) {
    ok(raw) => { return finished(shell_shown(raw)) }
    failed(error) => { return broke(error) }
    unknown => { return broke("unknown") }
  }
}
