harness claude_agent

const rounds_max: u64 = 64
const calls_per_round_max: u64 = 16
const context_entries_max: u64 = 4096
const compact_kept: u64 = 32
const turns_max: u64 = 1000000
const continuations_max: u64 = 3
const throttled_attempts_max: u64 = 10

type outcome = completed(text) | failed(text) | cancelled | exhausted
type claude_reply = answer(text, u64)
  | calls(list<call, calls_per_round_max>, u64)
  | truncated(text)
  | paused
  | context_full
  | refused(text)

tool Read(file_path: text) -> text effect none
tool Glob(pattern: text) -> text effect none
tool Grep(pattern: text) -> text effect none
tool WebFetch(url: text) -> text effect none
tool Edit(file_path: text, change: text) -> text effect external
tool Write(file_path: text, content: text) -> text effect external
tool Bash(command: text) -> text effect external
tool cancel_requested() -> bool effect none
tool steer_waiting() -> bool effect none
tool steer_take() -> text effect none

model messages calls calls_per_round_max reply claude_reply

state {
  context: list<entry, context_entries_max>
  turns: u64
  output_continuations: u64
  throttled: u64
  context_recovery_attempted: bool
  context_tokens: u64
}

invariant turns_bounded: turns <= turns_max
invariant context_room: len(context) < context_entries_max
invariant continuations_bounded: output_continuations <= continuations_max
invariant throttled_bounded: throttled < throttled_attempts_max

fn compact() {
  keep context last context_entries_max - 2
  push context user("Summarize the conversation so far for a fresh start: the task, what was done, what is left.")
  match messages(context) {
    failed(error) => { return failed("compaction failed: " ++ error) }
    ok(summary) => {
      keep context last compact_kept
      match summary {
        answer(_, tokens) => {
          context_tokens = tokens
          push context assistant(summary)
        }
        calls(_, _) => { return failed("compaction answered with tool calls") }
        truncated(_) => { return failed("compaction reached the output token limit") }
        paused => { return failed("compaction paused") }
        context_full => { return failed("compaction exhausted the context window") }
        refused(reason) => { return failed("provider refused compaction: " ++ reason) }
      }
    }
  }
}

on prompt(input: text) -> outcome
  requires turns < turns_max
{
  push context user(input)
  turns = turns + 1
  output_continuations = 0
  throttled = 0
  context_recovery_attempted = false
  loop round below rounds_max {
    if len(context) + 1 + (2 + calls_per_round_max) > context_entries_max {
      compact()
    }
    match messages(context) {
      failed(error) => {
        if throttled + 1 >= throttled_attempts_max {
          return failed("model failed on every throttled attempt: " ++ error)
        }
        throttled = throttled + 1
      }
      ok(reply) => {
        throttled = 0
        push context assistant(reply)
        match reply {
          answer(words, tokens) => {
            context_tokens = tokens
            return completed(words)
          }
          calls(requested, tokens) => {
            context_tokens = tokens
            output_continuations = 0
            for call in requested parallel {
              match dispatch(call) {
                ok(output) => { push context result(call, output) }
                failed(error) => { push context error(call, error) }
                unknown => { push context unknown(call) }
              }
            }
            match cancel_requested() {
              ok(stop) => {
                if stop { return cancelled }
              }
              failed(error) => { return failed("cancel poll failed: " ++ error) }
            }
            match steer_waiting() {
              ok(waiting) => {
                if waiting {
                  match steer_take() {
                    ok(steer) => { push context user(steer) }
                    failed(error) => { return failed("steer take failed: " ++ error) }
                  }
                }
              }
              failed(error) => { return failed("steer poll failed: " ++ error) }
            }
          }
          truncated(partial) => {
            if output_continuations >= continuations_max {
              return failed("output token limit exhausted after every continuation: " ++ partial)
            }
            output_continuations = output_continuations + 1
            push context user("Continue the current task from the interrupted response. The output token limit was reached. Do not repeat completed tool actions.")
          }
          paused => { output_continuations = 0 }
          context_full => {
            if context_recovery_attempted {
              return failed("context window exhausted after recovery")
            }
            context_recovery_attempted = true
            compact()
            push context user("Continue the current task from the interrupted response. The context window was exhausted and the conversation was compacted. Do not repeat completed tool actions.")
          }
          refused(reason) => { return failed("provider refused the request; turn stopped: " ++ reason) }
        }
      }
    }
  }
  return exhausted
}
