harness claude_code

const rounds_max: u64 = 512
const calls_per_round_max: u64 = 16
const context_entries_max: u64 = 4096
const context_window_tokens: u64 = 200000
const compaction_reserved_tokens: u64 = 33000
const result_tokens_max: u64 = 12000
const direct_result_tokens_max: u64 = 25000
const direct_result_units_max: u64 = 100039
const turns_max: u64 = 1000000
const continuations_max: u64 = 3
const throttled_attempts_max: u64 = 10
const attempts_max: u64 = 11
const compaction_attempts_max: u64 = 3
const retry_base_ms: u64 = 500
const retry_cap_ms: u64 = 32000
const retry_delay_max_ms: u64 = 60000
const throttled_wait_ms: u64 = 180000
const bash_timeout_ms: u64 = 120000
const read_offset_first: u64 = 1
const read_limit_whole: u64 = 0
const image_bytes_max: u64 = 1048576
const images_kept: u64 = 100
const mcp_tools_max: u64 = 64
const tool_search_results_default: u64 = 5
const cache_lifetime_ms: u64 = 300000
const cache_refreshes: u64 = 12
const clock_ms_max: u64 = 8640000000000000
const bash_jobs_max: u64 = 8
const job_notices_max: u64 = 8
const job_hold_ms: u64 = 600000
const probe_timeout_ms: u64 = 30000
const agents_chunks_max: u64 = 4

type claude_model = "claude-opus-5-5" | "claude-fable-5-5" | "claude-fable-5-2" | "claude-mythos-5-2" | "claude-fable-5-1" | "claude-mythos-5-1" | "claude-sonnet-5-5" | "claude-haiku-5-5" | "claude-opus-5" | "claude-sonnet-5" | "claude-opus-4-6" | "claude-sonnet-4-6" | "claude-haiku-4-5" | "claude-haiku-4-5-20251001" | "claude-sonnet-4-5" | "claude-sonnet-4-5-20250929" | "claude-opus-4-5" | "claude-opus-4-5-20251101"
type outcome = completed(text) | failed(text) | exhausted
type claude_reply = answer(text, text) | calls(list<call, calls_per_round_max>, text, text)
type kept = refreshed(u64) | lapsed(text)
type effort_level = "low" | "medium" | "high"
type effort_choice = "default" | "low" | "medium" | "high"

tool Bash(command: text, timeout: u64 = bash_timeout_ms, description: text = "", run_in_background: bool = false, dangerouslyDisableSandbox: bool = false) -> text effect external recoverable jobs at most bash_jobs_max
tool Read(file_path: text, offset: u64 = read_offset_first, limit: u64 = read_limit_whole, pages: text = "", allow_large: bool = false) -> text or blob<image_bytes_max> effect none
tool Edit(file_path: text, old_string: text, new_string: text, replace_all: bool = false) -> text effect external recoverable
tool Write(file_path: text, content: text) -> text effect external recoverable
tool ToolSearch(query: text, max_results: u64 = tool_search_results_default) -> text effect none finds mcp
tools from listing(mcp, mcp_tools_max) (arguments: text) effect external
tool list_agents(include_completed: bool = false) -> text effect none
tool wait_agent(agent_id: text) -> text effect none
spawn spawn_agent runs delegated from "claude_code_child.hl"

model messages calls calls_per_round_max reply claude_reply window context_window_tokens modes text_only, refresh settings(url: text = "", headers: text = "[]", head: text = "", tail: text = "") wire anthropic

on resume
on job(notice: text) bound job_notices_max

state {
  context: list<entry, context_entries_max>
  turns: u64
  output_continuations: u64
  attempts: u64
  waited_ms: u64
  backoff_ms: u64
  refusal_recovered: bool
  context_recovery_attempted: bool
  tools_restated: bool
  context_tokens: u64
  pending_units: u64
  round_entries: u64
  compact_pending: bool
  delay_ms: u64
  calls_run: bool
  compaction_prompt: text
  summary_text: text
  summary_ready: bool
  requested_ms: u64
  refresh_due: u64
  joins_requested: bool
  effort: effort_level
  pinned: effort_level
  configured: bool
  probed: bool
  adaptive: bool
  model_id: text
  max_tokens_text: text
  scratch: text
  url: text
  headers: text
  head: text
  head_refresh: text
  tail_low: text
  tail_text_only: text
  tail_main: text
  tail_refresh: text
  env_cwd: text
  env_git: text
  env_platform: text
  env_shell: text
  env_os: text
  env_date: text
  env_login: text
  env_loginfile: text
  env_stale: text
  env_haskey: text
  env_hasbase: text
  env_hasoauth: text
  login_route: text
  login_refreshed: bool
  agents_present: bool
  agents_more: bool
  agents_text: text
  agents_skip: text
}

invariant turns_bounded: turns <= turns_max
invariant context_room: len(context) < context_entries_max
invariant continuations_bounded: output_continuations <= continuations_max
invariant attempts_bounded: attempts < attempts_max
invariant waited_bounded: waited_ms <= throttled_wait_ms
invariant backoff_bounded: backoff_ms <= retry_cap_ms
invariant tokens_bounded: context_tokens <= 4 * context_window_tokens
invariant pending_bounded: pending_units <= calls_per_round_max * direct_result_units_max
invariant round_bounded: round_entries <= 1 + calls_per_round_max
invariant delay_bounded: delay_ms <= retry_delay_max_ms

fn login_refresh_done(out: text) {
  env_stale = "no"
  if not contains(out, "@@hl-refresh@@ok@@hl-end@@") {
    return failed("the Claude login refresh failed: " ++ before(after(out, "@@hl-refresh@@"), "@@hl-end@@") ++ "; sign in again with claude")
  }
}

fn login_rejected(error: text) {
  if login_route == "subscription" and not login_refreshed and contains(error, "HTTP 401") {
    refresh_login()
  } else {
    repair_history(error)
  }
}


fn refresh_login() {
  login_refreshed = true
  match Bash("f='" ++ env_loginfile ++ "'; m='" ++ env_login ++ "'\numask 077\nv() { sed -n \"s/.*\\\"$1\\\": *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | head -n 1; }\nsay() { printf '@@hl-refresh@@%s@@hl-end@@' \"$1\"; exit 0; }\nsafe() { case $1 in '' | *[!A-Za-z0-9._-]*) say 'the token server answered an unexpected token';; esac; }\npost() { curl -sS --max-time 20 -X POST -H 'content-type: application/json' --data-binary @- -w '\\n@@hl-status@@%{http_code}' \"$1\" 2>/dev/null; }\nwhy() { e=$(printf '%s' \"$b\" | v error); [ -n \"$e\" ] || e=$(printf '%s' \"$b\" | v code); [ -n \"$e\" ] || e=$(printf '%s' \"$b\" | v type); printf 'HTTP %s %s' \"$c\" \"$(printf '%s' \"$e\" | tr -cd 'A-Za-z0-9_ .-')\"; }\nw() { t=$(mktemp \"$f.XXXXXX\") || say 'no temporary file beside the login file'; if awk '{ s = $0; h = \"\"; if (!on) { p = index(s, \"\\\"\" ENVIRON[\"HL_SCOPE\"] \"\\\"\"); if (p == 0) { print s; next } on = 1; h = substr(s, 1, p - 1); s = substr(s, p) } n = split(ENVIRON[\"HL_TEXTS\"], t, \" \"); for (j = 1; j <= n; j++) if (!d[t[j]] && match(s, \"\\\"\" t[j] \"\\\": *\\\"[^\\\"]*\\\"\")) { s = substr(s, 1, RSTART - 1) \"\\\"\" t[j] \"\\\": \\\"\" ENVIRON[\"HL_\" t[j]] \"\\\"\" substr(s, RSTART + RLENGTH); d[t[j]] = 1 } n = split(ENVIRON[\"HL_NUMBERS\"], t, \" \"); for (j = 1; j <= n; j++) if (!d[t[j]] && match(s, \"\\\"\" t[j] \"\\\": *[0-9]+\")) { s = substr(s, 1, RSTART - 1) \"\\\"\" t[j] \"\\\": \" ENVIRON[\"HL_\" t[j]] substr(s, RSTART + RLENGTH); d[t[j]] = 1 } print h s } END { n = split(ENVIRON[\"HL_TEXTS\"] \" \" ENVIRON[\"HL_NUMBERS\"], t, \" \"); for (j = 1; j <= n; j++) if (!d[t[j]]) exit 1 }' \"$f\" > \"$t\" && HL_HELD=$1 awk 'index($0, ENVIRON[\"HL_HELD\"]) { f = 1 } END { exit !f }' \"$t\"; then mv -f \"$t\" \"$f\"; else rm -f \"$t\"; say 'the login file did not take the new token'; fi; }\no() { sed -n 's/.*\"claudeAiOauth\": *{\\([^}]*\\)}.*/\\1/p' \"$f\" | head -n 1; }\nif [ \"$m\" = keychain ]; then k=$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null) && [ -n \"$k\" ] && printf '%s' \"$k\" > \"$f.new\" && mv -f \"$f.new\" \"$f\" || say 'the keychain holds no Claude login'; x=$(o | sed -n 's/.*\"expiresAt\": *\\([0-9]*\\).*/\\1/p'); if [ -n \"$x\" ] && [ \"$x\" -gt \"$(date +%s)000\" ]; then say ok; fi; say 'the keychain login has expired; run claude once to renew it'; fi\nr=$(o | v refreshToken); [ -n \"$r\" ] || say 'the login has no refresh token'; safe \"$r\"\nb=$(printf '{\"grant_type\":\"refresh_token\",\"refresh_token\":\"%s\",\"client_id\":\"9d1c250a-e61b-44d9-88ed-5944d1962f5e\"}' \"$r\" | post \"${HL_CLAUDE_TOKEN_URL:-https://console.anthropic.com/v1/oauth/token}\")\nc=${b##*@@hl-status@@}; b=${b%@@hl-status@@*}\na=$(printf '%s' \"$b\" | v access_token); n=$(printf '%s' \"$b\" | v refresh_token); x=$(printf '%s' \"$b\" | sed -n 's/.*\"expires_in\": *\\([0-9]*\\).*/\\1/p' | head -n 1)\nif [ \"$c\" != 200 ] || [ -z \"$a\" ] || [ -z \"$x\" ]; then [ \"$(o | v refreshToken)\" = \"$r\" ] || say ok; say \"$(why)\"; fi\n[ -n \"$n\" ] || n=$r; safe \"$a\"; safe \"$n\"\nHL_SCOPE=claudeAiOauth HL_TEXTS='accessToken refreshToken' HL_NUMBERS=expiresAt HL_accessToken=$a HL_refreshToken=$n HL_expiresAt=$(( ($(date +%s) + x) * 1000 )) w \"$a\"\nsay ok", probe_timeout_ms, "Refresh the Claude login", false, false) {
    ok(out) => { login_refresh_done(out) }
    failed(error) => { return failed("the Claude login refresh failed: " ++ error) }
    unknown => {}
  }
}

fn choose_login() {
  login_route = "key"
  if env_hasbase == "yes" and env_haskey == "yes" {
    login_route = "base"
  } else if env_login == "file" or env_login == "keychain" {
    login_route = "subscription"
    if contains(env_loginfile, "'") or contains(env_loginfile, "}") or contains(env_loginfile, "#") or contains(env_loginfile, "\\") {
      return failed("the Claude login file path holds a quote, a brace, a hash or a backslash")
    }
    if env_stale == "yes" {
      refresh_login()
    }
  } else if env_hasoauth == "yes" {
    login_route = "token"
  } else if env_haskey == "no" {
    return failed("no model login: sign in with claude for the Claude subscription, or set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY")
  }
}

fn probed_fields(out: text, chunk: u64) {
  if chunk == 0 {
    probed = true
    env_cwd = before(after(out, "@@hl-cwd@@"), "@@hl-")
    env_git = before(after(out, "@@hl-git@@"), "@@hl-")
    env_platform = before(after(out, "@@hl-platform@@"), "@@hl-")
    env_shell = before(after(out, "@@hl-shell@@"), "@@hl-")
    env_os = before(after(out, "@@hl-os@@"), "@@hl-")
    env_date = before(after(out, "@@hl-date@@"), "@@hl-")
    env_login = before(after(out, "@@hl-login@@"), "@@hl-")
    env_loginfile = before(after(out, "@@hl-loginfile@@"), "@@hl-")
    env_stale = before(after(out, "@@hl-stale@@"), "@@hl-")
    env_haskey = before(after(out, "@@hl-haskey@@"), "@@hl-")
    env_hasbase = before(after(out, "@@hl-hasbase@@"), "@@hl-")
    env_hasoauth = before(after(out, "@@hl-hasoauth@@"), "@@hl-")
  }
  let agents = before(after(out, "@@hl-agents@@"), "@@hl-end@@")
  if contains(agents, "present@@hl-text@@") {
    agents_present = true
    agents_text = agents_text ++ before(after(agents, "present@@hl-text@@"), "@@hl-more@@")
    agents_more = contains(agents, "@@hl-more@@")
    agents_skip = agents_skip ++ "1"
  }
}

fn probe_lost() {
  agents_more = false
  agents_present = false
  agents_text = ""
}

fn pin_tails() {
  match pinned {
    "low" => { thinking("low") }
    "medium" => { thinking("medium") }
    "high" => { thinking("high") }
  }
  tail_main = ",\"stream\":true" ++ scratch ++ "}"
  tail_refresh = ",\"stream\":false" ++ scratch ++ "}"
  scratch = ""
}

fn thinking(level: text) {
  if adaptive {
    scratch = ",\"thinking\":{\"type\":\"adaptive\",\"display\":\"summarized\"},\"output_config\":{\"effort\":\"" ++ level ++ "\"}"
  } else {
    scratch = ",\"thinking\":{\"type\":\"disabled\"}"
  }
}

fn compose() {
  if login_route == "subscription" {
    url = "${ANTHROPIC_BASE_URL:-https://api.anthropic.com}/v1/messages"
    headers = "[[\"authorization\",\"Bearer ${@" ++ env_loginfile ++ "#claudeAiOauth.accessToken}\"],[\"anthropic-beta\",\"oauth-2025-04-20\"],[\"anthropic-version\",\"2023-06-01\"],[\"content-type\",\"application/json\"]]"
  } else if login_route == "token" {
    url = "${ANTHROPIC_BASE_URL:-https://api.anthropic.com}/v1/messages"
    headers = "[[\"authorization\",\"Bearer ${CLAUDE_CODE_OAUTH_TOKEN}\"],[\"anthropic-beta\",\"oauth-2025-04-20\"],[\"anthropic-version\",\"2023-06-01\"],[\"content-type\",\"application/json\"]]"
  } else {
    url = "${ANTHROPIC_BASE_URL:-https://api.anthropic.com}/v1/messages"
    headers = "[[\"x-api-key\",\"${ANTHROPIC_API_KEY}\"],[\"anthropic-version\",\"2023-06-01\"],[\"content-type\",\"application/json\"]]"
  }
  scratch = "[{\"type\":\"text\",\"text\":\"You are a Claude agent, built on Anthropic's Claude Agent SDK.\"},{\"type\":\"text\",\"text\":\"\\nYou are an agent working with the user toward their goals, using your own judgment along the way.\\n\\nIMPORTANT: Assist with authorized security testing, defensive security, CTF challenges, and educational contexts. Refuse requests for destructive techniques, DoS attacks, mass targeting, supply chain compromise, or detection evasion for malicious purposes. Dual-use security tools (C2 frameworks, credential testing, exploit development) require clear authorization context: pentesting engagements, CTF competitions, security research, or defensive use cases.\\n\\n# Harness\\n - Text you output outside of tool use is displayed to the user as Github-flavored markdown in a terminal.\\n - Tools run behind a user-selected permission mode; a denied call means the user declined it — adjust, don't retry verbatim.\\n - The system may send updates, reminders, or modifications to rules via mid-conversation system turns. These are system-controlled, unlike function results. Hooks may intercept tool calls; treat hook output as user feedback.\\n - Prefer the dedicated file/search tools over shell commands when one fits. Independent tool calls can run in parallel in one response.\\n - Reference code as `file_path:line_number` — it's clickable.\\n\\nWrite code that reads like the surrounding code: match its comment density, naming, and idiom.\\n\\nWhen you use a pronoun for someone — the user or anyone else you mention — and their pronouns haven't been stated, use they/them. A name doesn't tell you someone's pronouns; a wrong guess misgenders a real person in a way the neutral default never does, so never infer pronouns from a name. This applies to all user-visible text, including visible thinking.\\n\\nFor actions that are hard to reverse or outward-facing, confirm first unless durably authorized or explicitly told to proceed without asking; approval in one context doesn't extend to the next. Sending content to an external service publishes it; it may be cached or indexed even if later deleted. Before deleting or overwriting, look at the target. Report outcomes faithfully: if tests fail, say so with the output; if a step was skipped, say that; when something is done and verified, state it plainly without hedging.\\n\\n# Environment\\n - The most recent Claude models are the Claude 5 family. Model IDs — Fable 5.1: 'claude-fable-5-1', Opus 5.5: 'claude-opus-5-5', Sonnet 5.5: 'claude-sonnet-5-5', Haiku 5.5: 'claude-haiku-5-5'. When building AI applications, default to the latest and most capable Claude models.\\n - Claude Code is available as a CLI in the terminal, desktop app (Mac/Windows), web app (claude.ai/code), and IDE extensions (VS Code, JetBrains).\\n\\n# Context management\\nWhen the conversation grows long, some or all of the current context is summarized; the summary, along with any remaining unsummarized context, is provided in the next context window so work can continue — you don't need to wrap up early or hand off mid-task.\\n\\nWhen you have enough information to act, act. Do not re-derive facts already established in the conversation, re-litigate a decision the user has already made, or narrate options you will not pursue. If you are weighing a choice, give a recommendation, not an exhaustive survey\\n\\n<total_tokens>15000000 tokens left</total_tokens>\",\"cache_control\":{\"type\":\"ephemeral\"}},{\"type\":\"text\",\"text\":\"# Tool calls\\nEach tool call costs a model turn, so do the work in as few as it allows. Put steps whose order is already known into one Bash command (`&&`, a loop, a here-doc script) instead of one call per step, and check their result in that same command. Make calls that do not depend on each other, such as reads of different files, together in one response. Read only the part of a file you need: search a large file with `grep -n` first, then Read with offset and limit. Return only the output the next decision needs: cut long output with grep, head or tail. Start a server in the background with its output redirected to a file, and check it in the command that starts it. Use separate calls only when an intermediate result needs your judgment.\\n\\n# Inputs\\nThe files and state the task gives you may be the only copy. Look at them with read-only tools first (ls, file, xxd, head, git log). Before running anything that can write to them, copy them aside with `cp -a` and work on the copy: opening a database (SQLite checkpoints or deletes a WAL or journal it cannot read when the connection closes), a build, converter or formatter run in place, a git command that rewrites refs or the index.\\n\\n# Finishing\\nWrite each file the task asks for as soon as you have a working version, then improve it in place, so a time limit never leaves nothing behind. Before you finish, check the result the way it will be used: run the exact command or interpreter the task names on the exact paths it names, in a fresh login shell such as `env -i bash -lc '<command>'`, where variables you exported and other session state are gone. Check every requirement the task states, not only the main one, and exercise each behaviour it names for real: step through a debugger it mentions, deliver a keyboard interrupt as SIGINT to a separate process running the program (`python3 prog.py & sleep 1; kill -INT $!`), and run with more work than any limit it sets as well as less. A program the task says is on PATH must be found there, so install or link it into /usr/local/bin rather than exporting PATH. If the check needs an interpreter or tool that is missing (python3, node, a compiler), install it with the system package manager (`apt-get install -y python3`) and run the check. A part you have not run is not done: never finish with \\\"X is not installed here, but it should work\\\". Test a service through the interface its user will use: the protocol, port, account and authentication the task names. Leave what the task produced in place: do not delete or revert what a smoke test created inside the deliverable (a deployed page, a pushed commit, rows in a database, files in a web root), since the user's own check expects to find it; remove only scratch files outside it, such as a temporary clone. Keep your own test inputs and scratch files out of the task's directories (use /tmp): a file of yours next to the deliverables can shadow the one the user's check reads. Put things exactly where the task names: extract an archive in full into the directory it gives, not selected parts of it. Finish the work instead of asking which way to go: when the task allows two readings, take the one its files support (for lost git work, `git reflog` shows what was checked out and when), do it, and say what you chose.\",\"cache_control\":{\"type\":\"ephemeral\"}},{\"type\":\"text\",\"text\":\"# Environment\\nYou have been invoked in the following environment: \\nPrimary working directory: " ++ env_cwd ++ "\\nIs a git repository: " ++ env_git ++ "\\nPlatform: " ++ env_platform
  if env_shell != "" {
    scratch = scratch ++ "\\nShell: " ++ env_shell
  }
  if env_os != "" {
    scratch = scratch ++ "\\nOS Version: " ++ env_os
  }
  scratch = scratch ++ "\\nToday's date: " ++ env_date ++ "\"}"
  if agents_present {
    scratch = scratch ++ ",{\"type\":\"text\",\"text\":\"# AGENTS.md instructions for " ++ env_cwd ++ "\\n\\n<INSTRUCTIONS>\\n" ++ agents_text ++ "\\n</INSTRUCTIONS>\"}"
  }
  head = "{\"model\":\"" ++ model_id ++ "\",\"max_tokens\":" ++ max_tokens_text ++ ",\"system\":" ++ scratch ++ "],\"tools\":[{\"name\":\"Read\",\"description\":\"Reads a file from the local filesystem.\\n\\n- `file_path` must be an absolute path.\\n- Reads up to 2000 lines by default.\\n- When you already know which part of the file you need, only read that part. This can be important for larger files.\\n- Results are returned using cat -n format, with line numbers starting at 1\\n- Reads images (PNG, JPG, …) and presents them visually. Reads PDFs via the `pages` parameter (e.g. \\\"1-5\\\", max 20 pages/request; required for PDFs over 10 pages). Reads Jupyter notebooks (.ipynb) as cells with outputs.\\n- Reading a directory, a missing file, or an empty file returns an error or system reminder rather than content.\\n- Do NOT re-read a file you just edited to verify — Edit/Write would have errored if the change failed, and the harness tracks file state for you.\",\"input_schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"file_path\":{\"description\":\"The absolute path to the file to read\",\"type\":\"string\"},\"offset\":{\"description\":\"The line number to start reading from. Only provide if the file is too large to read at once\",\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"limit\":{\"description\":\"The number of lines to read. Only provide if the file is too large to read at once.\",\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991},\"pages\":{\"description\":\"Page range for PDF files (e.g., \\\"1-5\\\", \\\"3\\\", \\\"10-20\\\"). Only applicable to PDF files. Maximum 20 pages per request.\",\"type\":\"string\"},\"allow_large\":{\"description\":\"Set to true to read a text file, or a line range of one, that is over the usual size limits, up to what still fits in your context. Only use this when you genuinely need all of it or the user asked for the whole file; otherwise read it in parts with offset and limit, or search it.\",\"type\":\"boolean\"}},\"required\":[\"file_path\"],\"additionalProperties\":false}},{\"name\":\"Edit\",\"description\":\"Performs exact string replacement in a file.\\n\\n- You must Read the file in this conversation before editing, or the call will fail.\\n- `old_string` must match the file exactly, including indentation, and be unique — the edit fails otherwise. Strip the Read line prefix (line number + tab) before matching.\\n- `replace_all: true` replaces every occurrence instead.\",\"input_schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"file_path\":{\"description\":\"The absolute path to the file to modify\",\"type\":\"string\"},\"old_string\":{\"description\":\"The text to replace\",\"type\":\"string\"},\"new_string\":{\"description\":\"The text to replace it with (must be different from old_string)\",\"type\":\"string\"},\"replace_all\":{\"description\":\"Replace all occurrences of old_string (default false)\",\"default\":false,\"type\":\"boolean\"}},\"required\":[\"file_path\",\"old_string\",\"new_string\"],\"additionalProperties\":false}},{\"name\":\"Write\",\"description\":\"Writes a file to the local filesystem, overwriting if one exists.\\n\\nWhen to use: creating a new file, or fully replacing one you've already Read. Overwriting an existing file you haven't Read will fail. For partial changes, use Edit instead.\",\"input_schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"file_path\":{\"description\":\"The absolute path to the file to write (must be absolute, not relative)\",\"type\":\"string\"},\"content\":{\"description\":\"The content to write to the file\",\"type\":\"string\"}},\"required\":[\"file_path\",\"content\"],\"additionalProperties\":false}},{\"name\":\"Bash\",\"description\":\"Executes a bash command and returns its output.\\n\\n- Working directory persists between calls, but prefer absolute paths — `cd` in a compound command can trigger a permission prompt. Shell state (env vars, functions) does not persist; the shell is initialized from the user's profile.\\n- IMPORTANT: Avoid using this tool to run `cat`, `head`, `tail`, `sed`, `awk`, or `echo` commands, unless explicitly instructed or after you have verified that a dedicated tool cannot accomplish your task. Instead, use the appropriate dedicated tool as this will provide a much better experience for the user.\\n- Command output is displayed to you, not reliably to the user.\\n- `timeout` is in milliseconds: default 120000, max 600000 for a foreground command.\\n- `run_in_background` runs the command detached: it keeps running across turns and re-invokes you when it exits. With it, `timeout` is how long the command may run in the background (default 600000, max 7200000); at that limit it is stopped and you are re-invoked. No `&` needed.\\n\\n# Git\\n- Interactive flags (`-i`, e.g. `git rebase -i`, `git add -i`) are not supported in this environment.\\n- Use the `gh` CLI for GitHub operations (PRs, issues, API).\\n- Commit or push only when the user asks. If on the default branch, branch first.\\n- End git commit messages and PR bodies with the attribution lines given in the conversation's system-reminder, when one is present.\",\"input_schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"command\":{\"description\":\"The command to execute\",\"type\":\"string\"},\"timeout\":{\"description\":\"Optional timeout in milliseconds (max 600000 for a foreground command)\",\"type\":\"number\"},\"description\":{\"description\":\"Clear, concise description of what this command does in active voice. Never use words like \\\"complex\\\" or \\\"risk\\\" in the description - just describe what it does.\\n\\nSay what the command does in plain words: do not echo the command's text, its flags, or file paths - the user reads this description, often without seeing the command.\\n\\nFor simple commands (git, npm, standard CLI tools), keep it brief (5-10 words):\\n- ls → \\\"List files in current directory\\\"\\n- git status → \\\"Show working tree status\\\"\\n- npm install → \\\"Install package dependencies\\\"\\n\\nFor commands that are harder to parse at a glance (piped commands, obscure flags, etc.), add enough context to clarify what it does:\\n- find . -name \\\"*.tmp\\\" -exec rm {} \\\\; → \\\"Find and delete all .tmp files recursively\\\"\\n- git reset --hard origin/main → \\\"Discard all local changes and match remote main\\\"\\n- curl -s url | jq '.data[]' → \\\"Fetch JSON from URL and extract data array elements\\\"\",\"type\":\"string\"},\"run_in_background\":{\"description\":\"Set to true to run this command in the background. With it, `timeout` limits how long the command may run in the background before it is stopped (default 600000 ms, max 7200000 ms).\",\"type\":\"boolean\"},\"dangerouslyDisableSandbox\":{\"description\":\"Set this to true to dangerously override sandbox mode and run commands without sandboxing.\",\"type\":\"boolean\"}},\"required\":[\"command\"],\"additionalProperties\":false}},{\"name\":\"spawn_agent\",\"description\":\"Starts a reusable clean-room subagent without inherited conversation history and immediately returns its ID. When the root agent is durable, the task tree survives runtime restarts with the same IDs and interrupted children resume from their latest committed checkpoint; otherwise children are dropped when the parent runtime restarts. Delegate meaningful, separable work and handle trivial or tightly coupled work directly. Start independent subtasks in parallel, wait for and reduce their results, then dispatch dependent stages. Do not repeat delegated work; double-check results against the relevant evidence before relying on them. Keep concurrent write scopes disjoint, and own final synthesis and verification.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\",\"description\":\"A short role describing the subagent's specialty.\"},\"task\":{\"type\":\"string\",\"description\":\"A complete, focused task for the subagent.\"}},\"required\":[\"role\",\"task\"],\"additionalProperties\":false}},{\"name\":\"wait_agent\",\"description\":\"Waits until the requested subagent reaches a terminal status and returns its result: the JSON of what it ended with, {\\\"submitted\\\": output} when it submitted a result, {\\\"failed\\\": error} or \\\"exhausted\\\" otherwise. Waiting again on an agent that already finished returns the same result at once. Use one call per agent, one after another, to collect several.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\",\"description\":\"The agent ID returned by spawn_agent.\"}},\"required\":[\"agent_id\"],\"additionalProperties\":false}},{\"name\":\"list_agents\",\"description\":\"Lists agents in the same task tree in agent_id order. Pending, running, and recoverable interrupted agents are returned by default. Set include_completed to retrieve terminal statuses and completed results in status.output.\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"include_completed\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Also includes completed, failed, closed, and nonrecoverable interrupted agents.\"}},\"additionalProperties\":false},\"cache_control\":{\"type\":\"ephemeral\"}}],\"messages\":"
