fn probed_output(out: text, chunk: u64) {
  if not contains(out, "@@hl-end@@") {
    probe_lost()
  } else {
    probed_fields(out, chunk)
  }
}

fn probe(cwd: text) {
  agents_more = true
  agents_present = false
  agents_text = ""
  agents_skip = ""
  loop chunk below agents_chunks_max {
    if agents_more {
      agents_more = false
      match Bash("c='" ++ cwd ++ "'; s='" ++ agents_skip ++ "'\ncd -- \"$c\" || exit 1\ne() { LC_ALL=C od -An -tu1 -v | LC_ALL=C awk 'BEGIN { n = 0 } { for (i = 1; i <= NF; i++) { b[n] = $i + 0; n++ } } END { while (n > 0 && (b[n-1] == 32 || b[n-1] == 9 || b[n-1] == 10 || b[n-1] == 13 || b[n-1] == 12 || b[n-1] == 11)) n--; i = 0; while (i < n) { c = b[i]; if (c == 34) { printf \"%s\", \"\\\\\\\"\"; i++ } else if (c == 92) { printf \"%s\", \"\\\\\\\\\"; i++ } else if (c == 10) { printf \"%s\", \"\\\\n\"; i++ } else if (c == 9) { printf \"%s\", \"\\\\t\"; i++ } else if (c == 13) { printf \"%s\", \"\\\\r\"; i++ } else if (c < 32 || c == 127) { printf \"\\\\u%04x\", c; i++ } else if (c < 128) { printf \"%c\", c; i++ } else if (c >= 240 && c < 248 && i + 3 < n) { p = (c - 240) * 262144 + (b[i+1] - 128) * 4096 + (b[i+2] - 128) * 64 + (b[i+3] - 128) - 65536; printf \"\\\\u%04x\\\\u%04x\", 55296 + int(p / 1024), 56320 + p % 1024; i += 4 } else if (c >= 224 && c < 240 && i + 2 < n) { printf \"\\\\u%04x\", (c - 224) * 4096 + (b[i+1] - 128) * 64 + (b[i+2] - 128); i += 3 } else if (c >= 192 && c < 224 && i + 1 < n) { printf \"\\\\u%04x\", (c - 192) * 64 + (b[i+1] - 128); i += 2 } else { printf \"%s\", \"\\\\ufffd\"; i++ } } }'; }\nk=24000\nif [ -z \"$s\" ]; then\nprintf '@@hl-cwd@@'; printf '%s' \"$c\" | e\nprintf '@@hl-git@@'; d=$c; g=false; while :; do if [ -e \"$d/.git\" ]; then g=true; break; fi; if [ \"$d\" = / ] || [ -z \"$d\" ]; then break; fi; d=$(dirname -- \"$d\"); done; printf '%s' \"$g\"\nprintf '@@hl-platform@@'; uname -s 2>/dev/null | tr 'A-Z' 'a-z' | e\nprintf '@@hl-shell@@'; if [ -n \"${SHELL:-}\" ]; then printf '%s' \"${SHELL##*/}\" | e; fi\nprintf '@@hl-os@@'; uname -sr 2>/dev/null | e\nprintf '@@hl-date@@'; date +%Y-%m-%d 2>/dev/null | e\nprintf '@@hl-login@@'; h=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json; m=file; o=$(sed -n 's/.*\"claudeAiOauth\": *{\\([^}]*\\)}.*/\\1/p' \"$h\" 2>/dev/null | head -n 1); if ! printf '%s' \"$o\" | grep -q '\"accessToken\": *\"[^\"]'; then if [ \"$(uname -s)\" = Darwin ] && k=$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null) && [ -n \"$k\" ]; then h=$HOME/.hl/claude-credentials.json; m=keychain; mkdir -p \"$HOME/.hl\" && (umask 077 && printf '%s' \"$k\" > \"$h.new\" && mv -f \"$h.new\" \"$h\"); o=$(sed -n 's/.*\"claudeAiOauth\": *{\\([^}]*\\)}.*/\\1/p' \"$h\" | head -n 1); fi; fi; if printf '%s' \"$o\" | grep -q '\"accessToken\": *\"[^\"]'; then printf '%s' \"$m\"; printf '@@hl-loginfile@@'; printf '%s' \"$h\" | e; printf '@@hl-stale@@'; x=$(printf '%s' \"$o\" | sed -n 's/.*\"expiresAt\": *\\([0-9]*\\).*/\\1/p'); if [ -n \"$x\" ] && [ \"$x\" -le \"$(date +%s)000\" ]; then printf yes; else printf no; fi; else printf none; fi\nprintf '@@hl-haskey@@'; if [ -n \"${ANTHROPIC_API_KEY:-}\" ]; then printf yes; else printf no; fi\nprintf '@@hl-hasbase@@'; if [ -n \"${ANTHROPIC_BASE_URL:-}\" ]; then printf yes; else printf no; fi\nprintf '@@hl-hasoauth@@'; if [ -n \"${CLAUDE_CODE_OAUTH_TOKEN:-}\" ]; then printf yes; else printf no; fi\nfi\nprintf '@@hl-agents@@'\nif [ -f AGENTS.md ] && [ -r AGENTS.md ]; then printf 'present@@hl-text@@'; e < AGENTS.md | tail -c +$((${#s} * k + 1)) | head -c \"$k\"; t=$(e < AGENTS.md | wc -c); if [ \"$t\" -gt $(((${#s} + 1) * k)) ]; then printf '@@hl-more@@'; fi; fi\nprintf '@@hl-end@@'", probe_timeout_ms, "Read the environment for the system prompt", false, false) {
        ok(out) => { probed_output(out, chunk) }
        failed(_) => { probe_lost() }
        unknown => { probe_lost() }
      }
    }
  }
  if agents_more {
    return failed("AGENTS.md is longer than the environment probe reads")
  }
}

