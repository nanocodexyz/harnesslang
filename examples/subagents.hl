harness subagents

const rounds_max: u64 = 32
const calls_per_round_max: u64 = 8
const context_entries_max: u64 = 4096
const compact_kept: u64 = 32
const agents_max: u64 = 4096
const agents_kept: u64 = 3072
const turns_max: u64 = 1000000

type outcome = completed(text) | failed(text) | exhausted
type status = "completed" | "failed" | "interrupted"

tool Read(file_path: text) -> text effect none
tool Bash(command: text) -> text effect external
tool wait_agent(agent: text) -> text effect none
tool list_agents(filter: text) -> text effect none
tool send_agent_message(agent: text, message: text) -> text effect external
spawn spawn_agent runs task from "subagent_child.hl"

model messages calls calls_per_round_max

on resume

state {
  context: list<entry, context_entries_max>
  agents: list<text, agents_max>
  finished: list<text, agents_max>
  turns: u64
}

invariant turns_bounded: turns <= turns_max
invariant context_room: len(context) < context_entries_max
invariant agents_bounded: len(agents) <= agents_max
invariant finished_bounded: len(finished) <= agents_max

on subagent start(agent: text) {
  push agents agent
}

on subagent stop(agent: text, result: text) {
  push finished agent
}

fn model_loop() {
  turns = turns + 1
  loop round below rounds_max {
    if len(context) + 1 + (1 + calls_per_round_max) > context_entries_max {
      keep context last context_entries_max - 2
      push context user("Summarize the conversation so far for a fresh start: the task, what was done, what is left.")
      let summary = messages(context)
      keep context last compact_kept
      match summary {
        answer(_) => { push context assistant(summary) }
        calls(_) => { return failed("compaction answered with tool calls") }
      }
    }
    let reply = messages(context)
    push context assistant(reply)
    match reply {
      answer(words) => { return completed(words) }
      calls(requested) => {
        for call in requested {
          if call.tool == "wait_agent" {
            let quote = after(before(call.input, "agent"), "{")
            let named = before(after(call.input, ":" ++ quote), quote)
            let result = join(named)
            push context result(call, result)
          } else {
            match dispatch(call) {
              ok(output) => { push context result(call, output) }
              failed(error) => { push context error(call, error) }
              unknown => { push context unknown(call) }
            }
          }
        }
      }
    }
  }
  return exhausted
}

on prompt(input: text) -> outcome
  requires turns < turns_max
    and len(agents) + rounds_max * calls_per_round_max <= agents_max
    and len(finished) + rounds_max * calls_per_round_max <= agents_max
{
  push context user(input)
  model_loop()
}

on completion(agent: text, status: status, detail: text) -> outcome
  requires turns < turns_max
{
  match status {
    "completed" => {
      push context user("Subagent " ++ agent ++ " completed with this structured result: " ++ detail ++ " Continue the current task using only the result fields needed for the next step.")
    }
    "failed" => {
      push context user("Subagent " ++ agent ++ " failed: " ++ detail ++ " Continue the current task: decide whether to retry, recover, or report the failure.")
    }
    "interrupted" => {
      push context user("Subagent " ++ agent ++ " was interrupted before finishing. Continue the current task: call list_agents to inspect it.")
    }
  }
  keep agents last agents_kept
  keep finished last agents_kept
  model_loop()
}
