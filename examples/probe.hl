harness probe

const steps_max: u64 = 2
const calls_max: u64 = 2
const log_max: u64 = 64
const turns_max: u64 = 1000000

tool look(key: text) -> text effect none
tool save(body: text) -> text effect idempotent
tool send(body: text) -> text effect external

model think calls calls_max

state {
  log: list<entry, log_max>
  turns: u64
}

invariant turns_bounded: turns <= turns_max
invariant log_bounded: len(log) <= log_max

on ask(question: text) -> text
  requires turns < turns_max
    and len(log) + 1 + steps_max * (1 + calls_max) <= log_max
{
  push log user(question)
  turns = turns + 1
  loop step below steps_max {
    let reply = think(log)
    push log assistant(reply)
    match reply {
      answer(words) => { return words }
      calls(requested) => {
        for call in requested {
          match dispatch(call) {
            ok(output) => { push log result(call, output) }
            failed(error) => { push log error(call, error) }
            unknown => { push log unknown(call) }
          }
        }
      }
    }
  }
  return "no answer within steps_max"
}
