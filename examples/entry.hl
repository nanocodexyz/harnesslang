harness entry

type outcome = launch(text) | refused(text)

state {
  effort: text
  turns: text
  finish: text
  idle: text
}

on launch(flags: text) -> outcome {
  let model_id = json_escape(before(after(flags, "\n--model\n"), "\n"))
  let instruction = json_escape(before(after(flags, "\n--instruction\n"), "\n"))
  let cwd = json_escape(before(after(flags, "\n--cwd\n"), "\n"))
  let named = json_escape(before(after(flags, "\n--harness\n"), "\n"))
  let requested = json_escape(before(after(flags, "\n--effort\n"), "\n"))
  let rounds = json_escape(before(after(flags, "\n--max-turns\n"), "\n"))
  let warm = json_escape(before(after(flags, "\n--keep-warm\n"), "\n"))
  let checks = json_escape(before(after(flags, "\n--finish-checks\n"), "\n"))
  let reviewer = json_escape(before(after(flags, "\n--reviewer-relay\n"), "\n"))
  let escalate = json_escape(before(after(flags, "\n--escalate-model\n"), "\n"))
  if instruction == "" {
    return refused("--instruction is required")
  }
  if model_id == "" {
    return refused("--model is required")
  }
  if cwd == "" {
    return refused("--cwd is required")
  }
  let claude_model = contains(model_id, "claude") and before(model_id, "claude") == ""
  let claude = named == "claude" or (named == "" and claude_model)
  let codex = named == "codex" or (named == "" and not claude_model)
  if not claude and not codex {
    return refused("--harness " ++ named ++ " is not claude or codex")
  }
  effort = requested
  if requested == "" {
    effort = "default"
  }
  turns = rounds
  if rounds == "" {
    turns = "4294967295"
  }
  let claude_policy = "\"texts\":{\"write_updated\":\"The file {path} has been updated successfully. (file state is current in your context — no need to Read it back)\",\"write_created\":\"File created successfully at: {path} (file state is current in your context — no need to Read it back)\",\"edit_updated\":\"The file {path} has been updated successfully.\",\"edit_replaced_all\":\"The file {path} has been updated. All occurrences were successfully replaced.\",\"bash_background\":\"Command running in background\",\"bash_moved\":\"Command did not complete within its {seconds}s timeout and was moved to the background\",\"job_started\":\"{message} (ID: {key}). You will be notified when it completes.\",\"job_started_unheld\":\"{message} with ID: {key}. If it exits while you are still working you will be notified, but it is terminated when you give your final response and no notification can follow that — so do not end your turn to wait for it; if you need its result, wait for it before giving your final response.\",\"job_lost\":\"<task-notification>\\n<task-id>{key}</task-id>\\n<status>failed</status>\\n<summary>Background command \\\"{command}\\\" lost its output: {error}</summary>\\n</task-notification>\",\"job_stalled\":\"<task-notification>\\n<task-id>{key}</task-id>\\n<summary>Background command \\\"{command}\\\" appears to be waiting for interactive input</summary>\\n</task-notification>\\nLast output:\\n{tail}\\n\\nThe command is likely blocked on an interactive prompt. Stop this task and re-run with piped input (e.g., `echo y | command`) or a non-interactive flag if one exists.\",\"tool_error\":\"<tool_use_error>{error}</tool_use_error>\",\"path_empty\":\"file path is empty\",\"file_missing\":\"File does not exist. Note: your current working directory is {cwd}.\",\"file_similar\":\" Did you mean {path}?\",\"read_directory\":\"EISDIR: illegal operation on a directory, read '{path}'\",\"read_not_file\":\"path is not a regular file\",\"read_media\":\"this harness reads text only and cannot return {extension} files as images or documents\",\"read_pages\":\"pages is only applicable to PDF files\",\"read_binary\":\"This tool cannot read binary files. The file appears to be a binary {extension} file. Use a skill for this file type if one is available, or a shell command or script that can read the format.\",\"read_allow_large\":\" allow_large is not available where this read runs; read it in parts with offset and limit.\",\"read_too_big\":\"File content ({size}) exceeds maximum allowed size ({max}). Use offset and limit parameters to read specific portions of the file, or search for specific content instead of reading the whole file.{hint}\",\"read_range_too_big\":\"The requested line range contains over {max} of text, more than a read can return. Use a smaller limit — or, if a single line is this large, no limit will fit it: search for specific content instead.{hint}\",\"read_too_many_tokens\":\"File content ({tokens} tokens) exceeds maximum allowed tokens ({max}). Use offset and limit parameters to read specific portions of the file, or search for specific content instead of reading the whole file.{hint}\",\"read_page\":\"[Truncated: PARTIAL view — {path}: showing lines 1-{count} of {total} total ({tokens} tokens, cap {max}). Call Read with offset={next} limit={count} for the next page, or Grep to find a specific section.{hint} Do NOT answer from this page alone if the answer may be further in the file.]\",\"read_banner\":\"\\n<system-reminder>{banner}</system-reminder>\",\"read_empty\":\"<system-reminder>Warning: the file exists but the contents are empty.</system-reminder>\",\"read_short\":\"<system-reminder>Warning: the file exists but is shorter than the provided offset ({first}). The file has {total} lines.</system-reminder>\",\"image_too_large\":\"image content omitted because it exceeded the supported size limit; use a smaller image\",\"image_unprocessable\":\"image content omitted because it could not be processed\",\"write_directory\":\"target is not a regular file\",\"write_no_parent\":\"file has no parent\",\"write_no_name\":\"file has no name\",\"edit_directory\":\"Error calling tool (Edit): EISDIR: illegal operation on a directory, read\",\"edit_exists\":\"Cannot create new file - file already exists.\",\"edit_same\":\"No changes to make: old_string and new_string are exactly the same.\",\"edit_missing\":\"String to replace not found in file.\\nString: {old}\",\"edit_many\":\"Found {count} matches of the string to replace, but replace_all is false. To replace all occurrences, set replace_all to true. To replace only one occurrence, please provide more context to uniquely identify the instance.\\nString: {old}\",\"bash_sandbox\":\"this host does not authorize disabling the sandbox\",\"bash_jobs_full\":\"no background job can start now: the session keeps its limit of background jobs running\",\"bash_command_size\":\"command must be nonblank and at most {bytes} bytes\",\"bash_description_size\":\"description exceeds {bytes} bytes\",\"bash_timeout_zero\":\"timeout must be at least 1 millisecond\",\"spawn_full\":\"{max} subagents are already running; wait for one before starting another\",\"agent_id_bad\":\"{key} is not an agent ID that a spawn returned\",\"agent_missing\":\"no subagent has the ID {key}\",\"submit_no_output\":\"submit_result needs output, a string\"},\"numbers\":{\"stall_silence_ms\":45000,\"stall_tail_bytes\":1024},\"lists\":{\"prompt_phrases\":[\"do you\",\"would you\",\"shall i\",\"are you sure\",\"ready to\"],\"prompt_patterns\":[\"(y/n)\",\"[y/n]\",\"(yes/no)\",\"press any key\",\"press enter\",\"continue?\",\"overwrite?\"],\"receipted_tools\":[\"Bash\",\"Write\"],\"cancellable_tools\":[],\"list_tools\":[\"list_agents\"],\"submit_tools\":[\"submit_result\"]}"
  let codex_policy = "\"texts\":{\"exec_stdin_closed\":\"stdin is closed for this session; rerun exec_command with tty=true to keep stdin open\",\"exec_aborted\":\"aborted by user after {seconds}s\",\"exec_no_command\":\"missing command line for unified exec request\",\"exec_spawn_failed\":\"Failed to create unified exec process: {error}\",\"exec_failed\":\"Unified exec process failed: {error}\",\"exec_unknown\":\"Unknown process id {id}\",\"exec_stdin_failed\":\"failed to write to stdin\",\"image_no_path\":\"view_image needs the path of an image file\",\"image_unreadable\":\"unable to read image at {path}: {error}\",\"image_kind\":\"{path} is not a PNG, JPEG, GIF or WebP image; convert or render it to PNG first\",\"image_size\":\"{path} is {bytes} bytes, more than the {max} an image may have; scale it down or crop it first\",\"patch_hunk\":\"Invalid patch hunk on line {line}: {message}\",\"patch_first\":\"Invalid patch: The first line of the patch must be '*** Begin Patch'\",\"patch_last\":\"Invalid patch: The last line of the patch must be '*** End Patch'\",\"patch_line\":\"Unexpected line found in update hunk: '{text}'. Every line should start with ' ' (context line), '+' (added line), or '-' (removed line)\",\"patch_empty\":\"Update file hunk for path '{path}' is empty\",\"patch_header\":\"'{line}' is not a valid hunk header. Valid hunk headers: '*** Add File: {path}', '*** Delete File: {path}', '*** Update File: {path}'\",\"patch_context\":\"Failed to find context '{context}' in {path}\",\"patch_lines\":\"Failed to find expected lines in {path}:\\n{lines}\",\"patch_mkdir_failed\":\"Failed to create parent directories for {path}: {error}\",\"patch_write_failed\":\"Failed to write file {path}: {error}\",\"patch_unverified\":\"apply_patch verification failed: {error}\",\"patch_none\":\"No files were modified.\",\"patch_no_file\":\"Failed to read {path}: No such file or directory\",\"patch_unreadable\":\"Failed to read file to update {path}: {error}\",\"patch_delete_failed\":\"Failed to delete file {path}: {error}\",\"patch_remove_failed\":\"Failed to remove original {path}: {error}\",\"patch_done\":\"Exit code: 0\\nWall time: 0 seconds\\nOutput:\\nSuccess. Updated the following files:\\n{summary}\",\"patch_begin\":\"*** Begin Patch\",\"patch_end\":\"*** End Patch\",\"patch_add\":\"*** Add File: \",\"patch_delete\":\"*** Delete File: \",\"patch_update\":\"*** Update File: \",\"patch_move\":\"*** Move to: \",\"patch_eof\":\"*** End of File\",\"patch_marker\":\"*** \",\"patch_change\":\"@@ \",\"patch_change_empty\":\"@@\",\"patch_heredoc_end\":\"EOF\"},\"numbers\":{\"exec_yield_min_ms\":250,\"exec_yield_max_ms\":30000,\"poll_yield_min_ms\":5000,\"poll_yield_max_ms\":300000,\"patch_heredoc_lines_min\":4},\"lists\":{\"receipted_tools\":[\"exec_command\",\"apply_patch\"],\"cancellable_tools\":[\"exec_command\",\"write_stdin\"],\"list_tools\":[],\"submit_tools\":[],\"patch_heredocs\":[\"<<EOF\",\"<<'EOF'\",\"<<\\\"EOF\\\"\"]}"
  let read = "[\"--instruction\",\"--model\",\"--cwd\",\"--harness\",\"--effort\",\"--max-turns\",\"--keep-warm\",\"--finish-checks\",\"--reviewer-relay\",\"--escalate-model\"]"
  let prompt = "{\"handler\":\"prompt\",\"args\":{\"input\":{\"$file\":\"" ++ instruction ++ "\"},\"rounds\":{\"$number\":\"" ++ turns ++ "\"}},\"refused\":\"\"}"
  let head = "{\"model\":\"" ++ model_id ++ "\",\"print\":\"text\",\"flags\":" ++ read ++ ","
  if claude {
    if contains(flags, "\n--reviewer-relay\n") or contains(flags, "\n--finish-checks\n") or contains(flags, "\n--escalate-model\n") {
      return refused("--reviewer-relay, --finish-checks and --escalate-model are for the Codex harness")
    }
    let configure = "{\"handler\":\"configure\",\"args\":{\"cwd\":\"" ++ cwd ++ "\",\"model_name\":\"" ++ model_id ++ "\",\"requested_effort\":\"" ++ effort ++ "\"},\"refused\":\"claude_code refused the configure arguments: check --model and --effort\"}"
    idle = ""
    if warm != "" and warm != "0" {
      idle = ",\"idle\":{\"handler\":\"refresh\",\"turns\":{\"$number\":\"" ++ warm ++ "\"}}"
    }
    return launch(head ++ "\"program\":\"claude_code\",\"spawns\":[{\"tool\":\"spawn_agent\",\"program\":\"claude_code_child\",\"handler\":\"delegated\"}],\"steps\":[" ++ configure ++ "," ++ prompt ++ "]," ++ claude_policy ++ idle ++ "}")
  }
  if warm != "" and warm != "0" {
    return refused("--keep-warm is for the Claude harness")
  }
  finish = checks
  if checks == "" {
    finish = "2"
  }
  let configure = "{\"handler\":\"configure\",\"args\":{\"cwd\":\"" ++ cwd ++ "\",\"escalate_model\":\"" ++ escalate ++ "\",\"finish_checks\":\"" ++ finish ++ "\",\"model_name\":\"" ++ model_id ++ "\",\"requested_effort\":\"" ++ effort ++ "\",\"reviewer\":\"" ++ reviewer ++ "\"},\"refused\":\"codex_agent refused the configure arguments: check --model, --effort and --finish-checks\"}"
  return launch(head ++ "\"program\":\"codex_agent\",\"spawns\":[],\"steps\":[" ++ configure ++ "," ++ prompt ++ "]," ++ codex_policy ++ "}")
}
