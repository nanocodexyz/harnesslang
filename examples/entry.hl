harness entry

type outcome = launch(text) | refused(text)

state {
  effort: text
  turns: text
  finish: text
  idle: text
}

on launch(flags: text) -> outcome {
  if contains(flags, "\"") or contains(flags, "\\") {
    return refused("a flag value holds a quote or a backslash, which the launch manifest cannot carry")
  }
  let model_id = before(after(flags, "\n--model\n"), "\n")
  let instruction = before(after(flags, "\n--instruction\n"), "\n")
  let cwd = before(after(flags, "\n--cwd\n"), "\n")
  let named = before(after(flags, "\n--harness\n"), "\n")
  let requested = before(after(flags, "\n--effort\n"), "\n")
  let rounds = before(after(flags, "\n--max-turns\n"), "\n")
  let warm = before(after(flags, "\n--keep-warm\n"), "\n")
  let checks = before(after(flags, "\n--finish-checks\n"), "\n")
  let reviewer = before(after(flags, "\n--reviewer-relay\n"), "\n")
  let escalate = before(after(flags, "\n--escalate-model\n"), "\n")
  if instruction == "" {
    return refused("--instruction is required")
  }
  if model_id == "" {
    return refused("--model is required")
  }
  if cwd == "" {
    return refused("--cwd is required")
  }
  let claude_model = contains(model_id, "claude") and before(model_id, "claude") == ""
  let claude = named == "claude" or (named == "" and claude_model)
  let codex = named == "codex" or (named == "" and not claude_model)
  if not claude and not codex {
    return refused("--harness " ++ named ++ " is not claude or codex")
  }
  effort = requested
  if requested == "" {
    effort = "default"
  }
  turns = rounds
  if rounds == "" {
    turns = "4294967295"
  }
  let claude_policy = "\"texts\":{\"write_updated\":\"The file {path} has been updated successfully. (file state is current in your context — no need to Read it back)\",\"write_created\":\"File created successfully at: {path} (file state is current in your context — no need to Read it back)\",\"edit_updated\":\"The file {path} has been updated successfully.\",\"edit_replaced_all\":\"The file {path} has been updated. All occurrences were successfully replaced.\",\"bash_background\":\"Command running in background\",\"bash_moved\":\"Command did not complete within its {seconds}s timeout and was moved to the background\",\"job_started\":\"{message} (ID: {key}). You will be notified when it completes.\",\"job_started_unheld\":\"{message} with ID: {key}. If it exits while you are still working you will be notified, but it is terminated when you give your final response and no notification can follow that — so do not end your turn to wait for it; if you need its result, wait for it before giving your final response.\",\"job_completed\":\"<task-notification>\\n<task-id>{key}</task-id>\\n<status>completed</status>\\n<summary>Background command \\\"{command}\\\" completed</summary>\\n</task-notification>\\n{output}\",\"job_failed\":\"<task-notification>\\n<task-id>{key}</task-id>\\n<status>failed</status>\\n<summary>Background command \\\"{command}\\\" failed with exit code {code}</summary>\\n</task-notification>\\n{output}\",\"job_lost\":\"<task-notification>\\n<task-id>{key}</task-id>\\n<status>failed</status>\\n<summary>Background command \\\"{command}\\\" lost its output: {error}</summary>\\n</task-notification>\",\"job_stalled\":\"<task-notification>\\n<task-id>{key}</task-id>\\n<summary>Background command \\\"{command}\\\" appears to be waiting for interactive input</summary>\\n</task-notification>\\nLast output:\\n{tail}\\n\\nThe command is likely blocked on an interactive prompt. Stop this task and re-run with piped input (e.g., `echo y | command`) or a non-interactive flag if one exists.\"},\"numbers\":{\"stall_silence_ms\":45000,\"stall_tail_bytes\":1024},\"lists\":{\"prompt_phrases\":[\"do you\",\"would you\",\"shall i\",\"are you sure\",\"ready to\"],\"prompt_patterns\":[\"(y/n)\",\"[y/n]\",\"(yes/no)\",\"press any key\",\"press enter\",\"continue?\",\"overwrite?\"]}"
  let codex_policy = "\"texts\":{\"exec_cut\":\"…{tokens} tokens truncated…\",\"exec_wall\":\"Wall time: {seconds} seconds\",\"exec_exited\":\"Process exited with code {code}\",\"exec_running\":\"Process running with session ID {id}\",\"exec_original\":\"Original token count: {tokens}\",\"exec_output\":\"Output:\",\"exec_stdin_closed\":\"stdin is closed for this session; rerun exec_command with tty=true to keep stdin open\"},\"numbers\":{\"bytes_per_token\":4,\"exec_yield_min_ms\":250,\"exec_yield_max_ms\":30000,\"poll_yield_min_ms\":5000,\"poll_yield_max_ms\":300000}"
  let read = "[\"--instruction\",\"--model\",\"--cwd\",\"--harness\",\"--effort\",\"--max-turns\",\"--keep-warm\",\"--finish-checks\",\"--reviewer-relay\",\"--escalate-model\"]"
  let prompt = "{\"handler\":\"prompt\",\"args\":{\"input\":{\"$file\":\"" ++ instruction ++ "\"},\"rounds\":{\"$number\":\"" ++ turns ++ "\"}},\"refused\":\"\"}"
  let head = "{\"model\":\"" ++ model_id ++ "\",\"print\":\"text\",\"flags\":" ++ read ++ ","
  if claude {
    if contains(flags, "\n--reviewer-relay\n") or contains(flags, "\n--finish-checks\n") or contains(flags, "\n--escalate-model\n") {
      return refused("--reviewer-relay, --finish-checks and --escalate-model are for the Codex harness")
    }
    let configure = "{\"handler\":\"configure\",\"args\":{\"cwd\":\"" ++ cwd ++ "\",\"model_name\":\"" ++ model_id ++ "\",\"requested_effort\":\"" ++ effort ++ "\"},\"refused\":\"claude_code refused the configure arguments: check --model and --effort\"}"
    idle = ""
    if warm != "" and warm != "0" {
      idle = ",\"idle\":{\"handler\":\"refresh\",\"turns\":{\"$number\":\"" ++ warm ++ "\"}}"
    }
    return launch(head ++ "\"program\":\"claude_code\",\"spawns\":[{\"tool\":\"spawn_agent\",\"program\":\"claude_code_child\",\"handler\":\"delegated\"}],\"steps\":[" ++ configure ++ "," ++ prompt ++ "]," ++ claude_policy ++ idle ++ "}")
  }
  if warm != "" and warm != "0" {
    return refused("--keep-warm is for the Claude harness")
  }
  finish = checks
  if checks == "" {
    finish = "2"
  }
  let configure = "{\"handler\":\"configure\",\"args\":{\"cwd\":\"" ++ cwd ++ "\",\"escalate_model\":\"" ++ escalate ++ "\",\"finish_checks\":\"" ++ finish ++ "\",\"model_name\":\"" ++ model_id ++ "\",\"requested_effort\":\"" ++ effort ++ "\",\"reviewer\":\"" ++ reviewer ++ "\"},\"refused\":\"codex_agent refused the configure arguments: check --model, --effort and --finish-checks\"}"
  return launch(head ++ "\"program\":\"codex_agent\",\"spawns\":[],\"steps\":[" ++ configure ++ "," ++ prompt ++ "]," ++ codex_policy ++ "}")
}
