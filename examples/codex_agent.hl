harness codex_agent

const rounds_max: u64 = 64
const calls_per_round_max: u64 = 16
const context_entries_max: u64 = 4096
const compact_kept: u64 = 32
const turns_max: u64 = 1000000

type outcome = completed(text) | failed(text) | exhausted

tool shell(command: text) -> text effect external
tool apply_patch(patch: text) -> text effect external
tool update_plan(plan: text) -> text effect none
tool view_image(path: text) -> text effect none
tool web_search(query: text) -> text effect none
tool steer_waiting() -> bool effect none
tool steer_take() -> text effect none

model responses calls calls_per_round_max

state {
  context: list<entry, context_entries_max>
  turns: u64
}

invariant turns_bounded: turns <= turns_max
invariant context_room: len(context) < context_entries_max

on prompt(input: text) -> outcome
  requires turns < turns_max
{
  push context user(input)
  turns = turns + 1
  loop round below rounds_max {
    if len(context) + 1 + (1 + calls_per_round_max) > context_entries_max {
      keep context last context_entries_max - 2
      push context user("Summarize the conversation so far for a fresh start: the task, what was done, what is left.")
      let summary = responses(context)
      keep context last compact_kept
      match summary {
        answer(_) => { push context assistant(summary) }
        calls(_) => { return failed("compaction answered with tool calls") }
      }
    }
    let reply = responses(context)
    push context assistant(reply)
    match reply {
      answer(words) => {
        match steer_waiting() {
          ok(waiting) => {
            if not waiting { return completed(words) }
            match steer_take() {
              ok(steer) => { push context user(steer) }
              failed(error) => { return failed("steer take failed: " ++ error) }
            }
          }
          failed(error) => { return failed("steer poll failed: " ++ error) }
        }
      }
      calls(requested) => {
        for call in requested {
          match dispatch(call) {
            ok(output) => { push context result(call, output) }
            failed(error) => { push context error(call, error) }
            unknown => { push context unknown(call) }
          }
        }
      }
    }
  }
  return exhausted
}
