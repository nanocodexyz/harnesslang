(global $LISTING_SLOT_BYTES i32 (i32.const 16))
(global $SEARCH_SEPARATOR i32 (i32.const 10))
(global $listing_state (mut i32) (i32.const 0))
(global $listed_bare (mut i32) (i32.const 0))
(global $gate_admitted (mut i32) (i32.const 0))
(text $s_listing "listing")
(text $s_event "event")
(text $s_listed_separator "__")
(text $s_listing_open "listing ")
(text $s_listing_returned " returned ")
(text $s_listing_not_fingerprints ", which is not an object of fingerprints")
(text $s_listing_tools " tools, over its bound ")
(text $s_listing_object "a listing is an object, found ")
(text $s_listing_fingerprint "a listed tool's fingerprint is not text")
(text $s_listing_output "a listing answer holds its output")
(text $s_listing_changed_open "tools of listing ")
(text $s_listing_changed " changed: ")
(text $s_listing_added "added ")
(text $s_listing_changed_word "changed ")
(text $s_listing_removed "removed ")
(text $s_semicolon_space "; ")
(text $s_not_admitted " was not admitted: listing ")
(text $s_did_not_list " did not list ")
(text $s_in_this_turn " in this turn")
(text $s_did_not_list_turn " did not list in this turn")
(text $s_not_discovered " was not discovered: no search of listing ")
(text $s_found_it " found it in this turn")
(text $s_found_open " found ")
(text $s_found_tools " tools, over listing ")
(text $s_found_bound "'s bound ")
(text $s_found_which ", which listing ")
(func $listings_count (result i32) (i32.load (i32.const $listings)))
(func $listing_slot (param $listing i32) (result i32)
  (i32.add (global.get $listing_state) (i32.shl (i32.load offset=32 (local.get $listing)) (global.get $NIBBLE_BITS))))
(func $listings_reset (local $bytes i32)
  (local.set $bytes (i32.mul (i32.add (call $listings_count) (i32.const 1)) (global.get $LISTING_SLOT_BYTES)))
  (global.set $listing_state (call $alloc (local.get $bytes)))
  (memory.fill (global.get $listing_state) (i32.const 0) (local.get $bytes)))
(func $listed (param $name i32) (result i32) (local $at i32) (local $index i32) (local $listing i32) (local $prefix i32)
  (local.set $at (call $text_find (local.get $name) (i32.const $s_listed_separator)))
  (if (i32.lt_s (local.get $at) (i32.const 0)) (then (return (i32.const 0))))
  (if (i32.eq (i32.add (local.get $at) (call $text_len (i32.const $s_listed_separator))) (call $text_len (local.get $name))) (then (return (i32.const 0))))
  (local.set $prefix (call $text_slice (local.get $name) (i32.const 0) (local.get $at)))
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $listings_count)))
      (local.set $listing (i32.load (i32.add (i32.load offset=4 (i32.const $listings)) (i32.shl (local.get $index) (i32.const 2)))))
      (if (call $text_eq (i32.load (local.get $listing)) (local.get $prefix))
        (then
          (global.set $listed_bare (call $text_slice (local.get $name) (i32.add (local.get $at) (call $text_len (i32.const $s_listed_separator))) (call $text_len (local.get $name))))
          (return (local.get $listing))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $input_tool (param $name i32) (result i32) (local $tool i32)
  (local.set $tool (call $program_tool (local.get $name)))
  (if (local.get $tool) (then (return (local.get $tool))))
  (local.set $tool (call $waits_tool (local.get $name)))
  (if (local.get $tool) (then (return (local.get $tool))))
  (call $listed (local.get $name)))
(func $listing_failed (param $listing i32) (param $middle i32) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_listing_open))
  (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
  (call $buf_text (local.get $buffer) (i32.const $s_listing_returned))
  (call $buf_text (local.get $buffer) (local.get $middle))
  (call $output_new (global.get $OUTPUT_FAILED) (call $buf_finish (local.get $buffer))))
(func $checked_listing (param $listing i32) (param $output i32) (result i32) (local $node i32) (local $index i32) (local $count i32) (local $buffer i32)
  (if (i32.ne (call $output_kind (local.get $output)) (global.get $OUTPUT_OK)) (then (return (local.get $output))))
  (local.set $node (call $output_payload (local.get $output)))
  (block $fits
    (if (i32.ne (call $json_tag (local.get $node)) (global.get $JSON_OBJECT))
      (then (return (call $listing_failed (local.get $listing) (call $text_concat (call $json_encode (local.get $node)) (i32.const $s_listing_not_fingerprints))))))
    (local.set $count (call $json_count (local.get $node)))
    loop $next
      (br_if $fits (i32.ge_u (local.get $index) (local.get $count)))
      (if (i32.or (i32.eqz (call $text_len (call $json_key (local.get $node) (local.get $index))))
            (i32.ne (call $json_tag (call $json_value (local.get $node) (local.get $index))) (global.get $JSON_STRING)))
        (then (return (call $listing_failed (local.get $listing) (call $text_concat (call $json_encode (local.get $node)) (i32.const $s_listing_not_fingerprints))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end)
  (if (i32.gt_u (local.get $count) (i32.load offset=20 (local.get $listing)))
    (then
      (local.set $buffer (call $buf_new))
      (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (local.get $count)))
      (call $buf_text (local.get $buffer) (i32.const $s_listing_tools))
      (call $buf_text (local.get $buffer) (i32.load offset=24 (local.get $listing)))
      (call $buf_text (local.get $buffer) (i32.const $s_space_paren))
      (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (i32.load offset=20 (local.get $listing))))
      (call $buf_text (local.get $buffer) (i32.const $s_close_paren))
      (return (call $listing_failed (local.get $listing) (call $buf_finish (local.get $buffer))))))
  (local.get $output))
(func $listing_run (param $site i32) (param $seq i64) (result i32) (local $listing i32) (local $request i32) (local $answer i32) (local $output i32)
  (local.set $listing (i32.load offset=16 (local.get $site)))
  (local.set $request (call $json_object (i32.const 4)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $s_event) (call $json_string (i32.const $s_listing)))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $s_listing) (call $json_string (i32.load (local.get $listing))))
  (call $json_object_set (local.get $request) (i32.const 2) (i32.const $s_seq) (call $json_number (local.get $seq)))
  (call $json_object_set (local.get $request) (i32.const 3) (i32.const $s_turn) (call $json_number (global.get $turn)))
  (local.set $answer (call $json_get (call $world (local.get $request)) (i32.const $s_output)))
  (call $assert (i32.ne (local.get $answer) (i32.const 0)) (i32.const $s_listing_output))
  (local.set $output (call $output_from_json (local.get $answer)))
  (call $assert (i32.ne (local.get $output) (i32.const 0)) (i32.const $s_not_output))
  (call $checked_listing (local.get $listing) (local.get $output)))
(func $buf_listed_names (param $buffer i32) (param $what i32) (param $listing i32) (param $names i32) (param $first i32) (result i32) (local $index i32)
  (if (i32.eqz (call $vec_count (local.get $names))) (then (return (local.get $first))))
  (if (i32.eqz (local.get $first)) (then (call $buf_text (local.get $buffer) (i32.const $s_semicolon_space))))
  (call $buf_text (local.get $buffer) (local.get $what))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $names))))
      (if (local.get $index) (then (call $buf_text (local.get $buffer) (i32.const $s_comma_space))))
      (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
      (call $buf_text (local.get $buffer) (i32.const $s_listed_separator))
      (call $buf_text (local.get $buffer) (i32.load (call $vec_at (local.get $names) (local.get $index))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $listing_notice (param $listing i32) (param $before i32) (param $after i32) (result i32) (local $added i32) (local $changed i32) (local $removed i32) (local $index i32) (local $key i32) (local $old i32) (local $buffer i32) (local $first i32)
  (local.set $added (call $vec_new (i32.const 4)))
  (local.set $changed (call $vec_new (i32.const 4)))
  (local.set $removed (call $vec_new (i32.const 4)))
  block $after_done
    loop $after_keys
      (br_if $after_done (i32.ge_u (local.get $index) (call $json_count (local.get $after))))
      (local.set $key (call $json_key (local.get $after) (local.get $index)))
      (local.set $old (call $json_get (local.get $before) (local.get $key)))
      (if (i32.eqz (local.get $old))
        (then (i32.store (call $vec_push (local.get $added)) (local.get $key)))
        (else
          (if (i32.eqz (call $json_equal (local.get $old) (call $json_value (local.get $after) (local.get $index))))
            (then (i32.store (call $vec_push (local.get $changed)) (local.get $key))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $after_keys
    end
  end
  (local.set $index (i32.const 0))
  block $before_done
    loop $before_keys
      (br_if $before_done (i32.ge_u (local.get $index) (call $json_count (local.get $before))))
      (local.set $key (call $json_key (local.get $before) (local.get $index)))
      (if (i32.eqz (call $json_get (local.get $after) (local.get $key)))
        (then (i32.store (call $vec_push (local.get $removed)) (local.get $key))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $before_keys
    end
  end
  (if (i32.eqz (i32.add (call $vec_count (local.get $added)) (i32.add (call $vec_count (local.get $changed)) (call $vec_count (local.get $removed)))))
    (then (return (i32.const 0))))
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_listing_changed_open))
  (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
  (call $buf_text (local.get $buffer) (i32.const $s_listing_changed))
  (local.set $first (call $buf_listed_names (local.get $buffer) (i32.const $s_listing_added) (local.get $listing) (local.get $added) (i32.const 1)))
  (local.set $first (call $buf_listed_names (local.get $buffer) (i32.const $s_listing_changed_word) (local.get $listing) (local.get $changed) (local.get $first)))
  (drop (call $buf_listed_names (local.get $buffer) (i32.const $s_listing_removed) (local.get $listing) (local.get $removed) (local.get $first)))
  (call $buf_finish (local.get $buffer)))
(func $admit_listing (param $site i32) (param $output i32) (result i32) (local $listing i32) (local $slot i32) (local $node i32) (local $index i32)
  (if (i32.ne (call $site_kind (local.get $site)) (global.get $KIND_LISTING)) (then (return (i32.const 1))))
  (local.set $listing (i32.load offset=16 (local.get $site)))
  (local.set $slot (call $listing_slot (local.get $listing)))
  (if (i32.ne (call $output_kind (local.get $output)) (global.get $OUTPUT_OK))
    (then
      (i32.store offset=8 (local.get $slot) (i32.const 0))
      (i32.store (local.get $slot) (i32.const 0))
      (return (i32.const 1))))
  (local.set $node (call $output_payload (local.get $output)))
  (if (i32.ne (call $json_tag (local.get $node)) (global.get $JSON_OBJECT))
    (then (call $result_corrupt (call $text_concat (i32.const $s_listing_object) (call $json_encode (local.get $node)))) (return (i32.const 0))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $json_count (local.get $node))))
      (if (i32.ne (call $json_tag (call $json_value (local.get $node) (local.get $index))) (global.get $JSON_STRING))
        (then (call $result_corrupt (i32.const $s_listing_fingerprint)) (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.store offset=8 (local.get $slot)
    (select (call $listing_notice (local.get $listing) (i32.load offset=4 (local.get $slot)) (local.get $node)) (i32.const 0) (i32.ne (i32.load offset=4 (local.get $slot)) (i32.const 0))))
  (i32.store offset=4 (local.get $slot) (local.get $node))
  (i32.store (local.get $slot) (local.get $node))
  (i32.const 1))
(func $listing_notice_value (param $listing i32) (result i64) (local $notice i32)
  (local.set $notice (i32.load offset=8 (call $listing_slot (local.get $listing))))
  (if (i32.eqz (local.get $notice)) (then (return (call $text_value (i32.const $s_empty)))))
  (call $text_value (local.get $notice)))
(func $discovered_has (param $listing i32) (param $name i32) (result i32) (local $found i32) (local $index i32)
  (local.set $found (i32.load offset=12 (call $listing_slot (local.get $listing))))
  (if (i32.eqz (local.get $found)) (then (return (i32.const 0))))
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $vec_count (local.get $found))))
      (if (call $text_eq (i32.load (call $vec_at (local.get $found) (local.get $index))) (local.get $name)) (then (return (i32.const 1))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $discover_one (param $listing i32) (param $name i32) (local $slot i32)
  (if (call $discovered_has (local.get $listing) (local.get $name)) (then (return)))
  (local.set $slot (call $listing_slot (local.get $listing)))
  (if (i32.eqz (i32.load offset=12 (local.get $slot))) (then (i32.store offset=12 (local.get $slot) (call $vec_new (i32.const 4)))))
  (i32.store (call $vec_push (i32.load offset=12 (local.get $slot))) (local.get $name)))
(func $found_names (param $text i32) (result i32) (local $names i32) (local $from i32) (local $at i32) (local $length i32)
  (local.set $names (call $vec_new (i32.const 4)))
  (local.set $length (call $text_len (local.get $text)))
  block $done
    loop $next
      (br_if $done (i32.gt_u (local.get $at) (local.get $length)))
      (if (i32.or (i32.eq (local.get $at) (local.get $length)) (i32.eq (call $text_byte (local.get $text) (local.get $at)) (global.get $SEARCH_SEPARATOR)))
        (then
          (if (i32.gt_u (local.get $at) (local.get $from))
            (then (i32.store (call $vec_push (local.get $names)) (call $text_slice (local.get $text) (local.get $from) (local.get $at)))))
          (local.set $from (i32.add (local.get $at) (i32.const 1)))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (local.get $names))
(func $discover (param $call i32) (param $output i32) (local $listing i32) (local $names i32) (local $index i32)
  (local.set $listing (call $tool_finds (call $call_tool (local.get $call))))
  (if (i32.eqz (local.get $listing)) (then (return)))
  (if (i32.ne (call $output_kind (local.get $output)) (global.get $OUTPUT_OK)) (then (return)))
  (if (i32.ne (call $json_tag (call $output_payload (local.get $output))) (global.get $JSON_STRING)) (then (return)))
  (local.set $names (call $found_names (call $json_text (call $output_payload (local.get $output)))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $names))))
      (if (call $listed (i32.load (call $vec_at (local.get $names) (local.get $index))))
        (then (call $discover_one (local.get $listing) (global.get $listed_bare))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end)
(func $checked_search (param $tool i32) (param $listing i32) (param $output i32) (result i32) (local $names i32) (local $index i32) (local $found i32) (local $admitted i32) (local $buffer i32) (local $ok i32)
  (if (i32.ne (call $output_kind (local.get $output)) (global.get $OUTPUT_OK)) (then (return (local.get $output))))
  (if (i32.ne (call $json_tag (call $output_payload (local.get $output))) (global.get $JSON_STRING)) (then (return (local.get $output))))
  (local.set $names (call $found_names (call $json_text (call $output_payload (local.get $output)))))
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (local.get $tool))
  (call $buf_text (local.get $buffer) (i32.const $s_found_open))
  (if (i32.gt_u (call $vec_count (local.get $names)) (i32.load offset=20 (local.get $listing)))
    (then
      (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (call $vec_count (local.get $names))))
      (call $buf_text (local.get $buffer) (i32.const $s_found_tools))
      (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
      (call $buf_text (local.get $buffer) (i32.const $s_found_bound))
      (call $buf_text (local.get $buffer) (i32.load offset=24 (local.get $listing)))
      (call $buf_text (local.get $buffer) (i32.const $s_space_paren))
      (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (i32.load offset=20 (local.get $listing))))
      (call $buf_text (local.get $buffer) (i32.const $s_close_paren))
      (return (call $output_new (global.get $OUTPUT_FAILED) (call $buf_finish (local.get $buffer))))))
  (local.set $admitted (i32.load (call $listing_slot (local.get $listing))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $names))))
      (local.set $found (i32.load (call $vec_at (local.get $names) (local.get $index))))
      (local.set $ok (i32.eq (call $listed (local.get $found)) (local.get $listing)))
      (if (local.get $ok)
        (then
          (local.set $ok (i32.ne (local.get $admitted) (i32.const 0)))
          (if (local.get $ok) (then (local.set $ok (i32.ne (call $json_get (local.get $admitted) (global.get $listed_bare)) (i32.const 0)))))))
      (if (i32.eqz (local.get $ok))
        (then
          (call $buf_text (local.get $buffer) (local.get $found))
          (call $buf_text (local.get $buffer) (i32.const $s_found_which))
          (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
          (call $buf_text (local.get $buffer) (i32.const $s_did_not_list_turn))
          (return (call $output_new (global.get $OUTPUT_FAILED) (call $buf_finish (local.get $buffer))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $output))
(func $listing_gate (param $name i32) (result i32) (local $listing i32) (local $admitted i32) (local $fingerprint i32) (local $bare i32) (local $buffer i32)
  (local.set $listing (call $listed (local.get $name)))
  (if (i32.eqz (local.get $listing)) (then (return (i32.const 0))))
  (local.set $bare (global.get $listed_bare))
  (local.set $admitted (i32.load (call $listing_slot (local.get $listing))))
  (if (local.get $admitted) (then (local.set $fingerprint (call $json_get (local.get $admitted) (local.get $bare)))))
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (local.get $name))
  (if (i32.eqz (local.get $fingerprint))
    (then
      (call $buf_text (local.get $buffer) (i32.const $s_not_admitted))
      (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
      (call $buf_text (local.get $buffer) (i32.const $s_did_not_list))
      (call $buf_text (local.get $buffer) (local.get $bare))
      (call $buf_text (local.get $buffer) (i32.const $s_in_this_turn))
      (return (call $buf_finish (local.get $buffer)))))
  (if (i32.and (i32.load offset=28 (local.get $listing)) (i32.eqz (call $discovered_has (local.get $listing) (local.get $bare))))
    (then
      (call $buf_text (local.get $buffer) (i32.const $s_not_discovered))
      (call $buf_text (local.get $buffer) (i32.load (local.get $listing)))
      (call $buf_text (local.get $buffer) (i32.const $s_found_it))
      (return (call $buf_finish (local.get $buffer)))))
  (global.set $gate_admitted (call $json_text (local.get $fingerprint)))
  (i32.const 0))
