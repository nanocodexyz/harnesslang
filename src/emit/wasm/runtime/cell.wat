    (then
      (if (i32.and (i32.ne (local.get $found) (i32.const 0)) (i32.eqz (local.get $finished))) (then (call $stop_cell (local.get $cell))))
      (return (call $output_new (global.get $OUTPUT_OK) (call $str (i32.const $k_stopped))))))
  (if (i32.eqz (local.get $found)) (then (return (call $output_new (global.get $OUTPUT_FAILED) (i32.const $k_not_found)))))
  (if (local.get $finished)
    (then
      (if (i32.eqz (local.get $rerun)) (then (return (call $output_new (global.get $OUTPUT_FAILED) (i32.const $k_not_found)))))
      (if (local.get $terminate) (then (return (call $output_new (global.get $OUTPUT_OK) (call $str (i32.const $k_terminated))))))
      (return (call $cell_outcome_output (global.get $OUTCOME_UNKNOWN) (call $divergence_text (call $cell_log_id (local.get $cell)) (i32.const $k_lost_tail))))))
  (if (local.get $terminate)
    (then
      (call $stop_cell (local.get $cell))
      (return (call $output_new (global.get $OUTPUT_OK) (call $str (i32.const $k_terminated))))))
  (call $cell_run (local.get $code) (i64.load (local.get $found)) (local.get $seq) (call $cell_log_script (local.get $cell))
    (local.get $cell) (i64.const 0) (call $header_buffered (call $cell_log_id (local.get $cell)))))
(text $k_terminate "terminate")
