(func $code_yield_ms (result i64) (i64.extend_i32_u (i32.load offset=52 (global.get $c_code))))
(func $code_tool (param $name i32) (result i32) (local $index i32) (local $tool i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (i32.load offset=4 (global.get $c_code))))
      (local.set $tool (i32.load (i32.add (i32.load offset=8 (global.get $c_code)) (i32.shl (local.get $index) (i32.const 2)))))
      (if (call $text_eq (i32.load (local.get $tool)) (local.get $name)) (then (return (local.get $tool))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $cell_steps_max (result i64)
  (i64.add (i64.mul (i64.const 2) (i64.add (i64.div_u (call $code_journal_bytes) (global.get $CELL_ENTRY_OVERHEAD_BYTES)) (i64.const 1))) (i64.const 2)))
(func $entry_kind (param $entry i32) (result i32) (call $field_str (local.get $entry) (i32.const $s_kind)))
(func $entry_is (param $entry i32) (param $kind i32) (result i32) (call $text_eq (call $entry_kind (local.get $entry)) (local.get $kind)))
(func $entry_id (param $entry i32) (result i64) (call $field_u64 (local.get $entry) (i32.const $s_id)))
(func $entry_call (param $id i64) (param $name i32) (param $input i32) (result i32) (local $node i32)
  (local.set $node (call $obj (i32.const 5)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $k_host) (i32.const $json_false))
  (call $json_object_set (local.get $node) (i32.const 1) (i32.const $s_id) (call $num (local.get $id)))
  (call $json_object_set (local.get $node) (i32.const 2) (i32.const $s_input) (local.get $input))
  (call $json_object_set (local.get $node) (i32.const 3) (i32.const $s_kind) (call $str (i32.const $k_kind_call)))
  (call $json_object_set (local.get $node) (i32.const 4) (i32.const $k_name) (call $str (local.get $name)))
  (call $obj_done (local.get $node)))
(func $entry_result (param $id i64) (param $encoded i32) (param $success i32) (result i32)
  (call $obj4 (i32.const $k_encoded) (call $str (local.get $encoded)) (i32.const $s_id) (call $num (local.get $id))
    (i32.const $s_kind) (call $str (i32.const $k_kind_result)) (i32.const $k_success) (call $json_bool (local.get $success))))
(func $entry_timeout (param $id i64) (param $delay i64) (param $at i64) (result i32)
  (call $obj4 (i32.const $k_at_ms) (call $num (local.get $at)) (i32.const $k_delay_ms) (call $num (local.get $delay))
    (i32.const $s_id) (call $num (local.get $id)) (i32.const $s_kind) (call $str (i32.const $k_kind_timeout))))
(func $entry_timer (param $id i64) (result i32)
  (call $obj2 (i32.const $s_id) (call $num (local.get $id)) (i32.const $s_kind) (call $str (i32.const $k_kind_timer))))
(func $entry_value (param $kind i32) (param $value i32) (result i32)
  (call $obj2 (i32.const $s_kind) (call $str (local.get $kind)) (i32.const $s_value) (local.get $value)))
(func $entry_bytes (param $data i32) (result i32)
  (call $obj2 (i32.const $s_data) (local.get $data) (i32.const $s_kind) (call $str (i32.const $k_kind_bytes))))
(func $entry_is_input (param $entry i32) (result i32)
  (i32.or (call $entry_is (local.get $entry) (i32.const $k_kind_result)) (call $entry_is (local.get $entry) (i32.const $k_kind_timer))))
(func $entry_same_step (param $recorded i32) (param $step i32) (result i32) (local $kind i32)
  (local.set $kind (call $entry_kind (local.get $recorded)))
  (if (i32.eqz (call $text_eq (local.get $kind) (call $entry_kind (local.get $step)))) (then (return (i32.const 0))))
  (if (call $text_eq (local.get $kind) (i32.const $k_kind_timeout))
    (then (return (i32.and (i64.eq (call $entry_id (local.get $recorded)) (call $entry_id (local.get $step)))
      (i64.eq (call $field_u64 (local.get $recorded) (i32.const $k_delay_ms)) (call $field_u64 (local.get $step) (i32.const $k_delay_ms)))))))
  (if (i32.or (call $text_eq (local.get $kind) (i32.const $k_kind_clock))
        (i32.or (call $text_eq (local.get $kind) (i32.const $k_kind_monotonic)) (call $text_eq (local.get $kind) (i32.const $k_kind_random))))
    (then (return (i32.const 1))))
  (if (call $text_eq (local.get $kind) (i32.const $k_kind_bytes))
    (then (return (i32.eq (call $json_count (call $json_get (local.get $recorded) (i32.const $s_data))) (call $json_count (call $json_get (local.get $step) (i32.const $s_data)))))))
  (call $json_equal (local.get $recorded) (local.get $step)))
(func $entry_describe (param $entry i32) (result i32) (local $kind i32) (local $buffer i32)
  (local.set $kind (call $entry_kind (local.get $entry)))
  (local.set $buffer (call $buf_new))
  (block $described
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_call))
      (then
        (call $buf_text (local.get $buffer) (i32.const $k_describe_call_open))
        (call $buf_text (local.get $buffer) (call $field_str (local.get $entry) (i32.const $k_name)))
        (call $buf_text (local.get $buffer) (i32.const $k_describe_call_middle))
        (call $buf_u64 (local.get $buffer) (call $entry_id (local.get $entry)))
        (call $buf_text (local.get $buffer) (i32.const $k_close_paren))
        (br $described)))
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_result))
      (then
        (call $buf_text (local.get $buffer) (i32.const $k_describe_result))
        (call $buf_u64 (local.get $buffer) (call $entry_id (local.get $entry)))
        (br $described)))
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_timeout))
      (then
        (call $buf_text (local.get $buffer) (i32.const $k_describe_timer_open))
        (call $buf_u64 (local.get $buffer) (call $entry_id (local.get $entry)))
        (call $buf_text (local.get $buffer) (i32.const $k_describe_timeout_middle))
        (call $buf_u64 (local.get $buffer) (call $field_u64 (local.get $entry) (i32.const $k_delay_ms)))
        (call $buf_text (local.get $buffer) (i32.const $k_describe_timeout_close))
        (br $described)))
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_timer))
      (then
        (call $buf_text (local.get $buffer) (i32.const $k_describe_timer_open))
        (call $buf_u64 (local.get $buffer) (call $entry_id (local.get $entry)))
        (call $buf_text (local.get $buffer) (i32.const $k_describe_firing))
        (br $described)))
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_clock))
      (then (call $buf_text (local.get $buffer) (i32.const $k_describe_clock)) (br $described)))
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_monotonic))
      (then (call $buf_text (local.get $buffer) (i32.const $k_describe_monotonic)) (br $described)))
    (if (call $text_eq (local.get $kind) (i32.const $k_kind_random))
      (then (call $buf_text (local.get $buffer) (i32.const $k_describe_random)) (br $described)))
    (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (call $json_count (call $json_get (local.get $entry) (i32.const $s_data)))))
    (call $buf_text (local.get $buffer) (i32.const $k_describe_bytes)))
