(func $obj4 (param $k1 i32) (param $v1 i32) (param $k2 i32) (param $v2 i32) (param $k3 i32) (param $v3 i32) (param $k4 i32) (param $v4 i32) (result i32) (local $node i32)
  (local.set $node (call $obj (i32.const 4)))
  (call $json_object_set (local.get $node) (i32.const 0) (local.get $k1) (local.get $v1))
  (call $json_object_set (local.get $node) (i32.const 1) (local.get $k2) (local.get $v2))
  (call $json_object_set (local.get $node) (i32.const 2) (local.get $k3) (local.get $v3))
  (call $json_object_set (local.get $node) (i32.const 3) (local.get $k4) (local.get $v4))
  (call $obj_done (local.get $node)))
(func $num (param $value i64) (result i32) (call $json_number (local.get $value)))
