(func $text_num (param $open i32) (param $value i64) (param $close i32) (result i32)
  (call $wrapped (local.get $open) (call $u64_text (local.get $value)) (local.get $close)))
(func $bound_text (param $open i32) (param $name i32) (param $value i32) (param $close i32) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (local.get $open))
  (call $buf_text (local.get $buffer) (local.get $name))
  (call $buf_text (local.get $buffer) (i32.const $k_equals))
  (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (local.get $value)))
  (call $buf_text (local.get $buffer) (local.get $close))
  (call $buf_finish (local.get $buffer)))
(func $codes_count (result i32) (i32.load (i32.const $codes)))
(func $code_at (param $index i32) (result i32) (i32.load (i32.add (i32.load offset=4 (i32.const $codes)) (i32.shl (local.get $index) (i32.const 2)))))
(func $cells_yield (result i32) (i32.load offset=8 (i32.const $codes)))
(func $code_named (param $name i32) (result i32) (local $index i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $codes_count)))
      (if (call $text_eq (i32.load (call $code_at (local.get $index))) (local.get $name)) (then (return (call $code_at (local.get $index)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $waits_code (param $name i32) (result i32) (local $index i32) (local $waits i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $codes_count)))
      (local.set $waits (i32.load offset=56 (call $code_at (local.get $index))))
      (if (local.get $waits)
        (then (if (call $text_eq (i32.load (local.get $waits)) (local.get $name)) (then (return (call $code_at (local.get $index)))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $waits_tool (param $name i32) (result i32) (local $code i32)
  (local.set $code (call $waits_code (local.get $name)))
  (if (i32.eqz (local.get $code)) (then (return (i32.const 0))))
  (i32.load offset=56 (local.get $code)))
(func $code_calls (result i64) (i64.extend_i32_u (i32.load offset=12 (global.get $c_code))))
(func $code_parallel (result i64) (i64.extend_i32_u (i32.load offset=20 (global.get $c_code))))
(func $code_timers (result i64) (i64.extend_i32_u (i32.load offset=28 (global.get $c_code))))
(func $code_timer_ms (result i64) (i64.extend_i32_u (i32.load offset=36 (global.get $c_code))))
