(func $obj_done (param $node i32) (result i32) (call $json_object_sort (local.get $node)) (local.get $node))
(func $obj1 (param $k1 i32) (param $v1 i32) (result i32) (call $json_one (local.get $k1) (local.get $v1)))
(func $obj2 (param $k1 i32) (param $v1 i32) (param $k2 i32) (param $v2 i32) (result i32) (local $node i32)
  (local.set $node (call $obj (i32.const 2)))
  (call $json_object_set (local.get $node) (i32.const 0) (local.get $k1) (local.get $v1))
  (call $json_object_set (local.get $node) (i32.const 1) (local.get $k2) (local.get $v2))
  (call $obj_done (local.get $node)))
(func $obj3 (param $k1 i32) (param $v1 i32) (param $k2 i32) (param $v2 i32) (param $k3 i32) (param $v3 i32) (result i32) (local $node i32)
  (local.set $node (call $obj (i32.const 3)))
  (call $json_object_set (local.get $node) (i32.const 0) (local.get $k1) (local.get $v1))
