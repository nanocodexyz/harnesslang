(import "hl" "fail" (func $host_fail (param i32 i32)))
(import "hl" "hook" (func $host_hook (param i32 i32 i32)))
(import "hl" "flush" (func $host_flush (param i64 i32 i32)))
(import "hl" "keep" (func $host_keep (param i64)))
(import "hl" "tool" (func $host_tool (param i32 i32) (result i64)))
(import "hl" "model" (func $host_model (param i32 i32) (result i64)))
(import "hl" "now" (func $host_now (result i64)))
(import "hl" "random" (func $host_random (result i64)))
(import "hl" "attempt" (func $host_attempt (param i64 i64) (result i64)))
(import "hl" "acknowledge" (func $host_acknowledge (param i32 i32)))
(memory (export "memory") 2)
(global $PAGE_BYTES i32 (i32.const 65536))
(global $PAGE_SHIFT i32 (i32.const 16))
(global $ALIGN_MASK i32 (i32.const 7))
(global $ADDRESS_PAGED_MAX i32 (i32.const 0xffff0000))
(global $BUFFER_BYTES_FIRST i32 (i32.const 256))
(global $U64_DECIMAL_DIGITS_MAX i32 (i32.const 20))
(global $DECIMAL_BASE i64 (i64.const 10))
(global $ASCII_ZERO i32 (i32.const 48))
(global $CRC32_POLYNOMIAL_REFLECTED i32 (i32.const 0xedb88320))
(global $CRC32_CHECK i32 (i32.const 0xcbf43926))
(global $BYTE_VALUES i32 (i32.const 256))
(global $BITS_PER_BYTE i32 (i32.const 8))
(global $heap (mut i32) (i32.const $static_end))
(global $crc_table (mut i32) (i32.const 0))
(text $s_memory_exhausted "wasm memory exhausted")
(text $s_crc_check "CRC-32 does not match its catalogued check value")
(text $s_crc_check_input "123456789")
(func $panic (param $message i32)
  (call $host_fail (i32.add (local.get $message) (i32.const 4)) (i32.load (local.get $message)))
  unreachable)
(func $assert (param $holds i32) (param $message i32)
  (if (i32.eqz (local.get $holds)) (then (call $panic (local.get $message)))))
(func $alloc (export "hl_alloc") (param $size i32) (result i32) (local $at i32) (local $end i32) (local $pages i32)
  (local.set $at (i32.and (i32.add (global.get $heap) (global.get $ALIGN_MASK)) (i32.xor (global.get $ALIGN_MASK) (i32.const -1))))
  (local.set $end (i32.add (local.get $at) (local.get $size)))
  (if (i32.or (i32.lt_u (local.get $end) (local.get $at)) (i32.gt_u (local.get $end) (global.get $ADDRESS_PAGED_MAX)))
    (then (call $panic (i32.const $s_memory_exhausted))))
  (local.set $pages (i32.shr_u (i32.add (local.get $end) (i32.sub (global.get $PAGE_BYTES) (i32.const 1))) (global.get $PAGE_SHIFT)))
  (if (i32.gt_u (local.get $pages) (memory.size))
    (then
      (if (i32.lt_s (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const 0))
        (then (call $panic (i32.const $s_memory_exhausted))))))
  (global.set $heap (local.get $end))
  (local.get $at))
(func $text_len (param $text i32) (result i32) (i32.load (local.get $text)))
(func $text_bytes (param $text i32) (result i32) (i32.add (local.get $text) (i32.const 4)))
(func $text_new (param $length i32) (result i32) (local $text i32)
  (local.set $text (call $alloc (i32.add (local.get $length) (i32.const 4))))
  (i32.store (local.get $text) (local.get $length))
  (local.get $text))
(func $text_from (param $bytes i32) (param $length i32) (result i32) (local $text i32)
  (local.set $text (call $text_new (local.get $length)))
  (memory.copy (call $text_bytes (local.get $text)) (local.get $bytes) (local.get $length))
  (local.get $text))
(func $bytes_equal (param $left i32) (param $right i32) (param $length i32) (result i32) (local $at i32)
  block $differ
    loop $next
      (if (i32.ge_u (local.get $at) (local.get $length)) (then (return (i32.const 1))))
      (br_if $differ (i32.ne (i32.load8_u (i32.add (local.get $left) (local.get $at))) (i32.load8_u (i32.add (local.get $right) (local.get $at)))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $text_eq (param $left i32) (param $right i32) (result i32)
  (if (i32.ne (call $text_len (local.get $left)) (call $text_len (local.get $right))) (then (return (i32.const 0))))
  (call $bytes_equal (call $text_bytes (local.get $left)) (call $text_bytes (local.get $right)) (call $text_len (local.get $left))))
(func $text_cmp (param $left i32) (param $right i32) (result i32) (local $at i32) (local $shorter i32) (local $a i32) (local $b i32)
  (local.set $shorter (select (call $text_len (local.get $left)) (call $text_len (local.get $right)) (i32.lt_u (call $text_len (local.get $left)) (call $text_len (local.get $right)))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $at) (local.get $shorter)))
      (local.set $a (i32.load8_u (i32.add (call $text_bytes (local.get $left)) (local.get $at))))
      (local.set $b (i32.load8_u (i32.add (call $text_bytes (local.get $right)) (local.get $at))))
      (if (i32.lt_u (local.get $a) (local.get $b)) (then (return (i32.const -1))))
      (if (i32.gt_u (local.get $a) (local.get $b)) (then (return (i32.const 1))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (if (i32.lt_u (call $text_len (local.get $left)) (call $text_len (local.get $right))) (then (return (i32.const -1))))
  (i32.gt_u (call $text_len (local.get $left)) (call $text_len (local.get $right))))
(func $text_concat (param $left i32) (param $right i32) (result i32) (local $text i32)
  (local.set $text (call $text_new (i32.add (call $text_len (local.get $left)) (call $text_len (local.get $right)))))
  (memory.copy (call $text_bytes (local.get $text)) (call $text_bytes (local.get $left)) (call $text_len (local.get $left)))
  (memory.copy (i32.add (call $text_bytes (local.get $text)) (call $text_len (local.get $left))) (call $text_bytes (local.get $right)) (call $text_len (local.get $right)))
  (local.get $text))
(func $buf_new (result i32) (local $buffer i32)
  (local.set $buffer (call $alloc (i32.const 12)))
  (i32.store (local.get $buffer) (call $alloc (i32.add (global.get $BUFFER_BYTES_FIRST) (i32.const 4))))
  (i32.store offset=8 (local.get $buffer) (global.get $BUFFER_BYTES_FIRST))
  (local.get $buffer))
(func $buf_reserve (param $buffer i32) (param $extra i32) (local $need i32) (local $capacity i32) (local $data i32)
  (local.set $need (i32.add (i32.load offset=4 (local.get $buffer)) (local.get $extra)))
  (if (i32.le_u (local.get $need) (i32.load offset=8 (local.get $buffer))) (then (return)))
  (local.set $capacity (i32.shl (i32.load offset=8 (local.get $buffer)) (i32.const 1)))
  (if (i32.lt_u (local.get $capacity) (local.get $need)) (then (local.set $capacity (local.get $need))))
  (local.set $data (call $alloc (i32.add (local.get $capacity) (i32.const 4))))
  (memory.copy (i32.add (local.get $data) (i32.const 4)) (i32.add (i32.load (local.get $buffer)) (i32.const 4)) (i32.load offset=4 (local.get $buffer)))
  (i32.store (local.get $buffer) (local.get $data))
  (i32.store offset=8 (local.get $buffer) (local.get $capacity)))
(func $buf_byte (param $buffer i32) (param $byte i32) (local $length i32)
  (call $buf_reserve (local.get $buffer) (i32.const 1))
  (local.set $length (i32.load offset=4 (local.get $buffer)))
  (i32.store8 (i32.add (i32.add (i32.load (local.get $buffer)) (i32.const 4)) (local.get $length)) (local.get $byte))
  (i32.store offset=4 (local.get $buffer) (i32.add (local.get $length) (i32.const 1))))
(func $buf_bytes (param $buffer i32) (param $bytes i32) (param $count i32) (local $length i32)
  (call $buf_reserve (local.get $buffer) (local.get $count))
  (local.set $length (i32.load offset=4 (local.get $buffer)))
  (memory.copy (i32.add (i32.add (i32.load (local.get $buffer)) (i32.const 4)) (local.get $length)) (local.get $bytes) (local.get $count))
  (i32.store offset=4 (local.get $buffer) (i32.add (local.get $length) (local.get $count))))
(func $buf_text (param $buffer i32) (param $text i32)
  (call $buf_bytes (local.get $buffer) (call $text_bytes (local.get $text)) (call $text_len (local.get $text))))
(func $buf_u64 (param $buffer i32) (param $value i64) (local $digits i32) (local $count i32)
  (local.set $digits (call $alloc (global.get $U64_DECIMAL_DIGITS_MAX)))
  loop $next
    (i32.store8 (i32.add (local.get $digits) (local.get $count))
      (i32.add (global.get $ASCII_ZERO) (i32.wrap_i64 (i64.rem_u (local.get $value) (global.get $DECIMAL_BASE)))))
    (local.set $count (i32.add (local.get $count) (i32.const 1)))
    (local.set $value (i64.div_u (local.get $value) (global.get $DECIMAL_BASE)))
    (br_if $next (i64.ne (local.get $value) (i64.const 0)))
  end
  loop $emit
    (local.set $count (i32.sub (local.get $count) (i32.const 1)))
    (call $buf_byte (local.get $buffer) (i32.load8_u (i32.add (local.get $digits) (local.get $count))))
    (br_if $emit (local.get $count))
  end)
(func $buf_length (param $buffer i32) (result i32) (i32.load offset=4 (local.get $buffer)))
(func $buf_data (param $buffer i32) (result i32) (i32.add (i32.load (local.get $buffer)) (i32.const 4)))
(func $buf_finish (param $buffer i32) (result i32)
  (i32.store (i32.load (local.get $buffer)) (i32.load offset=4 (local.get $buffer)))
  (i32.load (local.get $buffer)))
(func $u64_text (param $value i64) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_u64 (local.get $buffer) (local.get $value))
  (call $buf_finish (local.get $buffer)))
(func $crc_init (local $index i32) (local $value i32) (local $bit i32)
  (global.set $crc_table (call $alloc (i32.mul (global.get $BYTE_VALUES) (i32.const 4))))
  loop $entry
    (local.set $value (local.get $index))
    (local.set $bit (i32.const 0))
    loop $shift
      (local.set $value (select
        (i32.xor (i32.shr_u (local.get $value) (i32.const 1)) (global.get $CRC32_POLYNOMIAL_REFLECTED))
        (i32.shr_u (local.get $value) (i32.const 1))
        (i32.and (local.get $value) (i32.const 1))))
      (local.set $bit (i32.add (local.get $bit) (i32.const 1)))
      (br_if $shift (i32.lt_u (local.get $bit) (global.get $BITS_PER_BYTE)))
    end
    (i32.store (i32.add (global.get $crc_table) (i32.shl (local.get $index) (i32.const 2))) (local.get $value))
    (local.set $index (i32.add (local.get $index) (i32.const 1)))
    (br_if $entry (i32.lt_u (local.get $index) (global.get $BYTE_VALUES)))
  end
  (call $assert (i32.eq (call $crc32 (call $text_bytes (i32.const $s_crc_check_input)) (call $text_len (i32.const $s_crc_check_input))) (global.get $CRC32_CHECK)) (i32.const $s_crc_check)))
(func $crc32 (param $bytes i32) (param $length i32) (result i32) (local $crc i32) (local $at i32)
  (local.set $crc (i32.const -1))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $at) (local.get $length)))
      (local.set $crc (i32.xor
        (i32.shr_u (local.get $crc) (global.get $BITS_PER_BYTE))
        (i32.load (i32.add (global.get $crc_table)
          (i32.shl (i32.and (i32.xor (local.get $crc) (i32.load8_u (i32.add (local.get $bytes) (local.get $at)))) (i32.const 0xff)) (i32.const 2))))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (i32.xor (local.get $crc) (i32.const -1)))
