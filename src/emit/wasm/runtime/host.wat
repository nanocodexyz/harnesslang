(text $h_ok "{}")
(text $h_events "events")
(text $h_events_max "events_max")
(text $h_handlers "handlers")
(text $h_name "name")
(text $h_effects_max "effects_max")
(text $h_idle "idle")
(text $h_sides "sides")
(text $h_error "error")
(text $h_due "due")
(text $h_not_object "a turn request is an object")
(text $h_turn "a turn request's turn is not a number")
(text $h_handler "a turn request names its handler")
(text $h_no_handler "no handler of the program has this name")
(text $h_arguments "a turn request carries the handler's arguments")
(text $h_scope "a turn request's scope is text, the key its session was spawned under")
(func $facts_entry (export "hl_facts") (result i64) (local $node i32) (local $handlers i32) (local $sides i32) (local $index i32) (local $handler i32) (local $entry i32) (local $idle i32)
  (local.set $handlers (call $json_array (call $program_handlers)))
  block $listed
    loop $next
      (br_if $listed (i32.ge_u (local.get $index) (call $program_handlers)))
      (local.set $handler (call $program_handler (local.get $index)))
      (local.set $entry (call $json_object (i32.const 2)))
      (call $json_object_set (local.get $entry) (i32.const 0) (i32.const $h_effects_max) (call $json_number (i64.extend_i32_u (i32.load offset=20 (local.get $handler)))))
      (call $json_object_set (local.get $entry) (i32.const 1) (i32.const $h_name) (call $json_string (i32.load (local.get $handler))))
      (call $json_array_set (local.get $handlers) (local.get $index) (local.get $entry))
      (if (call $idles (local.get $handler)) (then (local.set $idle (call $json_string (i32.load (local.get $handler))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (if (i32.eqz (local.get $idle)) (then (local.set $idle (i32.const $json_null))))
  (local.set $sides (call $json_array (call $sides_count)))
  (local.set $index (i32.const 0))
  block $named
    loop $side
      (br_if $named (i32.ge_u (local.get $index) (call $sides_count)))
      (call $json_array_set (local.get $sides) (local.get $index)
        (call $json_string (i32.load (i32.load offset=4 (i32.add (i32.const $program_sides) (i32.shl (local.get $index) (i32.const 2)))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $side
    end
  end
  (local.set $node (call $json_object (i32.const 5)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $h_events) (call $json_bool (call $events_any)))
  (call $json_object_set (local.get $node) (i32.const 1) (i32.const $h_events_max) (call $json_number (call $events_records_max)))
  (call $json_object_set (local.get $node) (i32.const 2) (i32.const $h_handlers) (local.get $handlers))
  (call $json_object_set (local.get $node) (i32.const 3) (i32.const $h_idle) (local.get $idle))
  (call $json_object_set (local.get $node) (i32.const 4) (i32.const $h_sides) (local.get $sides))
  (call $packed (call $json_encode (local.get $node))))
(func $check_error (param $text i32) (result i64) (local $node i32)
  (local.set $node (call $json_object (i32.const 1)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $h_error) (call $json_string (local.get $text)))
  (call $packed (call $json_encode (local.get $node))))
(func $check_entry (export "hl_check") (param $bytes i32) (param $length i32) (result i64) (local $request i32) (local $field i32) (local $handler i32)
  (local.set $request (call $json_parse_bytes (local.get $bytes) (local.get $length)))
  (if (i32.or (global.get $parse_failed) (i32.ne (call $json_tag (local.get $request)) (global.get $JSON_OBJECT)))
    (then (return (call $check_error (i32.const $h_not_object)))))
  (local.set $field (call $json_get (local.get $request) (i32.const $s_turn)))
  (if (i32.or (i32.eqz (local.get $field)) (i32.ne (call $json_tag (local.get $field)) (global.get $JSON_NUMBER)))
    (then (return (call $check_error (i32.const $h_turn)))))
  (local.set $field (call $json_get (local.get $request) (i32.const $s_handler)))
  (if (i32.or (i32.eqz (local.get $field)) (i32.ne (call $json_tag (local.get $field)) (global.get $JSON_STRING)))
    (then (return (call $check_error (i32.const $h_handler)))))
  (local.set $handler (call $handler_named (call $json_text (local.get $field))))
  (if (i32.eqz (local.get $handler)) (then (return (call $check_error (i32.const $h_no_handler)))))
  (local.set $field (call $json_get (local.get $request) (i32.const $s_scope)))
  (if (i32.and (i32.ne (local.get $field) (i32.const 0)) (i32.ne (call $json_tag (local.get $field)) (global.get $JSON_STRING)))
    (then (return (call $check_error (i32.const $h_scope)))))
  (global.set $decode_error (i32.const 0))
  (if (i32.eqz (call $arguments_from_json (local.get $handler) (call $json_get (local.get $request) (i32.const $s_arguments))))
    (then (return (call $check_error (i32.const $h_arguments)))))
  (call $packed (i32.const $h_ok)))
(func $idle_entry (export "hl_idle") (param $journal_bytes i32) (param $journal_length i32) (param $epoch i64) (result i64) (local $records i32) (local $state i32) (local $due i64) (local $node i32)
  (global.set $halt (i32.const 0))
  (global.set $epoch (local.get $epoch))
  (local.set $node (call $json_object (i32.const 1)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $h_due) (i32.const $json_null))
  (if (i32.eqz (call $idle_present)) (then (return (call $packed (call $json_encode (local.get $node))))))
  (local.set $records (call $journal_records (local.get $journal_bytes) (local.get $journal_length)))
  (if (global.get $halt) (then (return (call $exit_corrupt))))
  (if (i32.eqz (call $fold (local.get $records))) (then (return (call $exit_corrupt))))
  (if (call $idle_busy) (then (return (call $packed (call $json_encode (local.get $node))))))
  (local.set $state (call $state_before (select (i64.add (call $session_last) (i64.const 1)) (global.get $FIRST_TURN) (call $vec_count (global.get $turns)))))
  (if (i32.eqz (local.get $state)) (then (return (call $exit_corrupt))))
  (local.set $due (call $idle_armed (local.get $state)))
  (if (i64.ne (local.get $due) (i64.const 0))
    (then (call $json_object_set (local.get $node) (i32.const 0) (i32.const $h_due) (call $json_number (local.get $due)))))
  (call $packed (call $json_encode (local.get $node))))
