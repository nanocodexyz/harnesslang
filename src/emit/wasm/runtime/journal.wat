  (global.set $id_seq (call $parse_u64_text (call $text_from (i32.add (call $text_bytes (local.get $text)) (i32.add (local.get $at) (i32.const 1)))
    (i32.sub (local.get $length) (i32.add (local.get $at) (i32.const 1)))))))
(func $exact (param $node i32) (param $keys i32) (result i32) (local $count i32) (local $index i32)
  (local.set $count (i32.load (local.get $keys)))
  (if (i32.ne (call $json_tag (local.get $node)) (global.get $JSON_OBJECT)) (then (return (i32.const 0))))
  (if (i32.ne (call $json_count (local.get $node)) (local.get $count)) (then (return (i32.const 0))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (if (i32.eqz (call $text_eq (call $json_key (local.get $node) (local.get $index)) (i32.load offset=4 (i32.add (local.get $keys) (i32.shl (local.get $index) (i32.const 2))))))
        (then (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 1))
(func $field_text (param $node i32) (param $key i32) (result i32) (local $field i32)
  (local.set $field (call $json_get (local.get $node) (local.get $key)))
  (if (i32.or (i32.eqz (local.get $field)) (i32.ne (call $json_tag (local.get $field)) (global.get $JSON_STRING)))
    (then (global.set $record_failed (i32.const 1)) (return (i32.const $s_empty))))
  (call $json_text (local.get $field)))
(func $field_number (param $node i32) (param $key i32) (result i64) (local $field i32)
  (local.set $field (call $json_get (local.get $node) (local.get $key)))
  (if (i32.or (i32.eqz (local.get $field)) (i32.ne (call $json_tag (local.get $field)) (global.get $JSON_NUMBER)))
    (then (global.set $record_failed (i32.const 1)) (return (i64.const 0))))
  (call $json_number_value (local.get $field)))
(func $field_call (param $body i32) (param $record i32)
  (call $parse_call_id (call $field_text (local.get $body) (i32.const $s_call_id)))
  (if (i64.ne (call $field_number (local.get $body) (i32.const $s_seq)) (global.get $id_seq)) (then (global.set $record_failed (i32.const 1))))
  (i64.store offset=8 (local.get $record) (global.get $id_turn))
  (i64.store offset=16 (local.get $record) (global.get $id_seq)))
(func $record_from (param $node i32) (result i32) (local $record i32) (local $tag i32) (local $body i32)
  (global.set $record_failed (i32.const 0))
  (if (i32.eqz (call $json_tagged (local.get $node))) (then (return (i32.const 0))))
  (local.set $tag (call $json_key (local.get $node) (i32.const 0)))
  (local.set $body (call $json_value (local.get $node) (i32.const 0)))
  (if (i32.ne (call $json_tag (local.get $body)) (global.get $JSON_OBJECT)) (then (return (i32.const 0))))
  (local.set $record (call $alloc (global.get $RECORD_BYTES)))
