(func $record_recovery (param $turn i64) (param $attempt i64) (param $unknown i32) (result i32) (local $buffer i32) (local $index i32)
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_w_recovery))
  (call $buf_u64 (local.get $buffer) (local.get $attempt))
  (call $buf_text (local.get $buffer) (i32.const $s_w_turn))
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_text (local.get $buffer) (i32.const $s_w_unknown))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $unknown))))
      (if (local.get $index) (then (call $buf_byte (local.get $buffer) (i32.const 44))))
      (call $buf_byte (local.get $buffer) (i32.const 34))
      (call $buf_call_id (local.get $buffer) (local.get $turn) (i64.load (call $vec_at (local.get $unknown) (local.get $index))))
      (call $buf_byte (local.get $buffer) (i32.const 34))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
