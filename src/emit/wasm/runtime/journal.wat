(func $parse_u64_text (param $text i32) (result i64) (local $at i32) (local $length i32) (local $value i64) (local $digit i32)
  (local.set $length (call $text_len (local.get $text)))
  (if (i32.and (i32.gt_u (local.get $length) (i32.const 0)) (i32.eq (i32.load8_u offset=4 (local.get $text)) (global.get $PLUS)))
    (then (local.set $at (i32.const 1))))
  (if (i32.ge_u (local.get $at) (local.get $length)) (then (global.set $record_failed (i32.const 1)) (return (i64.const 0))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $at) (local.get $length)))
      (local.set $digit (i32.sub (i32.load8_u offset=4 (i32.add (local.get $text) (local.get $at))) (global.get $ASCII_ZERO)))
      (if (i32.ge_u (local.get $digit) (i32.const 10)) (then (global.set $record_failed (i32.const 1)) (return (i64.const 0))))
      (if (i32.or (i64.gt_u (local.get $value) (global.get $U64_TENTH_MAX))
                  (i32.and (i64.eq (local.get $value) (global.get $U64_TENTH_MAX)) (i32.gt_u (local.get $digit) (global.get $U64_LAST_DIGIT_MAX))))
        (then (global.set $record_failed (i32.const 1)) (return (i64.const 0))))
      (local.set $value (i64.add (i64.mul (local.get $value) (global.get $DECIMAL_BASE)) (i64.extend_i32_u (local.get $digit))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (local.get $value))
(func $parse_call_id (param $text i32) (local $at i32) (local $length i32)
  (local.set $length (call $text_len (local.get $text)))
  block $found
    loop $next
      (if (i32.ge_u (local.get $at) (local.get $length)) (then (global.set $record_failed (i32.const 1)) (return)))
      (br_if $found (i32.eq (i32.load8_u offset=4 (i32.add (local.get $text) (local.get $at))) (global.get $SLASH)))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
