  (call $json_write_string (local.get $buffer) (local.get $tool))
  (call $buf_text (local.get $buffer) (i32.const $s_w_turn))
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_text (local.get $buffer) (i32.const $s_w_close2))
  (call $buf_finish (local.get $buffer)))
(func $record_result (param $turn i64) (param $seq i64) (param $output i32) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_w_result))
  (call $buf_call_id (local.get $buffer) (local.get $turn) (local.get $seq))
