(func $vec_new (param $size i32) (result i32) (local $vec i32)
  (local.set $vec (call $alloc (i32.const 16)))
  (i32.store offset=12 (local.get $vec) (local.get $size))
  (local.get $vec))
(func $vec_count (param $vec i32) (result i32) (i32.load offset=4 (local.get $vec)))
(func $vec_at (param $vec i32) (param $index i32) (result i32)
  (i32.add (i32.load (local.get $vec)) (i32.mul (local.get $index) (i32.load offset=12 (local.get $vec)))))
(func $vec_push (param $vec i32) (result i32) (local $count i32) (local $room i32) (local $data i32) (local $size i32)
  (local.set $count (call $vec_count (local.get $vec)))
  (local.set $size (i32.load offset=12 (local.get $vec)))
  (if (i32.ge_u (local.get $count) (i32.load offset=8 (local.get $vec)))
    (then
      (local.set $room (i32.shl (local.get $count) (i32.const 1)))
      (if (i32.lt_u (local.get $room) (global.get $VEC_SLOTS_FIRST)) (then (local.set $room (global.get $VEC_SLOTS_FIRST))))
      (local.set $data (call $alloc (i32.mul (local.get $room) (local.get $size))))
      (if (local.get $count)
        (then (memory.copy (local.get $data) (i32.load (local.get $vec)) (i32.mul (local.get $count) (local.get $size)))))
      (i32.store (local.get $vec) (local.get $data))
      (i32.store offset=8 (local.get $vec) (local.get $room))))
  (i32.store offset=4 (local.get $vec) (i32.add (local.get $count) (i32.const 1)))
  (call $vec_at (local.get $vec) (local.get $count)))
(func $vec_clear (param $vec i32) (i32.store offset=4 (local.get $vec) (i32.const 0)))
(func $effect_name (param $effect i32) (result i32)
  (if (i32.eq (local.get $effect) (global.get $EFFECT_NONE)) (then (return (i32.const $s_none))))
  (if (i32.eq (local.get $effect) (global.get $EFFECT_IDEMPOTENT)) (then (return (i32.const $s_idempotent))))
  (i32.const $s_external))
(func $effect_parse (param $text i32) (result i32)
  (if (call $text_eq (local.get $text) (i32.const $s_none)) (then (return (global.get $EFFECT_NONE))))
  (if (call $text_eq (local.get $text) (i32.const $s_idempotent)) (then (return (global.get $EFFECT_IDEMPOTENT))))
  (if (call $text_eq (local.get $text) (i32.const $s_external)) (then (return (global.get $EFFECT_EXTERNAL))))
  (i32.const -1))
(func $buf_call_id (param $buffer i32) (param $turn i64) (param $seq i64)
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_byte (local.get $buffer) (global.get $SLASH))
  (call $buf_u64 (local.get $buffer) (local.get $seq)))
(func $output_new (param $kind i32) (param $payload i32) (result i32) (local $output i32)
  (local.set $output (call $alloc (i32.const 8)))
  (i32.store (local.get $output) (local.get $kind))
  (i32.store offset=4 (local.get $output) (local.get $payload))
  (local.get $output))
(func $output_kind (param $output i32) (result i32) (i32.load (local.get $output)))
(func $output_payload (param $output i32) (result i32) (i32.load offset=4 (local.get $output)))
(func $buf_output (param $buffer i32) (param $output i32)
  (if (i32.eq (call $output_kind (local.get $output)) (global.get $OUTPUT_OK))
    (then
      (call $buf_text (local.get $buffer) (i32.const $s_w_ok))
      (call $json_write (local.get $buffer) (call $output_payload (local.get $output)) (i32.const 0)))
    (else
      (call $buf_text (local.get $buffer) (i32.const $s_w_failed))
      (call $json_write_string (local.get $buffer) (call $output_payload (local.get $output)))))
  (call $buf_byte (local.get $buffer) (i32.const 125)))
(func $output_text (param $output i32) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_output (local.get $buffer) (local.get $output))
  (call $buf_finish (local.get $buffer)))
(func $output_from_json (param $node i32) (result i32) (local $value i32)
  (if (i32.eqz (call $json_tagged (local.get $node))) (then (return (i32.const 0))))
  (local.set $value (call $json_value (local.get $node) (i32.const 0)))
  (if (call $text_eq (call $json_key (local.get $node) (i32.const 0)) (i32.const $s_ok))
    (then (return (call $output_new (global.get $OUTPUT_OK) (local.get $value)))))
  (if (i32.and (call $text_eq (call $json_key (local.get $node) (i32.const 0)) (i32.const $s_failed))
               (i32.eq (call $json_tag (local.get $value)) (global.get $JSON_STRING)))
    (then (return (call $output_new (global.get $OUTPUT_FAILED) (call $json_text (local.get $value))))))
  (i32.const 0))
(func $record_admitted (param $turn i64) (param $handler i32) (param $arguments i32) (result i32) (local $buffer i32)
