  (call $buf_text (local.get $buffer) (i32.const $s_w_result_field))
  (call $json_write (local.get $buffer) (local.get $result) (i32.const 0))
  (call $buf_text (local.get $buffer) (i32.const $s_w_status_turn))
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_text (local.get $buffer) (i32.const $s_w_close2))
