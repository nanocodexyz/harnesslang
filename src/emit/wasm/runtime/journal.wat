(func $record_model (param $turn i64) (param $seq i64) (param $response i32) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_w_model))
  (call $buf_call_id (local.get $buffer) (local.get $turn) (local.get $seq))
  (call $buf_text (local.get $buffer) (i32.const $s_w_response))
  (call $json_write (local.get $buffer) (local.get $response) (i32.const 0))
  (call $buf_text (local.get $buffer) (i32.const $s_w_seq))
  (call $buf_u64 (local.get $buffer) (local.get $seq))
  (call $buf_text (local.get $buffer) (i32.const $s_w_turn))
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_text (local.get $buffer) (i32.const $s_w_close2))
