(text $i_at "at")
(text $i_due "due")
(text $i_x_not_due "{\"exit\":\"not_due\"}")
(func $idle_present (result i32) (i32.load (i32.const $idle)))
(func $idles (param $handler i32) (result i32)
  (i32.and (call $idle_present) (i32.eq (i32.load offset=16 (local.get $handler)) (i32.load offset=4 (i32.const $idle)))))
(func $idle_field (param $state i32) (param $field i32) (result i64)
  (i64.load (i32.add (local.get $state) (i32.shl (local.get $field) (i32.const 3)))))
(func $idle_armed (param $state i32) (result i64) (local $due i64)
  (local.set $due (call $idle_field (local.get $state) (i32.load offset=8 (i32.const $idle))))
  (if (i64.eqz (local.get $due)) (then (return (i64.const 0))))
  (if (i64.ge_u (call $idle_field (local.get $state) (i32.load offset=12 (i32.const $idle))) (i64.extend_i32_u (i32.load offset=16 (i32.const $idle))))
    (then (return (i64.const 0))))
  (local.get $due))
(func $idle_busy (result i32)
  (if (i32.eqz (call $vec_count (global.get $turns))) (then (return (i32.const 0))))
  (i32.eqz (call $log_finished (call $session_log (call $session_last)))))
(func $idle_arguments (param $clock i64) (param $due i64) (result i32) (local $node i32)
  (local.set $node (call $json_object (i32.const 2)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $i_at) (call $json_number (local.get $clock)))
  (call $json_object_set (local.get $node) (i32.const 1) (i32.const $i_due) (call $json_number (local.get $due)))
  (local.get $node))
(func $exit_not_due (result i64) (call $packed (i32.const $i_x_not_due)))
