(func $cell_run (param $code i32) (param $seq i64) (param $site i64) (param $script i32) (param $existing i32) (param $fresh i64) (param $header_buffered i32) (result i32) (local $interrupt i32) (local $kind i32) (local $text i32) (local $code_words i32)
  (call $cell_begin (local.get $code) (local.get $seq) (local.get $site) (local.get $script) (local.get $existing) (local.get $fresh) (local.get $header_buffered))
  (call $cell_drive)
  (local.set $interrupt (global.get $c_interrupt))
  (global.set $c_interrupt (i32.const 0))
  (if (i32.eq (local.get $interrupt) (global.get $INTERRUPT_STOPPED)) (then (return (call $cell_stopped (global.get $c_stop_unknown)))))
  (if (i32.eq (local.get $interrupt) (global.get $INTERRUPT_YIELD))
    (then
      (if (call $cell_cancelled (i32.const 0)) (then (return (call $cell_stopped (i32.const 0)))))
      (return (call $cell_yielded))))
  (local.set $kind (global.get $c_outcome_kind))
  (local.set $text (global.get $c_outcome_text))
  (if (i32.eq (local.get $interrupt) (global.get $INTERRUPT_THREW))
    (then (local.set $kind (global.get $OUTCOME_THREW)) (local.set $text (global.get $c_reason))))
  (if (i32.eq (local.get $interrupt) (global.get $INTERRUPT_DIVERGED))
    (then (local.set $kind (global.get $OUTCOME_UNKNOWN)) (local.set $text (call $divergence_text (global.get $c_cell) (global.get $c_reason)))))
  (if (i32.eq (local.get $interrupt) (global.get $INTERRUPT_OVERFLOW))
    (then
      (local.set $code_words (global.get $c_code))
      (local.set $kind (global.get $OUTCOME_UNKNOWN))
      (local.set $text (call $divergence_text (global.get $c_cell)
        (call $bound_text (i32.const $k_overflow_open) (i32.load offset=48 (local.get $code_words)) (i32.load offset=44 (local.get $code_words)) (i32.const $k_close_paren))))))
  (if (call $cell_cancelled (i32.const 0)) (then (return (call $cell_stopped (i32.const 0)))))
  (call $cell_finish (local.get $kind) (local.get $text)))
