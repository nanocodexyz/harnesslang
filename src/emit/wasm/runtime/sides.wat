(global $SIDE_TURN i64 (i64.const 0))
(text $e_side "side")
(text $e_side_model "side_model")
(text $e_side_tool "side_tool")
(text $e_side_answer "side_answer")
(text $e_handler "handler")
(text $e_arguments "arguments")
(text $e_context "context")
(text $e_context_crc "context_crc")
(text $e_error "error")
(text $e_corrupt_open "Corrupt(")
(text $e_no_side "a side request names a side handler of the program")
(text $e_side_arguments "a side request carries the side handler's arguments")
(text $e_side_answered "a side question finishes or stops")
(func $sides_count (result i32) (i32.load (i32.const $program_sides)))
(func $side_named (param $name i32) (result i32) (local $index i32) (local $handler i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $sides_count)))
      (local.set $handler (i32.load offset=4 (i32.add (i32.const $program_sides) (i32.shl (local.get $index) (i32.const 2)))))
      (if (call $text_eq (i32.load (local.get $handler)) (local.get $name)) (then (return (local.get $handler))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $state_copy (param $state i32) (result i32) (local $copy i32) (local $bytes i32)
  (local.set $bytes (i32.shl (i32.add (call $program_fields) (i32.const 1)) (i32.const 3)))
  (local.set $copy (call $alloc (local.get $bytes)))
  (memory.copy (local.get $copy) (local.get $state) (local.get $bytes))
  (local.get $copy))
(func $side_model (param $buffer i32) (param $seq i64) (result i32) (local $sent i32) (local $request i32) (local $context i32) (local $mode i32) (local $settings i32) (local $count i32) (local $at i32)
  (local.set $sent (call $json_parse (call $buf_finish (local.get $buffer))))
  (call $assert (i32.eqz (global.get $parse_failed)) (i32.const $s_not_json))
  (local.set $context (call $json_encode (call $json_get (local.get $sent) (i32.const $e_context))))
  (local.set $mode (call $json_get (local.get $sent) (i32.const $s_mode)))
  (local.set $settings (call $json_get (local.get $sent) (i32.const $s_settings)))
  (local.set $count (i32.add (i32.const 2) (i32.add (i32.ne (local.get $mode) (i32.const 0)) (i32.ne (local.get $settings) (i32.const 0)))))
  (local.set $request (call $request (i32.const $e_side_model) (local.get $count)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $s_seq) (call $json_number (local.get $seq)))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $e_context_crc)
    (call $json_number (i64.extend_i32_u (call $crc32 (call $text_bytes (local.get $context)) (call $text_len (local.get $context))))))
  (local.set $at (i32.const 2))
  (if (local.get $mode)
    (then
      (call $json_object_set (local.get $request) (local.get $at) (i32.const $s_mode) (local.get $mode))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))))
  (if (local.get $settings)
    (then (call $json_object_set (local.get $request) (local.get $at) (i32.const $s_settings) (local.get $settings))))
  (call $json_object_sort (local.get $request))
  (call $json_get (call $world (local.get $request)) (i32.const $s_response)))
(func $tool_answer (param $seq i64) (param $call i32) (result i32) (local $request i32)
  (if (i32.eqz (global.get $side)) (then (return (call $host_json (call $tool_request (local.get $seq) (local.get $call))))))
  (local.set $request (call $request (i32.const $e_side_tool) (i32.const 3)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $s_input) (call $call_input (local.get $call)))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $s_seq) (call $json_number (local.get $seq)))
  (call $json_object_set (local.get $request) (i32.const 2) (i32.const $s_tool) (call $json_string (call $call_tool (local.get $call))))
  (call $json_object_sort (local.get $request))
  (call $json_get (call $world (local.get $request)) (i32.const $s_output)))
(func $side_answer (param $ran i32) (local $request i32) (local $buffer i32)
  (if (i32.eq (local.get $ran) (i32.const 1))
    (then
      (local.set $request (call $request (i32.const $e_side_answer) (i32.const 2)))
      (call $json_object_set (local.get $request) (i32.const 0) (i32.const $s_outcome)
        (call $json_string (select (i32.const $s_completed) (i32.const $s_failed) (i32.eq (global.get $finish_outcome) (global.get $OUTCOME_COMPLETED)))))
      (call $json_object_set (local.get $request) (i32.const 1) (i32.const $s_result) (global.get $finish_result)))
    (else
      (call $assert (i32.eqz (local.get $ran)) (i32.const $e_side_answered))
      (local.set $buffer (call $buf_new))
      (call $buf_text (local.get $buffer) (i32.const $e_corrupt_open))
      (call $json_write_string (local.get $buffer) (global.get $halt_text))
      (call $buf_text (local.get $buffer) (i32.const $s_close_paren))
      (local.set $request (call $request (i32.const $e_side_answer) (i32.const 1)))
      (call $json_object_set (local.get $request) (i32.const 0) (i32.const $e_error) (call $json_string (call $buf_finish (local.get $buffer))))))
  (call $json_object_sort (local.get $request))
  (drop (call $world (local.get $request))))
(func $side_run (param $asked i32) (param $state i32)
  (local $handler i32) (local $args i32) (local $ran i32)
  (local $live i32) (local $turn i64) (local $seq i64) (local $log i32) (local $attempts i64) (local $buffer i32) (local $acknowledged i32)
  (local $main i32) (local $outcome i32) (local $result i32) (local $halt i32) (local $halt_text i32) (local $taken i32) (local $finishing i32) (local $taken_jobs i32) (local $jobs i32) (local $lost i32)
  (local.set $handler (call $side_named (call $field_text (local.get $asked) (i32.const $e_handler))))
  (call $assert (i32.ne (local.get $handler) (i32.const 0)) (i32.const $e_no_side))
  (local.set $args (call $arguments_from_json (local.get $handler) (call $json_get (local.get $asked) (i32.const $e_arguments))))
  (call $assert (i32.ne (local.get $args) (i32.const 0)) (i32.const $e_side_arguments))
  (local.set $live (global.get $live))
  (local.set $turn (global.get $turn))
  (local.set $seq (global.get $seq))
  (local.set $log (global.get $log))
  (local.set $attempts (global.get $attempts))
  (local.set $buffer (global.get $buffer))
  (local.set $acknowledged (global.get $acknowledged))
  (local.set $main (global.get $state))
  (local.set $outcome (global.get $finish_outcome))
  (local.set $result (global.get $finish_result))
  (local.set $halt (global.get $halt))
  (local.set $halt_text (global.get $halt_text))
  (local.set $taken (global.get $taken))
  (local.set $finishing (global.get $finishing))
  (local.set $taken_jobs (global.get $taken_jobs))
  (local.set $jobs (global.get $jobs))
  (local.set $lost (global.get $lost))
  (global.set $jobs (call $vec_new (global.get $JOB_BYTES)))
  (global.set $lost (call $vec_new (i32.const 4)))
  (global.set $side (i32.const 1))
  (call $engine_start (i32.const 1) (global.get $SIDE_TURN) (call $log_new (i32.load (local.get $handler)) (i32.const $json_null)) (call $state_copy (local.get $state)))
  (local.set $ran (call $engine_run (local.get $handler) (local.get $args)))
  (global.set $side (i32.const 0))
  (call $side_answer (local.get $ran))
  (global.set $live (local.get $live))
  (global.set $turn (local.get $turn))
  (global.set $seq (local.get $seq))
  (global.set $log (local.get $log))
  (global.set $attempts (local.get $attempts))
  (global.set $buffer (local.get $buffer))
  (global.set $acknowledged (local.get $acknowledged))
  (global.set $state (local.get $main))
  (global.set $finish_outcome (local.get $outcome))
  (global.set $finish_result (local.get $result))
  (global.set $halt (local.get $halt))
  (global.set $halt_text (local.get $halt_text))
  (global.set $taken (local.get $taken))
  (global.set $finishing (local.get $finishing))
  (global.set $taken_jobs (local.get $taken_jobs))
  (global.set $jobs (local.get $jobs))
  (global.set $lost (local.get $lost)))
(func $side_question (param $seq i64) (local $request i32) (local $asked i32)
  (if (i32.eqz (call $sides_count)) (then (return)))
  (if (i32.or (global.get $side) (i32.eqz (global.get $live))) (then (return)))
  (local.set $request (call $request (i32.const $e_side) (i32.const 3)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $e_optional) (call $json_bool (i32.const 1)))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $s_seq) (call $json_number (local.get $seq)))
  (call $json_object_set (local.get $request) (i32.const 2) (i32.const $s_turn) (call $json_number (global.get $turn)))
  (call $json_object_sort (local.get $request))
  (local.set $asked (call $world (local.get $request)))
  (if (i32.eq (call $json_tag (local.get $asked)) (global.get $JSON_NULL)) (then (return)))
  (call $side_run (local.get $asked) (global.get $snapshot)))
(func $last_finished (result i64) (local $turn i64) (local $log i32)
  (if (i32.eqz (call $vec_count (global.get $turns))) (then (return (i64.const 0))))
  (local.set $turn (call $session_last))
  block $done
    loop $next
      (local.set $log (call $session_log (local.get $turn)))
      (br_if $done (i32.eqz (local.get $log)))
      (if (call $log_finished (local.get $log)) (then (return (local.get $turn))))
      (br_if $done (i64.le_u (local.get $turn) (global.get $turn_first)))
      (local.set $turn (i64.sub (local.get $turn) (i64.const 1)))
      br $next
    end
  end
  (i64.const 0))
(func $side_entry (export "hl_side") (param $journal_bytes i32) (param $journal_length i32) (param $epoch i64) (local $request i32) (local $asked i32) (local $records i32) (local $state i32)
  (global.set $halt (i32.const 0))
  (global.set $epoch (local.get $epoch))
  (local.set $request (call $request (i32.const $e_side) (i32.const 2)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $s_seq) (i32.const $json_null))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $s_turn) (i32.const $json_null))
  (call $json_object_sort (local.get $request))
  (local.set $asked (call $world (local.get $request)))
  (local.set $records (call $journal_records (local.get $journal_bytes) (local.get $journal_length)))
  (if (global.get $halt) (then (call $side_answer (i32.const 0)) (return)))
  (if (i32.eqz (call $fold (local.get $records))) (then (call $side_answer (i32.const 0)) (return)))
  (local.set $state (call $state_before (i64.add (call $last_finished) (i64.const 1))))
  (if (i32.eqz (local.get $state)) (then (call $side_answer (i32.const 0)) (return)))
  (global.set $halt (i32.const 0))
  (call $side_run (local.get $asked) (local.get $state)))
