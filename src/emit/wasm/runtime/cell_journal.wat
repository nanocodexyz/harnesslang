      (local.set $folded (call $log_cell (local.get $log) (i64.load offset=16 (local.get $origin))))
      (if (i32.eqz (local.get $folded)) (then (return (call $fold_fail (i32.const $c_fold_origin)))))
      (return (call $cell_log_apply (local.get $folded) (local.get $update)))))
  (if (i64.lt_u (local.get $cell) (call $next_cell_of_session)) (then (return (call $fold_fail (i32.const $c_fold_order)))))
  (global.set $record_failed (i32.const 0))
  (call $header_origin (local.get $update))
  (if (global.get $record_failed) (then (return (call $fold_fail (i32.const $c_fold_start)))))
  (if (global.get $id_is_nested) (then (return (call $fold_fail (i32.const $c_fold_nested_origin)))))
  (local.set $turn (global.get $id_turn))
  (local.set $seq (global.get $id_seq))
  (local.set $log (call $running (local.get $turn)))
  (if (i32.eqz (local.get $log)) (then (return (i32.const 0))))
  (local.set $site (call $log_site (local.get $log) (local.get $seq)))
  (if (i32.eqz (local.get $site)) (then (return (call $fold_fail (i32.const $c_fold_site)))))
  (if (i32.ne (i32.load offset=8 (local.get $site)) (global.get $SITE_OPEN)) (then (return (call $fold_fail (i32.const $c_fold_site)))))
  (if (call $log_cell (local.get $log) (local.get $seq)) (then (return (call $fold_fail (i32.const $c_fold_twice)))))
  (local.set $folded (call $cell_log_start (local.get $update)))
  (if (i32.eqz (local.get $folded)) (then (return (i32.const 0))))
  (call $log_cell_put (local.get $log) (local.get $seq) (local.get $folded))
  (local.set $origin (call $vec_push (global.get $cell_origins)))
  (i64.store (local.get $origin) (local.get $cell))
  (i64.store offset=8 (local.get $origin) (local.get $turn))
  (i64.store offset=16 (local.get $origin) (local.get $seq))
  (i32.const 1))
(func $cell_fold_live (param $record i32) (local $update i32) (local $cell i32)
  (local.set $update (i32.load offset=28 (local.get $record)))
  (if (i32.load offset=24 (local.get $record))
    (then
      (call $header_origin (local.get $update))
      (local.set $cell (call $cell_log_start (local.get $update)))
      (call $assert (i32.ne (local.get $cell) (i32.const 0)) (i32.const $c_live_fold))
      (call $log_cell_put (global.get $log) (global.get $id_seq) (local.get $cell))
      (return)))
  (local.set $cell (call $log_cell_by_id (global.get $log) (i64.load offset=8 (local.get $record))))
  (call $assert (i32.ne (local.get $cell) (i32.const 0)) (i32.const $c_live_fold))
  (call $assert (call $cell_log_apply (local.get $cell) (local.get $update)) (i32.const $c_live_fold)))
(func $apply_nested_call (param $log i32) (param $record i32) (result i32) (local $seq i64) (local $nested i64) (local $cell i32) (local $site i32) (local $vec i32) (local $index i32) (local $entry i32) (local $continued i32) (local $sites i32)
  (local.set $seq (i64.load offset=16 (local.get $record)))
  (local.set $nested (i64.load offset=40 (local.get $record)))
  (local.set $cell (call $log_cell (local.get $log) (local.get $seq)))
  (local.set $sites (call $log_sites (local.get $log)))
  (if (i32.and (i32.ne (local.get $cell) (i32.const 0)) (i32.ne (call $vec_count (local.get $sites)) (i32.const 0)))
    (then
      (local.set $continued (i32.and (i32.eqz (call $cell_log_finished (local.get $cell)))
        (i32.eq (i32.load offset=8 (call $vec_at (local.get $sites) (i32.sub (call $vec_count (local.get $sites)) (i32.const 1)))) (global.get $SITE_OPEN))))))
  (local.set $site (call $log_site (local.get $log) (local.get $seq)))
  (if (i32.eqz (local.get $continued))
    (then
      (if (i32.or (i32.eqz (local.get $site)) (i32.ne (i32.load offset=8 (local.get $site)) (global.get $SITE_OPEN)))
        (then (return (call $fold_fail (i32.const $c_fold_nested_site)))))))
  (local.set $vec (call $log_nested (local.get $log)))
  block $checked
    loop $next
      (br_if $checked (i32.ge_u (local.get $index) (call $vec_count (local.get $vec))))
      (local.set $entry (call $vec_at (local.get $vec) (local.get $index)))
      (if (i32.and (i64.eq (i64.load (local.get $entry)) (local.get $seq)) (i64.ge_u (i64.load offset=8 (local.get $entry)) (local.get $nested)))
        (then (return (call $fold_fail (i32.const $c_fold_nested_order)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (call $nested_put (local.get $log) (local.get $seq) (local.get $nested)
    (call $call_new (i32.load offset=24 (local.get $record)) (i32.load offset=28 (local.get $record)) (i32.load offset=32 (local.get $record))))
  (i32.const 1))
(func $apply_nested_result (param $log i32) (param $record i32) (result i32) (local $entry i32)
  (local.set $entry (call $nested_find (local.get $log) (i64.load offset=16 (local.get $record)) (i64.load offset=40 (local.get $record))))
  (if (i32.eqz (local.get $entry)) (then (return (call $fold_fail (i32.const $c_fold_nested_close)))))
  (if (i32.ne (i32.load offset=16 (local.get $entry)) (global.get $SITE_OPEN)) (then (return (call $fold_fail (i32.const $c_fold_nested_close)))))
  (i32.store offset=16 (local.get $entry) (global.get $SITE_DONE))
  (i32.store offset=24 (local.get $entry) (i32.load offset=24 (local.get $record)))
  (i32.const 1))
(func $recover_nested_all (param $log i32) (param $pairs i32) (result i32) (local $index i32) (local $pair i32) (local $entry i32)
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $pairs))))
      (local.set $pair (call $vec_at (local.get $pairs) (local.get $index)))
      (local.set $entry (call $nested_find (local.get $log) (i64.load (local.get $pair)) (i64.load offset=8 (local.get $pair))))
      (if (i32.eqz (local.get $entry)) (then (return (call $fold_fail (i32.const $c_fold_nested_recover)))))
      (if (i32.ne (i32.load offset=16 (local.get $entry)) (global.get $SITE_OPEN)) (then (return (call $fold_fail (i32.const $c_fold_nested_recover)))))
      (if (i32.ne (call $call_effect (i32.load offset=20 (local.get $entry))) (global.get $EFFECT_EXTERNAL)) (then (return (call $fold_fail (i32.const $c_fold_nested_recover)))))
      (i32.store offset=16 (local.get $entry) (global.get $SITE_UNKNOWN))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 1))
(func $recover_nested_at_load (param $log i32) (result i32) (local $pairs i32) (local $vec i32) (local $index i32) (local $entry i32) (local $pair i32)
  (local.set $pairs (call $vec_new (global.get $PAIR_BYTES)))
  (if (call $target_in_step) (then (return (local.get $pairs))))
  (local.set $vec (call $log_nested (local.get $log)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $vec))))
      (local.set $entry (call $vec_at (local.get $vec) (local.get $index)))
      (if (i32.and (i32.eq (i32.load offset=16 (local.get $entry)) (global.get $SITE_OPEN))
                   (i32.eq (call $call_effect (i32.load offset=20 (local.get $entry))) (global.get $EFFECT_EXTERNAL)))
        (then
          (i32.store offset=16 (local.get $entry) (global.get $SITE_UNKNOWN))
          (local.set $pair (call $vec_push (local.get $pairs)))
          (i64.store (local.get $pair) (i64.load (local.get $entry)))
          (i64.store offset=8 (local.get $pair) (i64.load offset=8 (local.get $entry)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $pairs))
