(func $cell_preempted (param $code i32) (result i32)
  (call $cancel_seen (local.get $code)))
(func $cell_changed (param $call i32) (local $state i32) (local $known i32) (local $id i64)
  (if (i32.eqz (global.get $c_live)) (then (return)))
  (local.set $id (i64.load (local.get $call)))
  (local.set $state (call $cell_call_state (local.get $call)))
  (local.set $known (call $id_map_find (global.get $c_journaled) (local.get $id)))
  (if (local.get $known)
    (then
      (if (call $json_equal (i32.load offset=8 (local.get $known)) (local.get $state))
        (then (call $id_map_remove (global.get $c_changed) (local.get $id)) (return)))))
  (call $id_map_put (global.get $c_changed) (local.get $id) (call $cell_journaled_call (local.get $call) (local.get $state))))
(func $cell_header_node (result i32) (local $node i32)
  (local.set $node (call $obj (i32.const 8)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $k_max_output_tokens) (i32.const $json_null))
  (call $json_object_set (local.get $node) (i32.const 1) (i32.const $s_origin_call_id) (call $str (global.get $c_origin)))
  (call $json_object_set (local.get $node) (i32.const 2) (i32.const $k_prelude) (i32.const $json_false))
  (call $json_object_set (local.get $node) (i32.const 3) (i32.const $s_script) (call $str (global.get $c_site_script)))
  (call $json_object_set (local.get $node) (i32.const 4) (i32.const $k_stored) (call $obj (i32.const 0)))
  (call $json_object_set (local.get $node) (i32.const 5) (i32.const $k_tools) (call $json_parse (i32.load offset=64 (global.get $c_code))))
  (call $json_object_set (local.get $node) (i32.const 6) (i32.const $s_version) (call $num (global.get $CELL_JOURNAL_VERSION)))
  (call $json_object_set (local.get $node) (i32.const 7) (i32.const $k_yield_time_ms) (call $num (call $code_yield_ms)))
  (call $obj_done (local.get $node)))
(func $cell_update_node (param $cell i64) (param $seq i64) (param $header i32) (param $entries_from i64) (param $entries i32) (param $calls i32) (param $finished i32) (result i32) (local $node i32) (local $at i32)
  (local.set $node (call $obj (i32.add (global.get $UPDATE_KEYS_ALWAYS) (i32.add (i32.ne (local.get $header) (i32.const 0)) (local.get $finished)))))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $s_calls) (local.get $calls))
  (call $json_object_set (local.get $node) (i32.const 1) (i32.const $s_cell_id) (call $num (local.get $cell)))
  (call $json_object_set (local.get $node) (i32.const 2) (i32.const $s_content_returned) (call $num (i64.const 0)))
  (call $json_object_set (local.get $node) (i32.const 3) (i32.const $s_entries) (local.get $entries))
  (call $json_object_set (local.get $node) (i32.const 4) (i32.const $s_entries_from) (call $num (local.get $entries_from)))
  (call $json_object_set (local.get $node) (i32.const 5) (i32.const $s_seq) (call $num (local.get $seq)))
  (call $json_object_set (local.get $node) (i32.const 6) (i32.const $s_session_id) (call $str (i32.load (i32.const $program))))
  (local.set $at (global.get $UPDATE_KEYS_ALWAYS))
  (if (local.get $header)
    (then
      (call $json_object_set (local.get $node) (local.get $at) (i32.const $s_header) (local.get $header))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))))
  (if (local.get $finished)
    (then (call $json_object_set (local.get $node) (local.get $at) (i32.const $s_finished) (i32.const $json_true))))
  (call $obj_done (local.get $node)))
(func $append_cell (param $cell i64) (param $fresh i32) (param $update i32) (local $text i32)
  (local.set $text (call $json_encode (call $obj1 (i32.const $s_cell_tag)
    (call $obj4 (i32.const $s_cell_tag) (call $num (local.get $cell)) (i32.const $s_fresh) (call $json_bool (local.get $fresh))
      (i32.const $s_session) (call $str (i32.load (i32.const $program))) (i32.const $s_update) (local.get $update)))))
  (call $append (local.get $text))
  (if (i32.and (global.get $live) (call $cells_yield))
    (then (call $cell_fold_live (call $record_from (call $json_parse (local.get $text)))))))
(func $cell_emit (param $finished i32) (local $header i32) (local $entries i32) (local $calls i32) (local $index i32) (local $count i32) (local $node i32) (local $fresh i32)
  (local.set $header (global.get $c_header))
  (global.set $c_header (i32.const 0))
  (if (i32.and (i32.and (i32.eqz (call $vec_count (global.get $c_fresh))) (i32.eqz (call $vec_count (global.get $c_changed))))
               (i32.and (i32.eqz (local.get $header)) (i32.eqz (local.get $finished))))
    (then (return)))
  (local.set $count (call $vec_count (global.get $c_fresh)))
  (local.set $entries (call $json_array (local.get $count)))
  block $entries_done
    loop $entry
      (br_if $entries_done (i32.ge_u (local.get $index) (local.get $count)))
      (call $json_array_set (local.get $entries) (local.get $index) (i32.load (call $vec_at (global.get $c_fresh) (local.get $index))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $entry
    end
  end
  (global.set $c_fresh (call $vec_new (i32.const 4)))
  (local.set $calls (call $json_array (call $vec_count (global.get $c_changed))))
  (local.set $index (i32.const 0))
  block $calls_done
    loop $call
      (br_if $calls_done (i32.ge_u (local.get $index) (call $vec_count (global.get $c_changed))))
      (local.set $node (i32.load offset=8 (call $vec_at (global.get $c_changed) (local.get $index))))
      (call $json_array_set (local.get $calls) (local.get $index) (local.get $node))
      (call $id_map_put (global.get $c_journaled) (i64.load (call $vec_at (global.get $c_changed) (local.get $index))) (call $json_get (local.get $node) (i32.const $k_state)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $call
    end
  end
  (global.set $c_changed (call $vec_new (global.get $CELL_ENTRY_BYTES)))
  (local.set $fresh (i32.ne (local.get $header) (i32.const 0)))
  (call $assert (i32.eq (local.get $fresh) (i64.eq (global.get $c_next_seq) (global.get $CELL_FIRST_SEQ))) (i32.const $k_header_first))
  (local.set $node (call $cell_update_node (global.get $c_cell) (global.get $c_next_seq) (local.get $header)
    (i64.sub (global.get $c_entries) (i64.extend_i32_u (local.get $count))) (local.get $entries) (local.get $calls) (local.get $finished)))
  (global.set $c_next_seq (i64.add (global.get $c_next_seq) (i64.const 1)))
  (call $append_cell (global.get $c_cell) (local.get $fresh) (local.get $node)))
(func $cell_interrupt (param $kind i32) (param $reason i32) (result i32)
  (global.set $c_interrupt (local.get $kind))
  (global.set $c_reason (local.get $reason))
  (i32.const 0))
(func $cell_diverged (param $reason i32) (result i32)
  (call $observe_diverged (local.get $reason))
  (call $cell_interrupt (global.get $INTERRUPT_DIVERGED) (local.get $reason)))
(func $cell_hook (param $point i32) (param $effect i32)
  (call $hook (local.get $point) (i32.const 0) (local.get $effect)))
(func $cell_record (param $step i32) (result i32) (local $recorded i32) (local $entry i32)
  (if (i32.lt_u (global.get $c_cursor) (call $vec_count (global.get $c_replay)))
    (then
      (local.set $recorded (i32.load (call $vec_at (global.get $c_replay) (global.get $c_cursor))))
      (if (i32.or (call $entry_is_input (local.get $recorded)) (i32.eqz (call $entry_same_step (local.get $recorded) (local.get $step))))
        (then
          (return (call $cell_diverged (call $text_concat (call $wrapped (i32.const $k_took_open) (call $entry_describe (local.get $step)) (i32.const $k_where_holds))
            (call $entry_describe (local.get $recorded)))))))
      (global.set $c_cursor (i32.add (global.get $c_cursor) (i32.const 1)))
      (if (i32.eq (global.get $c_cursor) (call $vec_count (global.get $c_replay)))
        (then
          (call $cell_go_live)
          (if (global.get $c_interrupt) (then (return (i32.const 0))))))
      (return (local.get $recorded))))
  (call $cell_go_live)
  (if (global.get $c_interrupt) (then (return (i32.const 0))))
  (local.set $entry (call $cell_fill (local.get $step)))
  (call $cell_append_entry (local.get $entry))
  (if (global.get $c_interrupt) (then (return (i32.const 0))))
  (local.get $entry))
(func $cell_fill (param $step i32) (result i32) (local $kind i32) (local $length i32) (local $data i32) (local $at i32) (local $word i64)
  (local.set $kind (call $entry_kind (local.get $step)))
  (if (call $text_eq (local.get $kind) (i32.const $k_kind_timeout))
    (then (return (call $entry_timeout (call $entry_id (local.get $step)) (call $field_u64 (local.get $step) (i32.const $k_delay_ms)) (call $cell_clock)))))
  (if (i32.or (call $text_eq (local.get $kind) (i32.const $k_kind_clock)) (call $text_eq (local.get $kind) (i32.const $k_kind_monotonic)))
    (then (return (call $entry_value (local.get $kind) (call $num (call $cell_clock))))))
  (if (call $text_eq (local.get $kind) (i32.const $k_kind_random))
    (then (return (call $entry_value (local.get $kind) (call $json_fraction (i64.shr_u (call $host_random) (global.get $RANDOM_TOP_SHIFT)))))))
  (if (i32.eqz (call $text_eq (local.get $kind) (i32.const $k_kind_bytes))) (then (return (local.get $step))))
  (local.set $length (call $json_count (call $json_get (local.get $step) (i32.const $s_data))))
  (local.set $data (call $json_array (local.get $length)))
  block $filled
    loop $next
      (br_if $filled (i32.ge_u (local.get $at) (local.get $length)))
      (if (i32.eqz (i32.rem_u (local.get $at) (global.get $RANDOM_WORD_BYTES))) (then (local.set $word (call $host_random))))
      (call $json_array_set (local.get $data) (local.get $at) (call $num (i64.and (local.get $word) (global.get $RANDOM_BYTE_MASK))))
      (local.set $word (i64.shr_u (local.get $word) (global.get $RANDOM_BYTE_SHIFT)))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (call $entry_bytes (local.get $data)))
(func $cell_append_entry (param $entry i32)
  (call $assert (global.get $c_live) (i32.const $k_cell_live))
  (global.set $c_bytes (i64.add (global.get $c_bytes) (call $entry_bytes_count (local.get $entry))))
  (if (i64.gt_u (global.get $c_bytes) (call $code_journal_bytes))
    (then (drop (call $cell_interrupt (global.get $INTERRUPT_OVERFLOW) (i32.const 0))) (return)))
  (i32.store (call $vec_push (global.get $c_fresh)) (local.get $entry))
  (global.set $c_entries (i64.add (global.get $c_entries) (i64.const 1)))
  (call $cell_hook (global.get $POINT_CELL_ENTRY) (i32.const 0)))
