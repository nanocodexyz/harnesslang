(func $type_kind (param $type i32) (result i32) (i32.load (local.get $type)))
(func $type_name (param $type i32) (result i32) (local $kind i32) (local $buffer i32)
  (local.set $kind (call $type_kind (local.get $type)))
  (if (i32.eq (local.get $kind) (global.get $TYPE_U64)) (then (return (i32.const $s_u64))))
  (if (i32.eq (local.get $kind) (global.get $TYPE_BOOL)) (then (return (i32.const $s_bool))))
