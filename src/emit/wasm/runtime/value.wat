(func $list_keep (param $list i64) (param $count i64) (param $has_first i32) (param $first i64) (param $capacity i64) (param $name i32) (result i64) (local $length i32) (local $kept i32) (local $buffer i32) (local $at i32)
  (local.set $length (call $list_len (local.get $list)))
  (local.set $kept (local.get $length))
  (if (i64.lt_u (local.get $count) (i64.extend_i32_u (local.get $length))) (then (local.set $kept (i32.wrap_i64 (local.get $count)))))
