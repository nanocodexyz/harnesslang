(global $DELIVERY_CANCEL i32 (i32.const 0))
(global $DELIVERY_STEER i32 (i32.const 1))
(global $DELIVERY_JOB i32 (i32.const 2))
(global $DELIVERY_BYTES i32 (i32.const 20))
(global $EVENT_BYTES i32 (i32.const 16))
(global $ANSWER_RECORDED i32 (i32.const 0))
(global $ANSWER_DUPLICATE i32 (i32.const 1))
(global $ANSWER_FULL i32 (i32.const 2))
(global $ANSWER_UNDECLARED i32 (i32.const 3))
(global $ANSWER_FINISHED i32 (i32.const 4))
(global $DRAIN_AFTER_RUN i32 (i32.const 0))
(global $DRAIN_AFTER_FLUSH i32 (i32.const 1))
(global $HALT_SUSPEND i32 (i32.const 3))
(global $KIND_WAIT i32 (i32.const 7))
(global $KIND_HOLD i32 (i32.const 8))
(global $KIND_SUSPEND i32 (i32.const 9))
(global $KIND_DENY i32 (i32.const 10))
(global $last_event (mut i64) (i64.const 0))
(global $taken (mut i32) (i32.const 0))
(global $finishing (mut i32) (i32.const 0))
