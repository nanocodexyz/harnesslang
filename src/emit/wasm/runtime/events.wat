(global $suspended_key (mut i32) (i32.const 0))
(text $e_event "event")
(text $e_inbox "inbox")
(text $e_answer "answer")
(text $e_answers "answers")
(text $e_position "position")
(text $e_clock "clock")
(text $e_sleep "sleep")
(text $e_until "until")
(text $e_ms "ms")
(text $e_key "key")
(text $e_resume "resume")
(text $e_resumed "resumed")
(text $e_matched "matched")
(text $e_optional "optional")
(text $e_cancel "cancel")
(text $e_steer "steer")
(text $e_job "job")
(text $e_message "message")
(text $e_notice "notice")
(text $e_done "done")
(text $e_at "at")
(text $e_reason "reason")
(text $e_wait "wait")
(text $e_hold "hold")
(text $e_suspend "suspend")
(text $e_deny "deny")
(text $e_recorded "recorded")
(text $e_duplicate "duplicate")
(text $e_full "full")
(text $e_undeclared "undeclared")
(text $e_finished "finished")
(text $e_x_suspended "{\"exit\":\"suspended\",\"seq\":")
(text $e_fold_event_order "an event follows a later event")
(text $e_fold_event_at "an event is at a seq before the event recorded ahead of it")
(text $e_fold_event_twice "an event is recorded twice")
(text $e_fold_second_cancel "a turn records a second cancel")
(text $e_fold_job "an event notes a job that is not running")
(text $e_not_taken "a turn records an event the program does not take")
(text $e_steers_over "a turn records more steers than its bound")
(text $e_not_delivery "the host's inbox answer holds a delivery that does not decode")
(text $e_not_inbox "the host's inbox answer is not a list of deliveries")
(text $e_only_events "a step boundary leaves only event records to append")
(text $e_seen_grow "the events a turn sees only grow")
(text $e_suspend_durable "a suspend's call record is durable before the turn waits")
(text $e_resume_durable "a resume's result is durable before it is answered")
(text $e_suspend_key "a suspend's input lacks its key")
(text $e_wait_until "a wait's input lacks its deadline")
(text $e_wait_ms "a wait's input holds its duration")
(text $e_wait_overflow "the clock plus the wait's ms passes u64")
(text $e_parked_kind "a parked call is a wait, hold, suspend or deny")
(text $e_record_prefix "{\"event\":")
(words $keys_event 4 $e_at $e_event $s_seq $s_turn)
(words $keys_cancel 1 $s_id)
(words $keys_steer 2 $s_id $e_message)
(words $keys_job 4 $e_done $s_id $e_key $e_notice)
(func $events_cancel (result i32) (i32.load (i32.const $events)))
(func $events_steers (result i32) (i32.load offset=4 (i32.const $events)))
(func $events_steers_max (result i64) (i64.extend_i32_u (i32.load offset=8 (i32.const $events))))
(func $events_jobs (result i32) (i32.load offset=12 (i32.const $events)))
(func $events_records_max (result i64) (i64.extend_i32_u (i32.load offset=20 (i32.const $events))))
(func $events_drain (result i32) (i32.load offset=24 (i32.const $events)))
(func $events_any (result i32)
  (i32.or (call $events_cancel) (i32.or (call $events_steers) (call $events_jobs))))
(func $delivery_kind (param $delivery i32) (result i32) (i32.load (local.get $delivery)))
(func $delivery_id (param $delivery i32) (result i32) (i32.load offset=4 (local.get $delivery)))
(func $delivery_message (param $delivery i32) (result i32) (i32.load offset=8 (local.get $delivery)))
(func $delivery_from (param $node i32) (result i32) (local $name i32) (local $body i32) (local $delivery i32) (local $done i32)
  (if (i32.eqz (call $json_tagged (local.get $node))) (then (return (i32.const 0))))
  (local.set $name (call $json_key (local.get $node) (i32.const 0)))
  (local.set $body (call $json_value (local.get $node) (i32.const 0)))
  (local.set $delivery (call $alloc (global.get $DELIVERY_BYTES)))
  (block $decoded
    (if (call $text_eq (local.get $name) (i32.const $e_cancel))
      (then
        (if (i32.eqz (call $exact (local.get $body) (i32.const $keys_cancel))) (then (return (i32.const 0))))
        (i32.store (local.get $delivery) (global.get $DELIVERY_CANCEL))
        (br $decoded)))
    (if (call $text_eq (local.get $name) (i32.const $e_steer))
      (then
        (if (i32.eqz (call $exact (local.get $body) (i32.const $keys_steer))) (then (return (i32.const 0))))
        (i32.store (local.get $delivery) (global.get $DELIVERY_STEER))
        (i32.store offset=8 (local.get $delivery) (call $field_text (local.get $body) (i32.const $e_message)))
        (br $decoded)))
    (if (call $text_eq (local.get $name) (i32.const $e_job))
      (then
        (if (i32.eqz (call $exact (local.get $body) (i32.const $keys_job))) (then (return (i32.const 0))))
        (local.set $done (call $json_get (local.get $body) (i32.const $e_done)))
        (if (i32.and (i32.ne (call $json_tag (local.get $done)) (global.get $JSON_TRUE)) (i32.ne (call $json_tag (local.get $done)) (global.get $JSON_FALSE)))
          (then (return (i32.const 0))))
        (i32.store (local.get $delivery) (global.get $DELIVERY_JOB))
        (i32.store offset=8 (local.get $delivery) (call $field_text (local.get $body) (i32.const $e_notice)))
        (i32.store offset=12 (local.get $delivery) (call $field_text (local.get $body) (i32.const $e_key)))
        (i32.store offset=16 (local.get $delivery) (i32.eq (call $json_tag (local.get $done)) (global.get $JSON_TRUE)))
        (br $decoded)))
    (return (i32.const 0)))
  (i32.store offset=4 (local.get $delivery) (call $field_text (local.get $body) (i32.const $s_id)))
  (local.get $delivery))
(func $delivery_json (param $delivery i32) (result i32) (local $body i32) (local $kind i32)
  (local.set $kind (call $delivery_kind (local.get $delivery)))
  (if (i32.eq (local.get $kind) (global.get $DELIVERY_CANCEL))
    (then (return (call $json_one (i32.const $e_cancel) (call $json_one (i32.const $s_id) (call $json_string (call $delivery_id (local.get $delivery))))))))
  (if (i32.eq (local.get $kind) (global.get $DELIVERY_STEER))
    (then
      (local.set $body (call $json_object (i32.const 2)))
      (call $json_object_set (local.get $body) (i32.const 0) (i32.const $s_id) (call $json_string (call $delivery_id (local.get $delivery))))
      (call $json_object_set (local.get $body) (i32.const 1) (i32.const $e_message) (call $json_string (call $delivery_message (local.get $delivery))))
      (return (call $json_one (i32.const $e_steer) (local.get $body)))))
  (local.set $body (call $json_object (i32.const 4)))
  (call $json_object_set (local.get $body) (i32.const 0) (i32.const $e_done) (call $json_bool (i32.load offset=16 (local.get $delivery))))
  (call $json_object_set (local.get $body) (i32.const 1) (i32.const $s_id) (call $json_string (call $delivery_id (local.get $delivery))))
  (call $json_object_set (local.get $body) (i32.const 2) (i32.const $e_key) (call $json_string (i32.load offset=12 (local.get $delivery))))
  (call $json_object_set (local.get $body) (i32.const 3) (i32.const $e_notice) (call $json_string (call $delivery_message (local.get $delivery))))
  (call $json_one (i32.const $e_job) (local.get $body)))
(func $record_event (param $turn i64) (param $seq i64) (param $at i64) (param $delivery i32) (result i32) (local $body i32)
  (local.set $body (call $json_object (i32.const 4)))
  (call $json_object_set (local.get $body) (i32.const 0) (i32.const $e_at) (call $json_number (local.get $at)))
  (call $json_object_set (local.get $body) (i32.const 1) (i32.const $e_event) (call $delivery_json (local.get $delivery)))
  (call $json_object_set (local.get $body) (i32.const 2) (i32.const $s_seq) (call $json_number (local.get $seq)))
  (call $json_object_set (local.get $body) (i32.const 3) (i32.const $s_turn) (call $json_string (call $u64_text (local.get $turn))))
  (call $json_encode (call $json_one (i32.const $e_event) (local.get $body))))
(func $event_from (param $body i32) (param $record i32) (local $delivery i32)
  (if (i32.eqz (call $exact (local.get $body) (i32.const $keys_event))) (then (global.set $record_failed (i32.const 1)) (return)))
  (i32.store (local.get $record) (global.get $RECORD_EVENT))
  (call $record_turn_text (local.get $body) (local.get $record))
  (i64.store offset=16 (local.get $record) (call $field_number (local.get $body) (i32.const $s_seq)))
  (i64.store offset=40 (local.get $record) (call $field_number (local.get $body) (i32.const $e_at)))
  (local.set $delivery (call $delivery_from (call $json_get (local.get $body) (i32.const $e_event))))
  (if (i32.eqz (local.get $delivery)) (then (global.set $record_failed (i32.const 1)) (return)))
  (i32.store offset=24 (local.get $record) (local.get $delivery)))
(func $log_events (param $log i32) (result i32) (i32.load offset=24 (local.get $log)))
(func $event_at (param $event i32) (result i64) (i64.load (local.get $event)))
(func $event_delivery (param $event i32) (result i32) (i32.load offset=8 (local.get $event)))
(func $event_push (param $log i32) (param $at i64) (param $delivery i32) (local $event i32)
  (local.set $event (call $vec_push (call $log_events (local.get $log))))
  (i64.store (local.get $event) (local.get $at))
  (i32.store offset=8 (local.get $event) (local.get $delivery)))
(func $events_recorded (param $log i32) (param $id i32) (result i32) (local $events i32) (local $index i32)
  (local.set $events (call $log_events (local.get $log)))
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $vec_count (local.get $events))))
      (if (call $text_eq (call $delivery_id (call $event_delivery (call $vec_at (local.get $events) (local.get $index)))) (local.get $id))
        (then (return (i32.const 1))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $events_counted (param $log i32) (param $kind i32) (param $visible i32) (result i32) (local $events i32) (local $index i32) (local $count i32) (local $event i32)
  (local.set $events (call $log_events (local.get $log)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $events))))
      (local.set $event (call $vec_at (local.get $events) (local.get $index)))
      (if (i32.and (i32.eq (call $delivery_kind (call $event_delivery (local.get $event))) (local.get $kind))
                   (i32.or (i32.eqz (local.get $visible)) (i64.le_u (call $event_at (local.get $event)) (global.get $seq))))
        (then (local.set $count (i32.add (local.get $count) (i32.const 1)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $count))
(func $apply_event (param $log i32) (param $record i32) (result i32) (local $seq i64) (local $at i64) (local $delivery i32) (local $events i32)
  (local.set $seq (i64.load offset=16 (local.get $record)))
  (local.set $at (i64.load offset=40 (local.get $record)))
  (local.set $delivery (i32.load offset=24 (local.get $record)))
  (local.set $events (call $log_events (local.get $log)))
  (if (i64.le_u (local.get $seq) (global.get $last_event)) (then (return (call $fold_fail (i32.const $e_fold_event_order)))))
  (if (call $vec_count (local.get $events))
    (then
      (if (i64.lt_u (local.get $at) (call $event_at (call $vec_at (local.get $events) (i32.sub (call $vec_count (local.get $events)) (i32.const 1)))))
        (then (return (call $fold_fail (i32.const $e_fold_event_at)))))))
  (if (call $events_recorded (local.get $log) (call $delivery_id (local.get $delivery))) (then (return (call $fold_fail (i32.const $e_fold_event_twice)))))
  (if (i32.and (i32.eq (call $delivery_kind (local.get $delivery)) (global.get $DELIVERY_CANCEL))
               (i32.ne (call $events_counted (local.get $log) (global.get $DELIVERY_CANCEL) (i32.const 0)) (i32.const 0)))
    (then (return (call $fold_fail (i32.const $e_fold_second_cancel)))))
  (if (i32.eq (call $delivery_kind (local.get $delivery)) (global.get $DELIVERY_JOB))
    (then (if (i32.eqz (call $fold_job_event (local.get $delivery))) (then (return (i32.const 0))))))
  (call $event_push (local.get $log) (local.get $at) (local.get $delivery))
  (global.set $last_event (local.get $seq))
  (i32.const 1))
(func $check_events (param $log i32) (result i32) (local $events i32) (local $index i32) (local $kind i32) (local $taken i32)
  (local.set $events (call $log_events (local.get $log)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $events))))
      (local.set $kind (call $delivery_kind (call $event_delivery (call $vec_at (local.get $events) (local.get $index)))))
      (local.set $taken (call $events_jobs))
      (if (i32.eq (local.get $kind) (global.get $DELIVERY_CANCEL)) (then (local.set $taken (call $events_cancel))))
      (if (i32.eq (local.get $kind) (global.get $DELIVERY_STEER)) (then (local.set $taken (call $events_steers))))
      (if (i32.eqz (local.get $taken)) (then (call $corrupt (i32.const $e_not_taken)) (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (if (i32.and (call $events_steers)
               (i64.gt_u (i64.extend_i32_u (call $events_counted (local.get $log) (global.get $DELIVERY_STEER) (i32.const 0))) (call $events_steers_max)))
    (then (call $corrupt (i32.const $e_steers_over)) (return (i32.const 0))))
  (call $check_jobs (local.get $log)))
(func $event_seq (param $index i64) (result i64) (local $earlier i64) (local $records i64)
  (if (i64.eqz (global.get $turn)) (then (return (i64.const 0))))
  (local.set $earlier (i64.sub (global.get $turn) (i64.const 1)))
  (local.set $records (call $events_records_max))
  (if (i32.and (i64.ne (local.get $records) (i64.const 0)) (i64.gt_u (local.get $earlier) (i64.div_u (global.get $U64_MAX) (local.get $records))))
    (then (return (i64.const 0))))
  (local.set $earlier (i64.mul (local.get $earlier) (local.get $records)))
  (if (i64.gt_u (local.get $index) (i64.sub (global.get $U64_MAX) (local.get $earlier))) (then (return (i64.const 0))))
  (i64.add (local.get $earlier) (local.get $index)))
(func $admit (param $position i64) (param $delivery i32) (result i32) (local $kind i32) (local $seq i64) (local $answer i32)
  (if (call $events_recorded (global.get $log) (call $delivery_id (local.get $delivery))) (then (return (global.get $ANSWER_DUPLICATE))))
  (local.set $kind (call $delivery_kind (local.get $delivery)))
  (if (i32.eq (local.get $kind) (global.get $DELIVERY_CANCEL))
    (then
      (if (i32.eqz (call $events_cancel)) (then (return (global.get $ANSWER_UNDECLARED))))
      (if (call $events_counted (global.get $log) (global.get $DELIVERY_CANCEL) (i32.const 0)) (then (return (global.get $ANSWER_DUPLICATE))))))
  (if (i32.eq (local.get $kind) (global.get $DELIVERY_STEER))
    (then
      (if (i32.eqz (call $events_steers)) (then (return (global.get $ANSWER_UNDECLARED))))
      (if (i64.ge_u (i64.extend_i32_u (call $events_counted (global.get $log) (global.get $DELIVERY_STEER) (i32.const 0))) (call $events_steers_max))
        (then (return (global.get $ANSWER_FULL))))))
  (if (i32.eq (local.get $kind) (global.get $DELIVERY_JOB))
    (then
      (local.set $answer (call $admit_job (local.get $delivery)))
      (if (i32.ne (local.get $answer) (global.get $ANSWER_RECORDED)) (then (return (local.get $answer))))))
  (local.set $seq (call $event_seq (i64.add (i64.extend_i32_u (call $vec_count (call $log_events (global.get $log)))) (i64.const 1))))
  (if (i64.eqz (local.get $seq)) (then (return (global.get $ANSWER_FULL))))
  (call $append (call $record_event (global.get $turn) (local.get $seq) (local.get $position) (local.get $delivery)))
  (call $event_push (global.get $log) (local.get $position) (local.get $delivery))
  (call $job_admitted (local.get $delivery))
  (global.get $ANSWER_RECORDED))
(func $answer_name (param $answer i32) (result i32)
  (if (i32.eq (local.get $answer) (global.get $ANSWER_RECORDED)) (then (return (i32.const $e_recorded))))
  (if (i32.eq (local.get $answer) (global.get $ANSWER_DUPLICATE)) (then (return (i32.const $e_duplicate))))
  (if (i32.eq (local.get $answer) (global.get $ANSWER_FULL)) (then (return (i32.const $e_full))))
  (if (i32.eq (local.get $answer) (global.get $ANSWER_UNDECLARED)) (then (return (i32.const $e_undeclared))))
  (i32.const $e_finished))
(func $answer_json (param $delivery i32) (param $answer i32) (result i32) (local $node i32)
  (local.set $node (call $json_object (i32.const 2)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $e_answer) (call $json_string (call $answer_name (local.get $answer))))
  (call $json_object_set (local.get $node) (i32.const 1) (i32.const $s_id) (call $json_string (call $delivery_id (local.get $delivery))))
  (local.get $node))
(func $request (param $kind i32) (param $count i32) (result i32) (local $node i32)
  (local.set $node (call $json_object (i32.add (local.get $count) (i32.const 1))))
  (call $json_object_set (local.get $node) (local.get $count) (i32.const $e_event) (call $json_string (local.get $kind)))
  (local.get $node))
(func $inbox (param $turn i64) (result i32) (local $request i32) (local $arrived i32)
  (local.set $request (call $request (i32.const $e_inbox) (i32.const 1)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $s_turn) (call $json_number (local.get $turn)))
  (call $json_object_sort (local.get $request))
  (local.set $arrived (call $json_get (call $world (local.get $request)) (i32.const $e_answer)))
  (call $assert (i32.ne (local.get $arrived) (i32.const 0)) (i32.const $e_not_inbox))
  (call $assert (i32.eq (call $json_tag (local.get $arrived)) (global.get $JSON_ARRAY)) (i32.const $e_not_inbox))
  (local.get $arrived))
(func $inbox_delivery (param $arrived i32) (param $index i32) (result i32) (local $delivery i32)
  (global.set $record_failed (i32.const 0))
  (local.set $delivery (call $delivery_from (call $json_item (local.get $arrived) (local.get $index))))
  (call $assert (i32.ne (local.get $delivery) (i32.const 0)) (i32.const $e_not_delivery))
  (call $assert (i32.eqz (global.get $record_failed)) (i32.const $e_not_delivery))
  (local.get $delivery))
(func $world_answer (param $turn i64) (param $position i64) (param $answers i32) (local $request i32)
  (local.set $request (call $request (i32.const $e_answer) (i32.const 3)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $e_answers) (local.get $answers))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $e_position) (call $json_number (local.get $position)))
  (call $json_object_set (local.get $request) (i32.const 2) (i32.const $s_turn) (call $json_number (local.get $turn)))
  (call $json_object_sort (local.get $request))
  (drop (call $world (local.get $request))))
(func $drain (local $arrived i32) (local $count i32) (local $index i32) (local $answers i32) (local $recorded i32) (local $delivery i32) (local $answer i32) (local $position i64)
  (if (i32.eqz (call $events_any)) (then (return)))
  (if (i32.or (i32.eqz (global.get $live)) (global.get $side)) (then (return)))
  (local.set $arrived (call $inbox (global.get $turn)))
  (local.set $count (call $json_count (local.get $arrived)))
  (if (i32.and (i32.eqz (local.get $count)) (i32.eqz (call $vec_count (global.get $lost)))) (then (return)))
