(global $FORK_NONE i32 (i32.const 0))
(global $FORK_LATEST i32 (i32.const 1))
(global $FORK_TURN i32 (i32.const 2))
(global $ENTRY_REVISION i64 (i64.const 0))
(global $SAVED_BYTES i32 (i32.const 64))
(global $HOOK_TURN i64 (i64.const 0))
(global $DOT i32 (i32.const 46))
(global $scope (mut i32) (i32.const 0))
(global $forked (mut i32) (i32.const 0))
(global $fork_turn (mut i64) (i64.const 0))
(global $fork_discarded (mut i64) (i64.const 0))
(text $s_host "host")
(text $s_key "key")
(text $s_value "value")
(text $s_forked "forked")
(text $s_discarded "discarded")
(text $s_origin "origin")
(text $s_scope "scope")
(text $s_fork_missing_open "no finished turn ")
(text $s_fork_missing_close " to fork from")
(text $s_fork_hook "the prover keeps a state hook from trapping")
(text $s_fold_host "a host record other than a leading forked record")
(text $s_fold_entry "a turn is admitted before the forked session's entry checkpoint")
(words $keys_host 2 $s_key $s_value)
(func $tool_fork (param $tool i32) (result i32) (i32.load offset=20 (local.get $tool)))
(func $host_from (param $body i32) (param $record i32)
  (if (i32.eqz (call $exact (local.get $body) (i32.const $keys_host))) (then (global.set $record_failed (i32.const 1)) (return)))
  (i32.store (local.get $record) (global.get $RECORD_HOST))
  (i32.store offset=24 (local.get $record) (call $field_text (local.get $body) (i32.const $s_key)))
  (i32.store offset=28 (local.get $record) (call $json_get (local.get $body) (i32.const $s_value))))
(func $apply_host (param $record i32) (result i32)
  (if (i32.or (i32.eqz (call $text_eq (i32.load offset=24 (local.get $record)) (i32.const $s_forked)))
        (i32.or (i32.or (call $vec_count (global.get $turns)) (call $vec_count (global.get $checkpoints))) (global.get $forked)))
    (then (return (call $fold_fail (i32.const $s_fold_host)))))
  (global.set $forked (i32.load offset=28 (local.get $record)))
  (i32.const 1))
(func $entry_checkpoint (result i32) (local $index i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $vec_count (global.get $checkpoints))))
      (if (i64.eq (i64.load (call $vec_at (global.get $checkpoints) (local.get $index))) (global.get $ENTRY_REVISION)) (then (return (i32.const 1))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $admit_allowed (result i32)
  (if (i32.and (i32.ne (global.get $forked) (i32.const 0)) (i32.eqz (call $entry_checkpoint)))
    (then (return (call $fold_fail (i32.const $s_fold_entry)))))
  (i32.const 1))
(func $entry_allowed (param $revision i64) (result i32)
  (i32.and (i64.eq (local.get $revision) (global.get $ENTRY_REVISION)) (i32.eqz (call $vec_count (global.get $turns)))))
(func $turn_finished (param $turn i64) (result i32) (local $log i32)
  (local.set $log (call $session_log (local.get $turn)))
  (if (i32.eqz (local.get $log)) (then (return (i32.const 0))))
  (i32.ne (call $log_finished (local.get $log)) (i32.const 0)))
(func $fork_requested (param $at i32) (param $input i32) (result i64) (local $turn i32)
  (if (i32.eq (local.get $at) (global.get $FORK_TURN))
    (then
      (local.set $turn (call $json_get (local.get $input) (i32.const $s_turn)))
      (if (i32.ne (local.get $turn) (i32.const 0))
        (then
          (if (i32.eq (call $json_tag (local.get $turn)) (global.get $JSON_NUMBER))
            (then (return (call $json_number_value (local.get $turn)))))))))
  (i64.const -1))
(func $fork_select (param $requested i64) (result i32) (local $turn i64) (local $index i32) (local $count i64)
  (local.set $turn (select (call $last_finished) (local.get $requested) (i64.eq (local.get $requested) (i64.const -1))))
  (global.set $fork_turn (local.get $turn))
  (if (i32.and (i64.ne (local.get $turn) (global.get $ENTRY_REVISION)) (i32.eqz (call $turn_finished (local.get $turn))))
    (then (return (i32.const 0))))
  (if (i64.eq (local.get $turn) (i64.const -1)) (then (return (i32.const 0))))
  block $counted
    loop $next
      (br_if $counted (i32.ge_u (local.get $index) (call $vec_count (global.get $turns))))
      (if (i32.and (i64.gt_u (i64.add (global.get $turn_first) (i64.extend_i32_u (local.get $index))) (local.get $turn))
                   (i32.ne (call $log_finished (i32.load (call $vec_at (global.get $turns) (local.get $index)))) (i32.const 0)))
        (then (local.set $count (i64.add (local.get $count) (i64.const 1)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (global.set $fork_discarded (local.get $count))
  (i32.const 1))
(func $engine_save (result i32) (local $saved i32)
  (local.set $saved (call $alloc (global.get $SAVED_BYTES)))
  (i32.store (local.get $saved) (global.get $live))
  (i64.store offset=8 (local.get $saved) (global.get $turn))
  (i64.store offset=16 (local.get $saved) (global.get $seq))
  (i32.store offset=24 (local.get $saved) (global.get $log))
  (i64.store offset=32 (local.get $saved) (global.get $attempts))
  (i32.store offset=40 (local.get $saved) (global.get $buffer))
  (i32.store offset=44 (local.get $saved) (global.get $acknowledged))
  (i32.store offset=48 (local.get $saved) (global.get $state))
  (i32.store offset=52 (local.get $saved) (global.get $finish_outcome))
  (i32.store offset=56 (local.get $saved) (global.get $finish_result))
  (local.get $saved))
(func $engine_restore (param $saved i32)
  (global.set $live (i32.load (local.get $saved)))
  (global.set $turn (i64.load offset=8 (local.get $saved)))
  (global.set $seq (i64.load offset=16 (local.get $saved)))
  (global.set $log (i32.load offset=24 (local.get $saved)))
  (global.set $attempts (i64.load offset=32 (local.get $saved)))
  (global.set $buffer (i32.load offset=40 (local.get $saved)))
  (global.set $acknowledged (i32.load offset=44 (local.get $saved)))
  (global.set $state (i32.load offset=48 (local.get $saved)))
  (global.set $finish_outcome (i32.load offset=52 (local.get $saved)))
  (global.set $finish_result (i32.load offset=56 (local.get $saved))))
(func $origin_key (param $turn i64) (param $seq i64) (result i32)
  (call $spawn_key (global.get $scope) (local.get $turn) (local.get $seq)))
(func $tool_spawns (param $tool i32) (result i32) (local $index i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (i32.load (i32.const $spawn_tools))))
      (if (i32.eq (i32.load (i32.add (i32.const $spawn_tools) (i32.shl (i32.add (local.get $index) (i32.const 1)) (i32.const 2)))) (local.get $tool))
        (then (return (i32.const 1))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $spawn_output (param $seq i64) (param $call i32) (param $output i32) (result i32) (local $tool i32)
  (if (i32.ne (call $output_kind (local.get $output)) (global.get $OUTPUT_OK)) (then (return (local.get $output))))
  (local.set $tool (call $program_tool (call $call_tool (local.get $call))))
  (if (i32.eqz (local.get $tool)) (then (return (local.get $output))))
  (if (i32.and (i32.eqz (call $tool_spawns (local.get $tool))) (i32.eq (call $tool_fork (local.get $tool)) (global.get $FORK_NONE)))
    (then (return (local.get $output))))
  (call $output_new (global.get $OUTPUT_OK) (call $json_string (call $spawn_key (global.get $scope) (global.get $turn) (local.get $seq)))))
(func $spawn_key (param $scope i32) (param $turn i64) (param $seq i64) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (if (i32.and (i32.ne (local.get $scope) (i32.const 0)) (i32.ne (call $text_len (local.get $scope)) (i32.const 0)))
    (then
      (call $buf_text (local.get $buffer) (local.get $scope))
      (call $buf_byte (local.get $buffer) (global.get $SLASH))))
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_byte (local.get $buffer) (global.get $DOT))
  (call $buf_u64 (local.get $buffer) (local.get $seq))
  (call $buf_finish (local.get $buffer)))
(func $fork_call (param $seq i64) (param $call i32) (result i32) (local $tool i32) (local $at i32) (local $input i32) (local $saved i32) (local $state i32) (local $origin i32) (local $args i32) (local $filled i32) (local $payload i32)
  (local.set $tool (call $program_tool (call $call_tool (local.get $call))))
  (if (i32.eqz (local.get $tool)) (then (return (local.get $call))))
  (local.set $at (call $tool_fork (local.get $tool)))
  (if (i32.eq (local.get $at) (global.get $FORK_NONE)) (then (return (local.get $call))))
  (local.set $input (call $call_input (local.get $call)))
  (if (i32.ne (call $json_tag (local.get $input)) (global.get $JSON_OBJECT)) (then (return (local.get $call))))
  (if (i32.eqz (call $fork_select (call $fork_requested (local.get $at) (local.get $input)))) (then (return (local.get $call))))
  (local.set $origin (call $origin_key (global.get $turn) (local.get $seq)))
  (local.set $saved (call $engine_save))
  (local.set $state (call $state_before (i64.add (global.get $fork_turn) (i64.const 1))))
  (if (local.get $state)
    (then
      (call $engine_start (i32.const 0) (global.get $HOOK_TURN) (call $log_new (i32.const $s_forked) (i32.const $json_null)) (local.get $state))
      (if (call $program_forked)
        (then
          (local.set $args (call $alloc (i32.const 16)))
          (i64.store (local.get $args) (call $text_value (local.get $origin)))
          (i64.store offset=8 (local.get $args) (global.get $fork_discarded))
          (drop (call $forked_run (local.get $args)))
          (call $assert (i32.eqz (global.get $halt)) (i32.const $s_fork_hook))))
      (local.set $payload (call $json_encode (call $state_json)))))
  (call $engine_restore (local.get $saved))
  (if (i32.eqz (local.get $state)) (then (return (local.get $call))))
  (local.set $filled (call $json_object (i32.const 4)))
  (call $json_object_set (local.get $filled) (i32.const 0) (i32.const $s_discarded) (call $json_number (global.get $fork_discarded)))
  (call $json_object_set (local.get $filled) (i32.const 1) (i32.const $s_origin) (call $json_string (local.get $origin)))
  (call $json_object_set (local.get $filled) (i32.const 2) (i32.const $s_state) (call $json_string (local.get $payload)))
  (call $json_object_set (local.get $filled) (i32.const 3) (i32.const $s_turn) (call $json_number (global.get $fork_turn)))
  (call $call_new (call $call_tool (local.get $call)) (call $call_effect (local.get $call)) (local.get $filled)))
(func $fork_refused (param $call i32) (result i32) (local $tool i32) (local $at i32) (local $input i32) (local $requested i64) (local $buffer i32)
  (local.set $tool (call $program_tool (call $call_tool (local.get $call))))
  (if (i32.eqz (local.get $tool)) (then (return (i32.const 0))))
  (local.set $at (call $tool_fork (local.get $tool)))
  (if (i32.eq (local.get $at) (global.get $FORK_NONE)) (then (return (i32.const 0))))
  (local.set $input (call $call_input (local.get $call)))
  (if (i32.ne (call $json_tag (local.get $input)) (global.get $JSON_OBJECT)) (then (return (i32.const 0))))
  (if (call $json_get (local.get $input) (i32.const $s_state)) (then (return (i32.const 0))))
  (local.set $requested (call $fork_requested (local.get $at) (local.get $input)))
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_fork_missing_open))
  (call $buf_u64 (local.get $buffer) (select (i64.const 0) (local.get $requested) (i64.eq (local.get $requested) (i64.const -1))))
  (call $buf_text (local.get $buffer) (i32.const $s_fork_missing_close))
  (call $buf_finish (local.get $buffer)))
(func $fork_request_of (param $call i32) (result i32) (local $tool i32) (local $at i32) (local $input i32) (local $node i32) (local $turn i32)
  (local.set $input (call $call_input (local.get $call)))
  (local.set $tool (call $program_tool (call $call_tool (local.get $call))))
  (if (i32.eqz (local.get $tool)) (then (return (local.get $input))))
  (local.set $at (call $tool_fork (local.get $tool)))
  (if (i32.eq (local.get $at) (global.get $FORK_NONE)) (then (return (local.get $input))))
  (if (i32.eqz (call $json_get (local.get $input) (i32.const $s_state))) (then (return (local.get $input))))
  (if (i32.eq (local.get $at) (global.get $FORK_LATEST)) (then (return (call $json_object (i32.const 0)))))
  (local.set $turn (call $json_get (local.get $input) (i32.const $s_turn)))
  (local.set $node (call $json_object (i32.const 1)))
  (call $json_object_set (local.get $node) (i32.const 0) (i32.const $s_turn) (select (local.get $turn) (i32.const $json_null) (local.get $turn)))
  (local.get $node))
(func $program_forked (result i32) (i32.load (i32.const $forked_hook)))
