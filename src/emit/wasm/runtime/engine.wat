(func $state_json (result i32) (local $node i32) (local $index i32) (local $field i32)
  (local.set $node (call $json_object (call $program_fields)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $program_fields)))
      (local.set $field (call $program_field (local.get $index)))
      (call $json_object_set (local.get $node) (local.get $index) (i32.load (local.get $field))
        (call $value_to_json (i32.load offset=4 (local.get $field)) (i64.load (i32.add (global.get $state) (i32.shl (local.get $index) (i32.const 3))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
