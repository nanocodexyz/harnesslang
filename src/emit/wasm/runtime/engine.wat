  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $program_fields)))
      (i64.store (i32.add (local.get $state) (i32.shl (local.get $index) (i32.const 3)))
        (call $zero_value (i32.load offset=4 (call $program_field (local.get $index)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $state))
(func $state_from_json (param $node i32) (result i32) (local $state i32) (local $index i32) (local $field i32) (local $value i32)
  (if (i32.ne (call $json_tag (local.get $node)) (global.get $JSON_OBJECT)) (then (return (i32.const 0))))
  (if (i32.ne (call $json_count (local.get $node)) (call $program_fields)) (then (return (i32.const 0))))
  (local.set $state (call $state_new))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $program_fields)))
      (local.set $field (call $program_field (local.get $index)))
      (local.set $value (call $json_get (local.get $node) (i32.load (local.get $field))))
      (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
      (i64.store (i32.add (local.get $state) (i32.shl (local.get $index) (i32.const 3)))
        (call $decode (i32.load offset=4 (local.get $field)) (local.get $value)))
      (if (global.get $decode_error) (then (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
