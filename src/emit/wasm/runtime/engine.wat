  (if (i32.eq (global.get $halt) (global.get $HALT_SUSPEND)) (then (return (i32.const 2))))
  (if (i32.eq (global.get $halt) (global.get $HALT_TRAP))
    (then
      (local.set $trapped (global.get $halt_text))
      (global.set $halt (i32.const 0))
