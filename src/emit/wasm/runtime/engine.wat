  end
  (local.get $state))
(func $arguments_from_json (param $handler i32) (param $node i32) (result i32) (local $args i32) (local $index i32) (local $param i32) (local $value i32)
  (local.set $args (call $alloc (i32.shl (i32.add (i32.load offset=4 (local.get $handler)) (i32.const 1)) (i32.const 3))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (i32.load offset=4 (local.get $handler))))
      (local.set $param (i32.load (i32.add (i32.load offset=8 (local.get $handler)) (i32.shl (local.get $index) (i32.const 2)))))
      (local.set $value (call $json_get (local.get $node) (i32.load (local.get $param))))
      (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
      (i64.store (i32.add (local.get $args) (i32.shl (local.get $index) (i32.const 3))) (call $decode (i32.load offset=4 (local.get $param)) (local.get $value)))
      (if (global.get $decode_error) (then (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
