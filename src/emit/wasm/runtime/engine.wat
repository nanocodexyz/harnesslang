(func $finish_text (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_text (local.get $buffer) (i32.const $s_f_outcome))
  (call $buf_text (local.get $buffer) (select (i32.const $s_completed) (i32.const $s_failed) (i32.eq (global.get $finish_outcome) (global.get $OUTCOME_COMPLETED))))
  (call $buf_text (local.get $buffer) (i32.const $s_f_result))
  (call $json_write (local.get $buffer) (global.get $finish_result) (i32.const 0))
  (call $buf_text (local.get $buffer) (i32.const $s_f_turn))
  (call $buf_u64 (local.get $buffer) (global.get $turn))
  (call $buf_byte (local.get $buffer) (i32.const 125))
  (call $buf_finish (local.get $buffer)))
(func $finish (param $outcome i32) (param $result i32) (local $text i32)
  (call $stop_cells)
  (global.set $finish_outcome (local.get $outcome))
  (global.set $finish_result (local.get $result))
  (call $append (call $record_status (global.get $turn) (global.get $seq) (local.get $outcome) (local.get $result)))
  (if (global.get $live)
    (then (call $append (call $record_checkpoint (global.get $turn) (i32.load (i32.const $program)) (call $json_encode (call $state_json))))))
  (global.set $finishing (i32.const 1))
  (call $flush)
  (call $assert (i32.eqz (call $vec_count (global.get $buffer))) (i32.const $s_durable_before_ack))
  (call $hook (global.get $POINT_BEFORE_ACKNOWLEDGE) (i32.const 0) (i32.const 0))
  (if (i32.eqz (global.get $acknowledged))
    (then
      (global.set $acknowledged (i32.const 1))
      (if (i32.and (global.get $live) (i32.eqz (global.get $side)))
        (then
          (local.set $text (call $finish_text))
          (call $host_acknowledge (call $text_bytes (local.get $text)) (call $text_len (local.get $text)))))))
  (if (i32.and (global.get $live) (i32.eqz (global.get $side)))
    (then (call $close_inbox (global.get $turn) (global.get $seq) (global.get $log)))))
(func $engine_start (param $live i32) (param $turn i64) (param $log i32) (param $state i32)
  (global.set $live (local.get $live))
  (global.set $turn (local.get $turn))
  (global.set $seq (i64.const 0))
  (global.set $log (local.get $log))
  (global.set $attempts (i64.load offset=16 (local.get $log)))
  (global.set $buffer (call $vec_new (i32.const 4)))
  (global.set $acknowledged (i32.const 0))
  (global.set $state (local.get $state))
  (call $listings_reset)
  (global.set $taken (i32.const 0))
  (global.set $taken_jobs (i32.const 0))
  (global.set $finishing (i32.const 0))
  (global.set $halt (i32.const 0)))
(func $engine_run (param $handler i32) (param $args i32) (result i32) (local $value i64) (local $trapped i32)
  (local.set $value (call $run_handler (i32.load offset=16 (local.get $handler)) (local.get $args)))
