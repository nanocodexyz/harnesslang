  (local.get $args))
(func $arguments_json (param $handler i32) (param $args i32) (result i32) (local $node i32) (local $index i32) (local $param i32)
  (local.set $node (call $json_object (i32.load offset=4 (local.get $handler))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (i32.load offset=4 (local.get $handler))))
      (local.set $param (i32.load (i32.add (i32.load offset=8 (local.get $handler)) (i32.shl (local.get $index) (i32.const 2)))))
      (call $json_object_set (local.get $node) (local.get $index) (i32.load (local.get $param))
        (call $value_to_json (i32.load offset=4 (local.get $param)) (i64.load (i32.add (local.get $args) (i32.shl (local.get $index) (i32.const 3))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
