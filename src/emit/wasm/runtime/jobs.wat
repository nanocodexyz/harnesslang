(global $INTERRUPT_CANCEL i32 (i32.const 1))
(global $INTERRUPT_STEER i32 (i32.const 2))
(global $JOB_BYTES i32 (i32.const 8))
(global $RECOVERED_UNKNOWN i32 (i32.const 0))
(global $RECOVERED_UNDISPATCHED i32 (i32.const 1))
(global $RECOVERED_REPLY i32 (i32.const 2))
(global $RETRIED_RUN i32 (i32.const 0))
(global $RETRIED_SETTLED i32 (i32.const 1))
(global $taken_jobs (mut i32) (i32.const 0))
(global $jobs (mut i32) (i32.const 0))
(global $session_jobs (mut i32) (i32.const 0))
(global $lost (mut i32) (i32.const 0))
(global $job_sent (mut i32) (i32.const 0))
(global $recovered_output (mut i32) (i32.const 0))
(global $retried_value (mut i64) (i64.const 0))
(global $recover_replied (mut i32) (i32.const 0))
(global $recover_undispatched (mut i32) (i32.const 0))
(text $j_interrupted "Tool execution interrupted; outcome unknown. Do not assume it did not run or automatically repeat it.")
(text $j_interrupted_variant "interrupted")
(text $j_jobs "jobs")
(text $j_open "open")
(text $j_recover "recover")
(text $j_reply "reply")
(text $j_not_dispatched "not_dispatched")
(text $j_replied "replied")
(text $j_undispatched "not_dispatched")
(text $j_dot ".")
(text $j_lost "lost:")
(text $j_tool "tool ")
(text $j_may_not " started a job, which it may not: it is not a jobs tool or keeps its bound of jobs running")
(text $j_notice_open "<task-notification>\n<task-id>")
(text $j_notice_middle "</task-id>\n<status>killed</status>\n<summary>Background command ")
(text $j_notice_close " was still running when the harness that started it ended, so its completion was never reported and never will be. It was most likely stopped then; its outcome is unknown.</summary>\n</task-notification>\nRead its output file and check its effects before you rely on it or run it again.")
(text $j_w_replied ",\"replied\":[")
(text $j_w_undispatched ",\"not_dispatched\":[")
(text $j_job_field "\"job\":true,")
(text $j_not_recovered "a recovery answer is not_dispatched, unknown or a reply")
(text $j_not_jobs "the host's jobs answer is not a list of job keys")
(text $j_fold_attest "a recovery attests a call that is not an open external call")
(text $j_jobs_over "a turn records more job notices than its bound")
(text $j_only_jobs " started a job, which only a jobs tool does")
(text $j_hold_until "a hold's input lacks its deadline")
(func $events_jobs_max (result i64) (i64.extend_i32_u (i32.load offset=16 (i32.const $events))))
(func $events_model_interrupts (result i32) (i32.load offset=32 (i32.const $events)))
(func $tool_recoverable (param $tool i32) (result i32) (i32.load offset=28 (local.get $tool)))
(func $tool_has_jobs (param $tool i32) (result i32) (i32.load offset=32 (local.get $tool)))
(func $tool_jobs_max (param $tool i32) (result i32) (i32.load offset=36 (local.get $tool)))
(func $tool_interrupts (param $name i32) (result i32) (local $tool i32)
  (local.set $tool (call $program_tool (local.get $name)))
  (if (i32.eqz (local.get $tool)) (then (return (i32.const 0))))
  (i32.load offset=24 (local.get $tool)))
(func $site_interrupts (param $site i32) (param $call i32) (result i32) (local $kind i32)
  (local.set $kind (call $site_kind (local.get $site)))
  (if (i32.eq (local.get $kind) (global.get $KIND_MODEL)) (then (return (call $events_model_interrupts))))
  (if (i32.or (i32.eq (local.get $kind) (global.get $KIND_TOOL)) (i32.eq (local.get $kind) (global.get $KIND_DISPATCH)))
    (then (return (call $tool_interrupts (call $call_tool (local.get $call))))))
  (i32.const 0))
(func $preempted (param $interrupts i32) (result i32)
  (if (i32.eqz (local.get $interrupts)) (then (return (i32.const 0))))
  (if (i32.and (i32.ne (i32.and (local.get $interrupts) (global.get $INTERRUPT_CANCEL)) (i32.const 0))
               (i32.ne (call $events_counted (global.get $log) (global.get $DELIVERY_CANCEL) (i32.const 0)) (i32.const 0)))
    (then (return (i32.const 1))))
  (i32.and (i32.ne (i32.and (local.get $interrupts) (global.get $INTERRUPT_STEER)) (i32.const 0))
    (i32.gt_u (call $events_counted (global.get $log) (global.get $DELIVERY_STEER) (i32.const 0)) (global.get $taken))))
(func $flushes_to_interrupt (param $interrupts i32) (result i32)
  (i32.and (i32.ne (local.get $interrupts) (i32.const 0)) (i32.ne (call $events_drain) (global.get $DRAIN_AFTER_RUN))))
(func $interrupting_since (param $before i32) (param $interrupts i32) (result i32) (local $events i32) (local $index i32) (local $kind i32)
  (local.set $events (call $log_events (global.get $log)))
  (local.set $index (local.get $before))
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $vec_count (local.get $events))))
      (local.set $kind (call $delivery_kind (call $event_delivery (call $vec_at (local.get $events) (local.get $index)))))
      (if (i32.and (i32.eq (local.get $kind) (global.get $DELIVERY_CANCEL)) (i32.ne (i32.and (local.get $interrupts) (global.get $INTERRUPT_CANCEL)) (i32.const 0)))
        (then (return (i32.const 1))))
      (if (i32.and (i32.eq (local.get $kind) (global.get $DELIVERY_STEER)) (i32.ne (i32.and (local.get $interrupts) (global.get $INTERRUPT_STEER)) (i32.const 0)))
        (then (return (i32.const 1))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $interrupted_by (param $before i32) (param $interrupts i32) (param $preempted i32) (result i32)
  (i32.and (call $interrupting_since (local.get $before) (local.get $interrupts)) (i32.eqz (local.get $preempted))))
(func $events_now (result i32) (call $vec_count (call $log_events (global.get $log))))
(func $interrupted_output (result i32) (call $output_new (global.get $OUTPUT_FAILED) (i32.const $j_interrupted)))
(func $interrupted_response (result i32) (call $json_one (i32.const $j_interrupted_variant) (call $json_array (i32.const 0))))
(func $unknown_site (param $seq i64) (param $call i32) (result i64) (local $unknown i32)
  (local.set $unknown (call $vec_new (i32.const 8)))
  (i64.store (call $vec_push (local.get $unknown)) (local.get $seq))
  (call $append (call $record_recovery (global.get $turn) (call $next_attempt) (local.get $unknown)))
  (call $site_put (global.get $log) (local.get $seq) (global.get $SITE_UNKNOWN) (local.get $call) (i32.const 0))
  (call $flush)
  (call $sum_0 (global.get $VARIANT_UNKNOWN)))
(func $job_key (param $turn i64) (param $seq i64) (result i32) (local $buffer i32)
  (local.set $buffer (call $buf_new))
  (call $buf_u64 (local.get $buffer) (local.get $turn))
  (call $buf_text (local.get $buffer) (i32.const $j_dot))
  (call $buf_u64 (local.get $buffer) (local.get $seq))
  (call $buf_finish (local.get $buffer)))
(func $jobs_find (param $jobs i32) (param $key i32) (result i32) (local $index i32)
  block $absent
    loop $next
      (br_if $absent (i32.ge_u (local.get $index) (call $vec_count (local.get $jobs))))
      (if (call $text_eq (i32.load (call $vec_at (local.get $jobs) (local.get $index))) (local.get $key))
        (then (return (call $vec_at (local.get $jobs) (local.get $index)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $jobs_put (param $jobs i32) (param $key i32) (param $tool i32) (local $entry i32)
  (local.set $entry (call $jobs_find (local.get $jobs) (local.get $key)))
  (if (i32.eqz (local.get $entry))
    (then
      (local.set $entry (call $vec_push (local.get $jobs)))
      (i32.store (local.get $entry) (local.get $key))))
  (i32.store offset=4 (local.get $entry) (local.get $tool)))
(func $jobs_remove (param $jobs i32) (param $key i32) (local $index i32) (local $count i32) (local $found i32)
  (local.set $count (call $vec_count (local.get $jobs)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (if (local.get $found)
        (then (i64.store (call $vec_at (local.get $jobs) (i32.sub (local.get $index) (i32.const 1))) (i64.load (call $vec_at (local.get $jobs) (local.get $index)))))
        (else (local.set $found (call $text_eq (i32.load (call $vec_at (local.get $jobs) (local.get $index))) (local.get $key)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (if (local.get $found) (then (i32.store offset=4 (local.get $jobs) (i32.sub (local.get $count) (i32.const 1))))))
(func $jobs_copy (param $from i32) (result i32) (local $jobs i32) (local $index i32)
  (local.set $jobs (call $vec_new (global.get $JOB_BYTES)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $from))))
      (i64.store (call $vec_push (local.get $jobs)) (i64.load (call $vec_at (local.get $from) (local.get $index))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $jobs))
(func $jobs_reset
  (global.set $session_jobs (call $vec_new (global.get $JOB_BYTES)))
  (global.set $jobs (call $vec_new (global.get $JOB_BYTES)))
  (global.set $lost (call $vec_new (i32.const 4)))
  (global.set $recover_replied (call $vec_new (i32.const 8)))
  (global.set $recover_undispatched (call $vec_new (i32.const 8))))
(func $job_started (param $output i32) (result i32) (local $payload i32)
  (if (i32.ne (call $output_kind (local.get $output)) (global.get $OUTPUT_OK)) (then (return (i32.const 0))))
  (local.set $payload (call $output_payload (local.get $output)))
  (if (i32.ne (call $json_tag (local.get $payload)) (global.get $JSON_OBJECT)) (then (return (i32.const 0))))
  (if (i32.ne (call $json_count (local.get $payload)) (i32.const 1)) (then (return (i32.const 0))))
  (if (i32.eqz (call $text_eq (call $json_key (local.get $payload) (i32.const 0)) (i32.const $e_job))) (then (return (i32.const 0))))
  (i32.eq (call $json_tag (call $json_value (local.get $payload) (i32.const 0))) (global.get $JSON_STRING)))
(func $job_room (param $name i32) (result i32) (local $tool i32) (local $index i32) (local $open i32)
  (local.set $tool (call $program_tool (local.get $name)))
  (if (i32.eqz (local.get $tool)) (then (return (i32.const 0))))
  (if (i32.eqz (call $tool_has_jobs (local.get $tool))) (then (return (i32.const 0))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (global.get $jobs))))
      (if (call $text_eq (i32.load offset=4 (call $vec_at (global.get $jobs) (local.get $index))) (local.get $name))
        (then (local.set $open (i32.add (local.get $open) (i32.const 1)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.lt_u (local.get $open) (call $tool_jobs_max (local.get $tool))))
(func $job_output (param $name i32) (param $seq i64) (param $room i32) (param $output i32) (result i32)
  (if (i32.eqz (call $job_started (local.get $output))) (then (return (local.get $output))))
  (if (i32.eqz (local.get $room))
    (then (return (call $output_new (global.get $OUTPUT_FAILED) (call $wrapped (i32.const $j_tool) (local.get $name) (i32.const $j_may_not))))))
  (call $jobs_put (global.get $jobs) (call $job_key (global.get $turn) (local.get $seq)) (local.get $name))
  (local.get $output))
(func $job_checked (param $name i32) (param $seq i64) (param $room i32) (param $returns i32) (param $output i32) (result i32)
  (if (call $job_started (local.get $output)) (then (return (call $job_output (local.get $name) (local.get $seq) (local.get $room) (local.get $output)))))
  (call $checked_more (local.get $name) (local.get $returns) (local.get $output)))
(func $job_recorded (param $key i32) (result i32) (local $prefix i32) (local $seq i64) (local $site i32)
  (local.set $prefix (call $job_key (global.get $turn) (i64.const 0)))
  (local.set $prefix (call $text_from (call $text_bytes (local.get $prefix)) (i32.sub (call $text_len (local.get $prefix)) (i32.const 1))))
  (if (i32.eqz (call $text_starts (local.get $key) (local.get $prefix))) (then (return (i32.const 1))))
  (global.set $record_failed (i32.const 0))
  (local.set $seq (call $parse_u64_text (call $text_from (i32.add (call $text_bytes (local.get $key)) (call $text_len (local.get $prefix)))
    (i32.sub (call $text_len (local.get $key)) (call $text_len (local.get $prefix))))))
  (if (global.get $record_failed) (then (global.set $record_failed (i32.const 0)) (return (i32.const 1))))
  (local.set $site (call $log_site (global.get $log) (local.get $seq)))
  (if (i32.eqz (local.get $site)) (then (return (i32.const 0))))
  (i32.eq (i32.load offset=8 (local.get $site)) (global.get $SITE_DONE)))
(func $admit_job (param $delivery i32) (result i32) (local $key i32)
  (if (i32.eqz (call $events_jobs)) (then (return (global.get $ANSWER_UNDECLARED))))
  (local.set $key (i32.load offset=12 (local.get $delivery)))
  (if (i32.eqz (call $jobs_find (global.get $jobs) (local.get $key))) (then (return (global.get $ANSWER_DUPLICATE))))
  (if (i32.eqz (call $job_recorded (local.get $key))) (then (return (global.get $ANSWER_FULL))))
  (if (i64.ge_u (i64.extend_i32_u (call $events_counted (global.get $log) (global.get $DELIVERY_JOB) (i32.const 0))) (call $events_jobs_max))
    (then (return (global.get $ANSWER_FULL))))
  (global.get $ANSWER_RECORDED))
(func $job_admitted (param $delivery i32)
  (if (i32.ne (call $delivery_kind (local.get $delivery)) (global.get $DELIVERY_JOB)) (then (return)))
  (if (i32.load offset=16 (local.get $delivery)) (then (call $jobs_remove (global.get $jobs) (i32.load offset=12 (local.get $delivery))))))
(func $fold_job_event (param $delivery i32) (result i32) (local $key i32)
  (local.set $key (i32.load offset=12 (local.get $delivery)))
  (if (i32.eqz (call $jobs_find (global.get $session_jobs) (local.get $key))) (then (return (call $fold_fail (i32.const $e_fold_job)))))
  (if (i32.load offset=16 (local.get $delivery)) (then (call $jobs_remove (global.get $session_jobs) (local.get $key))))
  (i32.const 1))
(func $fold_job_result (param $turn i64) (param $seq i64) (param $site i32)
  (if (call $job_started (i32.load offset=16 (local.get $site)))
    (then (call $jobs_put (global.get $session_jobs) (call $job_key (local.get $turn) (local.get $seq)) (call $call_tool (i32.load offset=12 (local.get $site)))))))
(func $check_jobs (param $log i32) (result i32)
  (if (i32.eqz (call $events_jobs)) (then (return (i32.const 1))))
  (if (i64.gt_u (i64.extend_i32_u (call $events_counted (local.get $log) (global.get $DELIVERY_JOB) (i32.const 0))) (call $events_jobs_max))
    (then (call $corrupt (i32.const $j_jobs_over)) (return (i32.const 0))))
  (i32.const 1))
(func $lost_delivery (param $key i32) (result i32) (local $delivery i32)
  (local.set $delivery (call $alloc (global.get $DELIVERY_BYTES)))
  (i32.store (local.get $delivery) (global.get $DELIVERY_JOB))
  (i32.store offset=4 (local.get $delivery) (call $text_concat (i32.const $j_lost) (local.get $key)))
  (i32.store offset=8 (local.get $delivery)
    (call $text_concat (call $wrapped (i32.const $j_notice_open) (local.get $key) (i32.const $j_notice_middle)) (call $text_concat (local.get $key) (i32.const $j_notice_close))))
  (i32.store offset=12 (local.get $delivery) (local.get $key))
  (i32.store offset=16 (local.get $delivery) (i32.const 1))
  (local.get $delivery))
(func $sorted_keys (param $jobs i32) (result i32) (local $keys i32) (local $count i32) (local $index i32) (local $at i32) (local $key i32)
  (local.set $count (call $vec_count (local.get $jobs)))
  (local.set $keys (call $json_array (local.get $count)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $key (i32.load (call $vec_at (local.get $jobs) (local.get $index))))
      (local.set $at (local.get $index))
      block $placed
        loop $shift
          (br_if $placed (i32.eqz (local.get $at)))
          (br_if $placed (i32.le_s (call $text_cmp (call $json_text (call $json_item (local.get $keys) (i32.sub (local.get $at) (i32.const 1)))) (local.get $key)) (i32.const 0)))
          (call $json_array_set (local.get $keys) (local.get $at) (call $json_item (local.get $keys) (i32.sub (local.get $at) (i32.const 1))))
          (local.set $at (i32.sub (local.get $at) (i32.const 1)))
          br $shift
        end
      end
      (call $json_array_set (local.get $keys) (local.get $at) (call $json_string (local.get $key)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $keys))
(func $lost_jobs (param $turn i64) (result i32) (local $lost i32) (local $request i32) (local $answer i32) (local $index i32) (local $key i32)
  (local.set $lost (call $vec_new (i32.const 4)))
  (if (i32.or (i32.eqz (call $events_jobs)) (i32.eqz (call $vec_count (global.get $session_jobs)))) (then (return (local.get $lost))))
  (local.set $request (call $request (i32.const $j_jobs) (i32.const 2)))
  (call $json_object_set (local.get $request) (i32.const 0) (i32.const $j_open) (call $sorted_keys (global.get $session_jobs)))
  (call $json_object_set (local.get $request) (i32.const 1) (i32.const $s_turn) (call $json_number (local.get $turn)))
  (call $json_object_sort (local.get $request))
  (local.set $answer (call $json_get (call $world (local.get $request)) (i32.const $e_answer)))
  (call $assert (i32.ne (local.get $answer) (i32.const 0)) (i32.const $j_not_jobs))
  (call $assert (i32.eq (call $json_tag (local.get $answer)) (global.get $JSON_ARRAY)) (i32.const $j_not_jobs))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $json_count (local.get $answer))))
      (call $assert (i32.eq (call $json_tag (call $json_item (local.get $answer) (local.get $index))) (global.get $JSON_STRING)) (i32.const $j_not_jobs))
      (local.set $key (call $json_text (call $json_item (local.get $answer) (local.get $index))))
      (if (call $jobs_find (global.get $session_jobs) (local.get $key))
        (then (i32.store (call $vec_push (local.get $lost)) (call $lost_delivery (local.get $key)))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (local.get $lost))
(func $drain_lost (param $position i64) (result i32) (local $kept i32) (local $index i32) (local $answer i32) (local $recorded i32) (local $delivery i32)
  (local.set $kept (call $vec_new (i32.const 4)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (global.get $lost))))
      (local.set $delivery (i32.load (call $vec_at (global.get $lost) (local.get $index))))
      (local.set $answer (call $admit (local.get $position) (local.get $delivery)))
      (if (i32.eq (local.get $answer) (global.get $ANSWER_RECORDED)) (then (local.set $recorded (i32.const 1))))
      (if (i32.eq (local.get $answer) (global.get $ANSWER_FULL)) (then (i32.store (call $vec_push (local.get $kept)) (local.get $delivery))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (global.set $lost (local.get $kept))
  (local.get $recorded))
(func $take_jobs (result i64) (local $events i32) (local $index i32) (local $visible i32) (local $fresh i32) (local $buffer i32) (local $event i32) (local $seen i32)
  (local.set $visible (call $events_counted (global.get $log) (global.get $DELIVERY_JOB) (i32.const 1)))
  (call $assert (i32.le_u (global.get $taken_jobs) (local.get $visible)) (i32.const $e_seen_grow))
  (local.set $fresh (i32.sub (local.get $visible) (global.get $taken_jobs)))
  (local.set $buffer (call $list_buffer_new (select (local.get $fresh) (global.get $LIST_SLOTS_FIRST) (i32.gt_u (local.get $fresh) (global.get $LIST_SLOTS_FIRST)))))
  (local.set $events (call $log_events (global.get $log)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (call $vec_count (local.get $events))))
      (local.set $event (call $vec_at (local.get $events) (local.get $index)))
      (if (i32.and (i32.eq (call $delivery_kind (call $event_delivery (local.get $event))) (global.get $DELIVERY_JOB))
                   (i64.le_u (call $event_at (local.get $event)) (global.get $seq)))
        (then
          (if (i32.ge_u (local.get $seen) (global.get $taken_jobs))
            (then
