(global $MODEL_TRAP i32 (i32.const 0))
(global $MODEL_KNOWN i32 (i32.const 1))
(global $MODEL_ATTEMPT i32 (i32.const 2))
(global $ATTEMPT_REJECTED i32 (i32.const 3))
(global $ATTEMPT_USAGE i32 (i32.const 2))
(global $USAGE_FIELDS i32 (i32.const 4))
(text $s_mode "mode")
(text $s_settings "settings")
(text $s_m_mode ",\"mode\":")
(text $s_m_settings ",\"settings\":")
(text $s_w_mode "\",\"mode\":")
(text $s_w_response_after ",\"response\":")
(text $s_usage_input "input")
(text $s_usage_output "output")
(text $s_usage_cache_read "cache_read")
(text $s_usage_cache_write "cache_write")
(text $s_usage_of " usage of ")
(text $s_usage_exceeds " tokens exceeds the window of ")
(text $s_usage_tokens " tokens")
(words $usage_names $s_usage_input $s_usage_output $s_usage_cache_read $s_usage_cache_write)
(func $model_outcome (result i32) (i32.load (i32.const $model)))
(func $model_tokens (result i64) (i64.extend_i32_u (i32.load offset=4 (i32.const $model))))
(func $site_mode (param $site i32) (result i32) (i32.load offset=24 (local.get $site)))
(func $model_settings (param $args i32) (result i32) (local $count i32) (local $node i32) (local $index i32) (local $setting i32)
  (local.set $count (i32.load offset=8 (i32.const $model)))
  (if (i32.eqz (local.get $count)) (then (return (i32.const 0))))
  (local.set $node (call $json_object (local.get $count)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $setting (i32.load (i32.add (i32.load offset=12 (i32.const $model)) (i32.shl (local.get $index) (i32.const 2)))))
      (call $json_object_set (local.get $node) (local.get $index) (i32.load (local.get $setting))
        (call $value_to_json (i32.load offset=4 (local.get $setting)) (i64.load (i32.add (local.get $args) (i32.shl (i32.add (local.get $index) (i32.const 1)) (i32.const 3))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (call $json_object_sort (local.get $node))
  (local.get $node))
(func $sent_new (param $mode i32) (param $settings i32) (result i32) (local $sent i32)
  (local.set $sent (call $alloc (i32.const 8)))
  (i32.store (local.get $sent) (local.get $mode))
  (i32.store offset=4 (local.get $sent) (local.get $settings))
  (local.get $sent))
(func $optional_text_eq (param $left i32) (param $right i32) (result i32)
  (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
    (then (return (i32.eq (local.get $left) (local.get $right)))))
  (call $text_eq (local.get $left) (local.get $right)))
(func $optional_json_equal (param $left i32) (param $right i32) (result i32)
  (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
    (then (return (i32.eq (local.get $left) (local.get $right)))))
  (call $json_equal (local.get $left) (local.get $right)))
(func $sent_same (param $sent i32) (param $site i32) (param $args i32) (result i32)
  (if (i32.and
        (call $optional_text_eq (i32.load (local.get $sent)) (call $site_mode (local.get $site)))
        (call $optional_json_equal (i32.load offset=4 (local.get $sent)) (call $model_settings (local.get $args))))
    (then (return (i32.const 1))))
  (call $corrupt (i32.const $s_diverged))
  (i32.const 0))
(func $buf_model_request (param $buffer i32) (param $site i32) (param $seq i64) (param $context i32) (param $settings i32)
  (call $buf_text (local.get $buffer) (i32.const $s_m_calls))
  (call $buf_u64 (local.get $buffer) (i64.extend_i32_u (i32.load offset=24 (i32.const $program))))
  (call $buf_text (local.get $buffer) (i32.const $s_m_context))
  (call $json_write (local.get $buffer) (local.get $context) (i32.const 0))
  (if (call $site_mode (local.get $site))
    (then
      (call $buf_text (local.get $buffer) (i32.const $s_m_mode))
      (call $json_write_string (local.get $buffer) (call $site_mode (local.get $site)))))
  (call $buf_text (local.get $buffer) (i32.const $s_r_seq))
  (call $buf_u64 (local.get $buffer) (local.get $seq))
  (if (i32.ne (local.get $settings) (i32.const 0))
    (then
      (call $buf_text (local.get $buffer) (i32.const $s_m_settings))
      (call $json_write (local.get $buffer) (local.get $settings) (i32.const 0))))
  (call $buf_text (local.get $buffer) (i32.const $s_r_turn))
  (call $buf_u64 (local.get $buffer) (global.get $turn))
  (call $buf_byte (local.get $buffer) (i32.const 125)))
(func $usage_over (param $response i32) (result i32) (local $fields i32) (local $index i32) (local $field i32) (local $used i64) (local $buffer i32)
  (if (i32.ne (call $json_tag (local.get $response)) (global.get $JSON_OBJECT)) (then (return (i32.const 0))))
  (local.set $fields (call $json_get (local.get $response) (i32.const $s_ok)))
  (if (i32.eqz (local.get $fields)) (then (return (i32.const 0))))
  (if (i32.ne (call $json_tag (local.get $fields)) (global.get $JSON_ARRAY)) (then (return (i32.const 0))))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $index) (global.get $USAGE_FIELDS)))
      (if (i32.lt_u (i32.add (global.get $ATTEMPT_USAGE) (local.get $index)) (call $json_count (local.get $fields)))
        (then
          (local.set $field (call $json_item (local.get $fields) (i32.add (global.get $ATTEMPT_USAGE) (local.get $index))))
          (if (i32.eq (call $json_tag (local.get $field)) (global.get $JSON_NUMBER))
            (then
              (local.set $used (call $json_number_value (local.get $field)))
              (if (i64.gt_u (local.get $used) (call $model_tokens))
                (then
                  (local.set $buffer (call $buf_new))
                  (call $buf_text (local.get $buffer) (i32.const $s_model_reply))
                  (call $buf_text (local.get $buffer) (i32.load (i32.add (i32.const $usage_names) (i32.shl (local.get $index) (i32.const 2)))))
                  (call $buf_text (local.get $buffer) (i32.const $s_usage_of))
                  (call $buf_u64 (local.get $buffer) (local.get $used))
                  (call $buf_text (local.get $buffer) (i32.const $s_usage_exceeds))
                  (call $buf_u64 (local.get $buffer) (call $model_tokens))
                  (call $buf_text (local.get $buffer) (i32.const $s_usage_tokens))
                  (return (call $buf_finish (local.get $buffer)))))))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      br $next
    end
  end
  (i32.const 0))
(func $attempt_value (param $site i32) (param $response i32) (result i64) (local $value i64) (local $error i32)
  (local.set $value (call $decode (call $site_result (local.get $site)) (local.get $response)))
  (if (global.get $decode_error)
    (then
      (local.set $error (global.get $decode_error))
      (global.set $decode_error (i32.const 0))
      (return (call $sum_1 (global.get $ATTEMPT_REJECTED) (call $text_value (call $text_concat (i32.const $s_model_reply) (local.get $error)))))))
  (local.set $error (call $usage_over (local.get $response)))
  (if (local.get $error) (then (return (call $sum_1 (global.get $ATTEMPT_REJECTED) (call $text_value (local.get $error))))))
  (local.get $value))
(func $known_value (param $site i32) (param $response i32) (result i64) (local $value i64) (local $error i32) (local $failure i32)
  (if (call $json_tagged (local.get $response))
    (then
      (if (call $text_eq (call $json_key (local.get $response) (i32.const 0)) (i32.const $s_failed))
        (then
          (local.set $failure (call $json_value (local.get $response) (i32.const 0)))
          (if (i32.eq (call $json_tag (local.get $failure)) (global.get $JSON_STRING))
            (then (return (call $sum_1 (global.get $VARIANT_FAILED) (call $text_value (call $json_text (local.get $failure)))))))))))
  (local.set $value (call $decode (i32.load offset=4 (call $site_result (local.get $site))) (local.get $response)))
  (if (global.get $decode_error)
    (then
      (local.set $error (global.get $decode_error))
      (global.set $decode_error (i32.const 0))
      (return (call $sum_1 (global.get $VARIANT_FAILED) (call $text_value (call $text_concat (i32.const $s_model_reply) (local.get $error)))))))
  (call $sum_1 (global.get $VARIANT_OK) (local.get $value)))
