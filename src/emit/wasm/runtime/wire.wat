(func $model_wire (result i32) (i32.load offset=16 (i32.const $model)))
(func $w_fail (param $error i32) (result i32)
  (global.set $wire_error (local.get $error))
  (i32.const 0))
(func $w_is (param $node i32) (param $tag i32) (result i32)
  (if (i32.eqz (local.get $node)) (then (return (i32.const 0))))
  (i32.eq (call $json_tag (local.get $node)) (local.get $tag)))
(func $w_get (param $node i32) (param $key i32) (result i32)
  (if (i32.eqz (call $w_is (local.get $node) (global.get $JSON_OBJECT))) (then (return (i32.const 0))))
  (call $json_get (local.get $node) (local.get $key)))
(func $w_as_text (param $node i32) (result i32)
  (if (i32.eqz (call $w_is (local.get $node) (global.get $JSON_STRING))) (then (return (i32.const 0))))
  (call $json_text (local.get $node)))
(func $w_text (param $node i32) (param $key i32) (result i32)
  (call $w_as_text (call $w_get (local.get $node) (local.get $key))))
(func $w_or (param $value i32) (param $default i32) (result i32)
  (select (local.get $value) (local.get $default) (local.get $value)))
(func $w_text_or_empty (param $node i32) (param $key i32) (result i32)
  (call $w_or (call $w_text (local.get $node) (local.get $key)) (i32.const $s_empty)))
(func $w_count (param $node i32) (result i32)
  (if (i32.eqz (call $w_is (local.get $node) (global.get $JSON_ARRAY))) (then (return (i32.const 0))))
  (call $json_count (local.get $node)))
(func $w_at (param $node i32) (param $index i32) (result i32)
  (if (i32.ge_u (local.get $index) (call $w_count (local.get $node))) (then (return (i32.const 0))))
  (call $json_item (local.get $node) (local.get $index)))
(func $w_eq (param $text i32) (param $other i32) (result i32)
  (if (i32.eqz (local.get $text)) (then (return (i32.const 0))))
  (call $text_eq (local.get $text) (local.get $other)))
(func $w_string (param $text i32) (result i32) (call $json_string (local.get $text)))
(func $w_cat3 (param $first i32) (param $second i32) (param $third i32) (result i32)
  (call $text_concat (call $text_concat (local.get $first) (local.get $second)) (local.get $third)))
(func $w_cat4 (param $first i32) (param $second i32) (param $third i32) (param $fourth i32) (result i32)
  (call $text_concat (call $w_cat3 (local.get $first) (local.get $second) (local.get $third)) (local.get $fourth)))
(func $w_empty (param $text i32) (result i32) (i32.eqz (call $text_len (local.get $text))))
(func $w_saturating_add (param $left i64) (param $right i64) (result i64) (local $sum i64)
  (local.set $sum (i64.add (local.get $left) (local.get $right)))
  (if (i64.lt_u (local.get $sum) (local.get $left)) (then (return (global.get $U64_MAX))))
  (local.get $sum))
(func $w_digit (param $byte i32) (result i32)
  (i32.lt_u (i32.sub (local.get $byte) (global.get $ASCII_ZERO)) (i32.const 10)))
(func $w_digits (param $text i32) (param $from i32) (param $to i32) (result i64) (local $value i64)
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $from) (local.get $to)))
      (local.set $value (call $w_saturating_add (call $u64_saturating_multiply (local.get $value) (global.get $DECIMAL_BASE))
        (i64.extend_i32_u (i32.sub (call $text_byte (local.get $text) (local.get $from)) (global.get $ASCII_ZERO)))))
      (local.set $from (i32.add (local.get $from) (i32.const 1)))
      br $next
    end
  end
  (local.get $value))
(func $w_all_digits (param $text i32) (result i32) (local $at i32)
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $at) (call $text_len (local.get $text))))
      (if (i32.eqz (call $w_digit (call $text_byte (local.get $text) (local.get $at)))) (then (return (i32.const 0))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (i32.const 1))
(func $w_whole (param $text i32) (result i64)
  (global.set $w_u64_ok (i32.const 0))
  (if (i32.eqz (local.get $text)) (then (return (i64.const 0))))
  (if (call $w_empty (local.get $text)) (then (return (i64.const 0))))
  (if (i32.eqz (call $w_all_digits (local.get $text))) (then (return (i64.const 0))))
  (global.set $w_u64_ok (i32.const 1))
  (call $w_digits (local.get $text) (i32.const 0) (call $text_len (local.get $text))))
(func $w_u64 (param $node i32) (result i64) (local $text i32) (local $at i32) (local $value i64) (local $digit i32)
  (global.set $w_u64_ok (i32.const 0))
  (if (call $w_is (local.get $node) (global.get $JSON_NUMBER))
    (then
      (global.set $w_u64_ok (i32.const 1))
      (return (call $json_number_value (local.get $node)))))
  (if (i32.eqz (call $w_is (local.get $node) (global.get $WIRE_RAW_NUMBER))) (then (return (i64.const 0))))
  (local.set $text (call $json_text (local.get $node)))
  block $done
    loop $next
      (br_if $done (i32.ge_u (local.get $at) (call $text_len (local.get $text))))
      (local.set $digit (i32.sub (call $text_byte (local.get $text) (local.get $at)) (global.get $ASCII_ZERO)))
      (if (i32.gt_u (local.get $digit) (i32.const 9)) (then (return (i64.const 0))))
      (if (i64.gt_u (local.get $value) (global.get $U64_TENTH_MAX)) (then (return (i64.const 0))))
      (if (i32.and (i64.eq (local.get $value) (global.get $U64_TENTH_MAX)) (i32.gt_u (local.get $digit) (global.get $U64_LAST_DIGIT_MAX)))
        (then (return (i64.const 0))))
      (local.set $value (i64.add (i64.mul (local.get $value) (global.get $DECIMAL_BASE)) (i64.extend_i32_u (local.get $digit))))
      (local.set $at (i32.add (local.get $at) (i32.const 1)))
      br $next
    end
  end
  (global.set $w_u64_ok (i32.const 1))
  (local.get $value))
(func $w_space_width (param $text i32) (param $at i32) (result i32) (local $length i32) (local $byte i32) (local $second i32) (local $third i32)
  (local.set $length (call $text_len (local.get $text)))
  (if (i32.ge_u (local.get $at) (local.get $length)) (then (return (i32.const 0))))
  (local.set $byte (call $text_byte (local.get $text) (local.get $at)))
  (if (i32.lt_u (local.get $byte) (i32.const 0x80))
    (then (return (i32.or (i32.eq (local.get $byte) (i32.const 32)) (i32.lt_u (i32.sub (local.get $byte) (i32.const 9)) (i32.const 5))))))
  (if (i32.ge_u (i32.add (local.get $at) (i32.const 1)) (local.get $length)) (then (return (i32.const 0))))
  (local.set $second (call $text_byte (local.get $text) (i32.add (local.get $at) (i32.const 1))))
  (if (i32.eq (local.get $byte) (i32.const 0xc2))
    (then (return (select (i32.const 2) (i32.const 0) (i32.or (i32.eq (local.get $second) (i32.const 0x85)) (i32.eq (local.get $second) (i32.const 0xa0)))))))
  (if (i32.ge_u (i32.add (local.get $at) (i32.const 2)) (local.get $length)) (then (return (i32.const 0))))
  (local.set $third (call $text_byte (local.get $text) (i32.add (local.get $at) (i32.const 2))))
  (if (i32.eq (local.get $byte) (i32.const 0xe1))
    (then (return (select (i32.const 3) (i32.const 0) (i32.and (i32.eq (local.get $second) (i32.const 0x9a)) (i32.eq (local.get $third) (i32.const 0x80)))))))
  (if (i32.eq (local.get $byte) (i32.const 0xe3))
    (then (return (select (i32.const 3) (i32.const 0) (i32.and (i32.eq (local.get $second) (i32.const 0x80)) (i32.eq (local.get $third) (i32.const 0x80)))))))
  (if (i32.ne (local.get $byte) (i32.const 0xe2)) (then (return (i32.const 0))))
  (if (i32.eq (local.get $second) (i32.const 0x80))
    (then
      (return (select (i32.const 3) (i32.const 0)
        (i32.or (i32.le_u (local.get $third) (i32.const 0x8a))
          (i32.or (i32.or (i32.eq (local.get $third) (i32.const 0xa8)) (i32.eq (local.get $third) (i32.const 0xa9))) (i32.eq (local.get $third) (i32.const 0xaf))))))))
  (select (i32.const 3) (i32.const 0) (i32.and (i32.eq (local.get $second) (i32.const 0x81)) (i32.eq (local.get $third) (i32.const 0x9f)))))
(func $w_skip_space (param $text i32) (param $at i32) (result i32) (local $width i32)
  loop $next
    (local.set $width (call $w_space_width (local.get $text) (local.get $at)))
    (if (local.get $width)
      (then
        (local.set $at (i32.add (local.get $at) (local.get $width)))
        (br $next)))
  end
  (local.get $at))
(func $w_trim (param $text i32) (result i32) (local $from i32) (local $to i32) (local $width i32)
  (local.set $from (call $w_skip_space (local.get $text) (i32.const 0)))
  (local.set $to (call $text_len (local.get $text)))
  block $done
    loop $next
      (br_if $done (i32.le_u (local.get $to) (local.get $from)))
      (local.set $width (i32.const 0))
      (if (i32.eq (call $w_space_width (local.get $text) (i32.sub (local.get $to) (i32.const 1))) (i32.const 1))
        (then (local.set $width (i32.const 1))))
      (if (i32.and (i32.eqz (local.get $width)) (i32.ge_u (i32.sub (local.get $to) (local.get $from)) (i32.const 2)))
        (then
