(global $WIRE_ANTHROPIC i32 (i32.const 1))
(global $WIRE_OPENAI i32 (i32.const 2))
(global $wire_error (mut i32) (i32.const 0))
(text $s_wire_unbuilt "the wire codec is not built")
(text $s_wire_transient "transient")
(func $model_wire (result i32) (i32.load offset=16 (i32.const $model)))
(func $wire_transient (param $error i32) (result i32) (local $fields i32)
  (local.set $fields (call $json_array (i32.const 2)))
  (call $json_array_set (local.get $fields) (i32.const 0) (call $json_string (local.get $error)))
  (call $json_array_set (local.get $fields) (i32.const 1) (call $json_number (i64.const 0)))
  (call $json_one (i32.const $s_wire_transient) (local.get $fields)))
(func $wire_request (param $wire i32) (param $context i32) (param $settings i32) (param $mode i32) (param $seq i64) (result i32)
  (global.set $wire_error (i32.const $s_wire_unbuilt))
  (i32.const 0))
(func $wire_decode (param $wire i32) (param $answer i32) (param $interruptible i32) (result i32)
  (call $wire_transient (i32.const $s_wire_unbuilt)))
